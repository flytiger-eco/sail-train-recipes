+"""Multiple-choice scoring, ported from GoLongRL `multi_choices.py` (1/0).
+
+The model must answer as "The correct answer is (X)"; markdown `*` is
+stripped before the regex.
+
+Deviation from the verl-side patch (02_golongrl_dataset.patch): the option
+regex is [A-H] instead of [A-D]. Measured on band32k, 15/42 selection labels
+are E or F, which the upstream [A-D] class silently scores 0 even for
+correct answers (same failure family as "reward fallback hides missing
+dependency -> silent zero").
+"""
+
+import re
+
+
+def extract_answer(response: str):
+    response = response.replace("*", "")
+    match = re.search(r"The correct answer is \(([A-H])\)", response)
+    if match:
+        return match.group(1)
+    match = re.search(r"The correct answer is ([A-H])", response)
+    return match.group(1) if match else None
+
+
+def compute_score(solution_str: str, ground_truth) -> float:
+    label = ground_truth
+    if isinstance(label, dict):
+        label = label.get("golden_label")
+    if label is None:
+        return 0.0
+
+    extract = extract_answer(solution_str)
+    if extract is None:
+        return 0.0
+
+    label_extract = extract_answer(str(label))
+    return 1.0 if (extract == label or extract == label_extract) else 0.0
