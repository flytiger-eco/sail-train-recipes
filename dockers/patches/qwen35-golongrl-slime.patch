+def get_per_seq_padded_lengths(total_lengths: list[int], cp_size: int) -> list[int]:
+    """Per-sequence lengths padded to ``2*cp_size`` multiples (a2a-CP THD).
+
+    The contiguous (allgather-CP + chunkwise) pipeline pads every sequence to a
+    ``2*cp_size`` multiple before concatenation so the zigzag ``ThdCpRoute``
+    layout conversion (and TE's native zigzag CP kernels) see exact
+    per-sequence chunk boundaries. Consumers locating a sample's tokens/logits
+    inside the global padded stream must accumulate offsets with these padded
+    lengths instead of the raw ``total_lengths``.
+    """
+    if cp_size <= 1:
+        return list(total_lengths)
+    chunk_div = 2 * cp_size
+    return [(length + chunk_div - 1) // chunk_div * chunk_div for length in total_lengths]
+
+
+def get_a2a_cp_seq_lengths(args, total_lengths: list[int]) -> list[int]:
+    """Effective per-seq stream lengths for allgather-CP offset accumulation.
+
+    a2a-CP (chunkwise contiguous data plane) pads each sequence to a 2*cp_size
+    multiple; the stock DSA allgather-CP packing accumulates with raw lengths.
+    """
+    cp_size = mpu.get_context_parallel_world_size()
+    if (
+        getattr(args, "allgather_cp", False)
+        and cp_size > 1
+        and getattr(args, "linear_cp_mode", "chunkwise") == "chunkwise"
+    ):
+        return get_per_seq_padded_lengths(total_lengths, cp_size)
+    return list(total_lengths)
+
