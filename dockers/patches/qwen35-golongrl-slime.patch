+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""GoLongRL rule-based reward for slime (`--custom-rm-path slime_plugins.rm.golongrl.golongrl_rm`).
+
+Ported from the verl-side GoLongRL adaptation (02_golongrl_dataset.patch),
+which in turn ports GoLongRL `Train/verl/verl/utils/reward_score/__init__.py`
+(https://github.com/xiaoxuanNLP/GoLongRL). Rewired to slime's Sample calling
+convention instead of verl's `compute_score(data_source, solution_str,
+ground_truth, extra_info)`:
+
+  - data_source / reward_mode / doc_ids / summary -> ``sample.metadata``
+  - golden_label                                  -> ``sample.label``
+  - solution_str                                  -> ``sample.response``
+
+Semantics (unchanged from the verl patch):
+  1. A global think-tag gate: a missing ``</think``> or duplicated think tags
+     scores 0 (checked before any metric). Disable via
+     GOLONGRL_STRICT_THINK_GATE=0.
+  2. Routing by data_source / reward_mode to four families:
+       longbench_pro            -> 25 sub-tasks / 6 metrics, continuous [0,1]
+       math_longcot_math_verify -> math_verify semantic equality, 1/0
+       selection                -> "The correct answer is (X)", 1/0
+       EM                       -> exact string match, 1/0
+  3. Pure 1/0 scoring (ScoringConfig): wrong and malformed answers score
+     the same, no negative penalty.
+"""
+
+import os
+
+THINK_OPEN = "<think>"
+THINK_CLOSE = "</think>"
+
+# Reward-mode constants: grouping keys for TMN-GRPO mode-scale normalization.
+MODE_LONGBENCH = "longbench_pro"
+MODE_MATH = "math_longcot_math_verify"
+MODE_SELECTION = "selection"
+MODE_EM = "EM"
+
+GOLONGRL_DATA_SOURCES = (MODE_LONGBENCH, MODE_MATH, MODE_SELECTION, MODE_EM)
+
+# Chat-template special tokens that may leak into the decoded response string.
+# slime's rollout includes the EOS token (e.g. <|im_end|>) in sample.response,
+# whereas verl strips it upstream.  Without cleaning, every exact-match / first-line
+# metric (EM, Accuracy, SubEM …) sees a trailing "<|im_end|>" and scores 0.
+_SPECIAL_TOKENS = ("<|im_end|>", "<|im_start|>", "<|endoftext|>", "")
+
+
+def _strip_special_tokens(text: str) -> str:
+    """Remove chat-template special tokens from decoded response text."""
+    for tok in _SPECIAL_TOKENS:
+        text = text.replace(tok, "")
+    return text
+
+
+def _think_gate_enabled() -> bool:
+    return os.environ.get("GOLONGRL_STRICT_THINK_GATE", "1") != "0"
+
+
+def _fail_think_gate(solution_str: str) -> bool:
+    if THINK_CLOSE not in solution_str:
+        return True
+    if solution_str.count(THINK_OPEN) > 1 or solution_str.count(THINK_CLOSE) > 1:
+        return True
+    return False
+
+
+def _after_think(solution_str: str) -> str:
+    return solution_str.split(THINK_CLOSE)[-1]
+
+
+def _golden_label(label):
+    if isinstance(label, dict):
+        return label.get("golden_label")
+    return label
+
+
+def _score_one(response: str, label, metadata: dict) -> float:
+    """GoLongRL scoring for one sample; response/label/metadata come from the slime Sample."""
+    response = _strip_special_tokens(response)
+    if _think_gate_enabled() and _fail_think_gate(response):
+        return 0.0
+
+    data_source = str(metadata.get("data_source") or "")
+    mode = str(metadata.get("reward_mode") or data_source)
+
+    if data_source == MODE_LONGBENCH or mode in _longbench_task_table():
+        from . import long_bench_pro
+
+        doc_ids = metadata.get("doc_ids") or []
+        language = metadata.get("summary") or "English"
+        return float(long_bench_pro.compute_score(response, doc_ids, mode, language))
+
+    if "math_longcot_math_verify" in data_source or "math_verify" in mode:
+        from . import math_dapo
+
+        return float(math_dapo.compute_score(response, _golden_label(label), is_use_math_verify=True))
+
+    if MODE_SELECTION in data_source:
+        from . import multi_choices
+
+        return float(multi_choices.compute_score(_after_think(response), _golden_label(label)))
+
+    if data_source.upper() == MODE_EM:
+        from . import em_judge
+
+        return float(em_judge.compute_score(_after_think(response), _golden_label(label)))
+
+    raise NotImplementedError(f"GoLongRL reward not implemented for data_source={data_source!r}, reward_mode={mode!r}")
+
+
+async def golongrl_rm(args, sample_or_samples, **kwargs):
+    """slime custom RM entry.
+
+    Matches both slime call sites:
+      - per-sample:  ``rm_function(args, sample)``  -> float
+      - batched:     ``rm_function(args, samples)`` -> list[float]
+    """
+    if isinstance(sample_or_samples, list):
+        rewards = []
+        for sample in sample_or_samples:
+            metadata = sample.metadata if isinstance(sample.metadata, dict) else {}
+            rewards.append(_score_one(sample.response, sample.label, metadata))
+        return rewards
+
+    sample = sample_or_samples
+    metadata = sample.metadata if isinstance(sample.metadata, dict) else {}
+    return _score_one(sample.response, sample.label, metadata)
+
+
+def _longbench_task_table():
+    from . import long_bench_pro
+
+    return long_bench_pro.TASK_METRIC_CONFIG
