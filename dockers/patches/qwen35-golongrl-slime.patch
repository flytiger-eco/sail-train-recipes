+def _gdn_section_sizes(text_config):
+    """Full-size section widths of the native GDN fused projections."""
+    key_dim = text_config.linear_num_key_heads * text_config.linear_key_head_dim
+    value_dim = text_config.linear_num_value_heads * text_config.linear_value_head_dim
+    num_value_heads = text_config.linear_num_value_heads
+    return key_dim, value_dim, num_value_heads
+
+
+def _permute_sections_rank_major(sections, tp_size: int, dim: int = 0) -> torch.Tensor:
+    """Concatenate full-size sections so that a naive TP chunk matches the rank-local layout.
+
+    Megatron-core GDN (ssm) stores in_proj/conv1d as fused tensors whose rows are
+    laid out section-wise per rank: chunk(tensor, tp)[rank] ==
+    [q_local, k_local, v_local, z_local, beta_local, alpha_local]. A plain
+    concatenation of the full sections would make the naive chunker slice across
+    section boundaries, so we pre-permute rank-major over sections instead.
+    """
+    if tp_size == 1:
+        return torch.cat(sections, dim=dim).contiguous()
+    parts = []
+    for rank in range(tp_size):
+        for section in sections:
+            parts.append(section.chunk(tp_size, dim=dim)[rank])
+    return torch.cat(parts, dim=dim).contiguous()
+
+
