+    def build_schedule_plan(
+        self,
+        input_ids: torch.Tensor,
+        position_ids: Optional[torch.Tensor] = None,
+        attention_mask: Optional[torch.Tensor] = None,
+        loss_mask: Optional[torch.Tensor] = None,
+        labels: Optional[torch.Tensor] = None,
+        modality_inputs: Optional[Dict[str, Dict[str, Any]]] = None,
+        packing_kwargs: Optional[dict] = None,
+    ):
+        from megatron.core.utils import unwrap_model
+
+        language = unwrap_model(self.language_model)
+        config = language.config
+        if (self.role.mode.name != "COLOCATED"
+                or config.tensor_model_parallel_size != 1
+                or config.context_parallel_size != 1
+                or config.pipeline_model_parallel_size != 1
+                or config.mtp_num_layers):
+            raise RuntimeError("MIMO EP schedule requires colocated TP1/CP1/PP1 without MTP")
+        if not config.overlap_moe_expert_parallel_comm:
+            raise RuntimeError("MIMO schedule plan requires EP overlap")
+        if loss_mask is None or labels is None:
+            raise RuntimeError("MIMO EP schedule requires labels and loss mask")
+
+        plan = language.build_schedule_plan(
+            input_ids=None,
+            position_ids=position_ids,
+            attention_mask=None,
+            labels=labels,
+            loss_mask=loss_mask,
+        )
+        original_preprocess = plan.pre_process.forward_func
+
+        def preprocess():
+            packed_seq_params = self._build_packed_seq_params(packing_kwargs)
+            modality_embeddings = {}
+            for comm in self.colocated_comms.values():
+                if hasattr(comm, "_set_local_batch_size"):
+                    comm._set_local_batch_size(input_ids.size(0))
+            for name, submodule in self.modality_submodules.items():
+                if modality_inputs and modality_inputs.get(name) is not None:
+                    embeddings = submodule.forward(encoder_inputs=modality_inputs[name])
+                    if embeddings is not None:
+                        modality_embeddings[name] = embeddings
+            if self.colocated_comms:
+                modality_embeddings = self._apply_colocated_comms(modality_embeddings)
+            modality_embeddings["text"] = self.get_text_embeddings(
+                input_ids, position_ids, self.special_token_ids
+            )
+            combined_embeddings = self.align_embeddings_by_token_positions(
+                modality_embeddings=modality_embeddings,
+                input_ids=input_ids,
+                special_token_ids=self.special_token_ids,
+            )
+            (plan.state.decoder_input, plan.state.labels, plan.state.loss_mask,
+             plan.state.packed_seq_params) = self._shard_language_inputs(
+                embeddings=combined_embeddings,
+                labels=labels,
+                loss_mask=loss_mask,
+                packed_seq_params=packed_seq_params,
+            )
+            return original_preprocess()
+
+        # The embedding graph must be owned by the same node that backpropagates its output.
+        plan.pre_process.forward_func = preprocess
+        return plan
+
