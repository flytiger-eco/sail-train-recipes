+    def _run_vision_encoder(
+        self, pixel_values: Tensor, image_grid_thw: Optional[Tensor]
+    ) -> Optional[Tensor]:
+        """Encode every image in the batch, optionally sharded over CP ranks.
+
+        With ``--enable-vision-cp`` the image list is split contiguously
+        across context-parallel ranks, each rank encodes its own slice, and
+        the encoder outputs are all-gathered back in original image order.
+        Contiguous (rather than round-robin) partitioning keeps the gathered
+        order aligned with ``masked_scatter``'s row-major fill of the image
+        token positions.
+
+        Without the flag, every CP rank encodes the whole batch redundantly:
+        CP only shards the language sequence downstream.
+        """
+        if pixel_values is None or pixel_values.numel() == 0:
+            return None
+
+        cp_size = parallel_state.get_context_parallel_world_size()
+        if not self.enable_vision_cp or cp_size <= 1:
+            return self.vision_model(pixel_values, image_grid_thw)
+
+        grids = image_grid_thw.tolist()
+        num_images = len(grids)
+        if num_images == 0:
+            return None
+
+        merge = self.spatial_merge_size
+        patches_per_image = [
+            int(t) * int(h) * int(w) for t, h, w in grids
+        ]
+        merged_per_image = [
+            int(t) * (int(h) // merge) * (int(w) // merge) for t, h, w in grids
+        ]
+
+        cp_rank = parallel_state.get_context_parallel_rank()
+        base_count, remainder = divmod(num_images, cp_size)
+        start = cp_rank * base_count + min(cp_rank, remainder)
+        count = base_count + (1 if cp_rank < remainder else 0)
+        end = start + count
+
+        patch_start = sum(patches_per_image[:start])
+        patch_end = patch_start + sum(patches_per_image[start:end])
+        local_tokens = sum(merged_per_image[start:end])
+
+        out_dim = self.config.hidden_size
+        dtype = next(self.vision_model.parameters()).dtype
+        device = pixel_values.device
