+        torch.distributed.all_gather(sizes, local_size, group=cp_group)
+
+        max_tokens = max(int(size.item()) for size in sizes)
+        padded = torch.zeros(max_tokens, out_dim, dtype=dtype, device=device)
+        padded[:local_tokens] = local_embeddings
+
+        # The ordinary c10d all_gather drops the encoder's autograd history.
+        # Its differentiable counterpart sums every CP consumer in backward.
+        from torch.distributed.nn.functional import all_gather
+        gathered = all_gather(padded, group=cp_group)
