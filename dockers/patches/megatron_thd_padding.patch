+def _zero_packed_attention_padding(
+    output: Tensor,
+    packed_seq_params: Optional[PackedSeqParams],
+    cp_size: int = 1,
+    cp_rank: int = 0,
+) -> Tensor:
+    """Zero physical THD padding before gating/projection to prevent nonfinite weight gradients."""
+    if packed_seq_params is None or packed_seq_params.qkv_format != "thd":
+        return output
+    physical = packed_seq_params.cu_seqlens_q_padded
+    logical = packed_seq_params.cu_seqlens_q
+    if physical is None:
+        return output
+    if logical is None or logical.numel() != physical.numel() or logical.numel() < 2:
+        raise ValueError("THD padding zeroing requires paired logical and physical offsets")
+    if getattr(packed_seq_params, "cp_partition_mode", "zigzag") != "zigzag":
+        raise ValueError("THD attention padding zeroing currently supports only zigzag CP partitioning")
+    total_tokens = output.shape[0] * cp_size
+    if cp_size > 1:
+        # Reuse the input partition indices; do not split the full pack into contiguous rank slices.
+        import transformer_engine_torch as tex
+
+        indices = tex.thd_get_partitioned_indices(physical, total_tokens, cp_size, cp_rank)
+    else:
+        indices = torch.arange(total_tokens, device=output.device, dtype=physical.dtype)
+    indices = indices.to(torch.long)
+    sequence = torch.searchsorted(physical[1:].contiguous(), indices.to(physical.dtype), right=True)
+    safe_sequence = sequence.clamp(max=physical.numel() - 2).to(torch.long)
+    real_lengths = logical[1:] - logical[:-1]
+    valid = (sequence < physical.numel() - 1) & (
+        indices - physical.index_select(0, safe_sequence)
+        < real_lengths.index_select(0, safe_sequence)
+    )
+    # NaN * 0 is still NaN. Zero only physical padding, independently of ignored labels.
+    return output.masked_fill(~valid.reshape(-1, *([1] * (output.ndim - 1))), 0)
+
