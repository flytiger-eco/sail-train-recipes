diff --git a/megatron/core/fusions/fused_bias_swiglu.py b/megatron/core/fusions/fused_bias_swiglu.py
--- a/megatron/core/fusions/fused_bias_swiglu.py
+++ b/megatron/core/fusions/fused_bias_swiglu.py
@@ -565,3 +565,46 @@
 
 # bias_swiglu_impl = BiasSwiGLUFunction.apply
 # swiglu_impl = SwiGLUFunction.apply
+
+
+# Dense-only port of the dev recipe's PPU kernel. Preserve the newer Megatron
+# clamp/SiTU, FP8-store, bias and CPU-offload paths without changing their API.
+import os as _os
+
+if _os.environ.get("MEGATRON_SWIGLU_USE_CUDAC") == "1":
+    from megatron.core.fusions import fused_bias_swiglu_cudac as _dense_cudac
+
+    _original_bias_swiglu_impl = bias_swiglu_impl
+
+    class _DenseSwiGLUCudacFunction(torch.autograd.Function):
+        @staticmethod
+        def forward(ctx, input2d, extension):
+            ctx.save_for_backward(input2d)
+            ctx.extension = extension
+            return extension.swiglu_cuda(input2d, None, None, None)[0]
+
+        @staticmethod
+        def backward(ctx, grad_output):
+            (input2d,) = ctx.saved_tensors
+            # Non-contiguous upstream gradients are valid autograd inputs.
+            grad_output = grad_output.contiguous()
+            return ctx.extension.swiglu_cuda(input2d, grad_output, None, None)[0], None
+
+    def bias_swiglu_impl(
+        input, bias, fp8_input_store=False, cpu_offload_input=False,
+        clamp_value=None, gate_clamp_scale=None, linear_clamp_scale=None,
+    ):
+        if (not torch.jit.is_scripting() and bias is None
+                and not fp8_input_store and not cpu_offload_input
+                and clamp_value is None and gate_clamp_scale is None
+                and linear_clamp_scale is None and input.ndim in (2, 3)
+                and input.is_contiguous()):
+            input2d = input.view(-1, input.shape[-1])
+            extension = _dense_cudac.cuda_extension_plain(input2d)
+            if extension is not None:
+                output = _DenseSwiGLUCudacFunction.apply(input2d, extension)
+                return output.view(*input.shape[:-1], input.shape[-1] // 2)
+        return _original_bias_swiglu_impl(
+            input, bias, fp8_input_store, cpu_offload_input,
+            clamp_value, gate_clamp_scale, linear_clamp_scale,
+        )
