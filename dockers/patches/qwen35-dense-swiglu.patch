--- /dev/null
+++ b/megatron/core/fusions/fused_bias_swiglu_cudac.py
@@ -0,0 +1,138 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Dense BF16 SwiGLU kernel from the dev recipe, with conservative admission.
+
+Only plain, unclamped, non-offloaded activations are dispatched by the caller.
+The existing C++/CUDA source is preserved so its source-hashed extension cache
+can be reused. Unsupported shapes/devices and unavailable builds fall back to
+Megatron's original implementation. Kernel execution failures are not hidden.
+"""
+
+import hashlib
+import threading
+import warnings
+from pathlib import Path
+
+import torch
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+from megatron.core.jit import jit_fuser
+
+
+_CSRC_DIR = Path(__file__).resolve().parent / "csrc"
+_extension = None
+_extension_lock = threading.Lock()
+_extension_error = None
+
+# 真实 MoE weighted pattern 的 dtype -> 最小行数下限。真实 rows=seq*mbs(/tp 若 SP) 恒 >=1024，
+# 下限取其下保守值留足余量：bf16 targeted bench（dedicated-loop 同卡配对，rows∈[256,1024]×
+# h∈{64,1024,1408,2048}）实证 rows>=256 经真实 impl 路径 train 达 1.74~3.39×、direct fwd/bwd
+# 2.58~9.5× 于 torch.compile，60/60 gate-hit 项零回退，故 bf16 下限定 256（命中走内核；rows<256
+# 的非真实微型形态回退原版）。fp16 非这 61 配置的训练 dtype、rows>=512 区样本稀疏，阈值更高。
+# fp32 激活的加权 dW 走 FP64 归约、真实形状 [4096,8192] 实测回退 0.995×，故不纳入白名单。
+_REAL_PATTERN_MIN_ROWS = {
+    torch.bfloat16: 256,
+    torch.float16: 512,
+}
+
+
+def _get_extension():
+    """首次调用编译，之后直接返回已加载的扩展，不在导入时初始化设备。"""
+    global _extension
+    if _extension is not None:
+        return _extension
+    with _extension_lock:
+        if _extension is None:
+            if not torch.cuda.is_available():
+                raise RuntimeError("SwiGLU CUDA C 需要可用的 CUDA/HGGC 设备")
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("请在 CUDA Graph 捕获前以非空输入预热 SwiGLU CUDA C")
+            from torch.utils.cpp_extension import load
+
+            sources = [_CSRC_DIR / "swiglu.cpp", _CSRC_DIR / "swiglu.cu"]
+            cuda_flags = ["-O3", "-lineinfo", "-gencode=arch=compute_89,code=sm_89"]
+            source_hash = hashlib.sha256(
+                (torch.__version__ + repr(cuda_flags)).encode()
+            )
+            for source in sources:
+                source_hash.update(source.read_bytes())
+            digest = source_hash.hexdigest()[:12]
+            _extension = load(
+                name=f"megatron_swiglu_cudac_{digest}",
+                sources=[str(source) for source in sources],
+                extra_cflags=["-O3"],
+                extra_cuda_cflags=cuda_flags,
+                with_cuda=True,
+            )
+    return _extension
+
+
+def cuda_extension_plain(y, bias=None, grad=None):
+    """非 weighted（dense plain/bias）准入门；判据全为廉价属性 + 单调阈值 + 向量对齐豁免。
+
+    只对真实 dense 训练形态返回已加载扩展，其余返回 None（入口的 dense 包装据此回退
+    pristine 原版 impl）。与 cuda_extension 的区别：无 weights；bias 准入可零物化融合的
+    [2h] 广播形态（每行读同一 bias），逐行 [rows,2h]/标量/[rows,1] 等需物化或无法打包的
+    bias 一律回退；bias=None（plain）不受影响。
+
+    形状谓词纪律：只允许单调阈值（rows >= 下限）与向量访存所需的对齐/整除
+    （last%2==0、(last//2)%8==0、ptr%16==0），禁止任何 exact-shape 相等匹配。
+    """
+    global _extension_error
+    if torch.compiler.is_compiling() or torch.jit.is_tracing():
+        return None
+    if jit_fuser is not torch.compile or _extension_error is not None:
+        return None
+    if _get_current_dispatch_mode() is not None or torch.overrides.has_torch_function_unary(y):
+        return None
+    tensors = (y,) if grad is None else (y, grad)
+    if bias is not None:
+        tensors = tensors + (bias,)
+    if any(type(t) not in (torch.Tensor, torch.nn.Parameter) for t in tensors):
+        return None
+    if torch.autograd.forward_ad._current_level >= 0 or torch._C._are_functorch_transforms_active():
+        return None
+    # 注意：dense 门在 impl 层调用（grad 开启 + requires_grad 为常态），自带 autograd.Function
+    # 负责反向追踪，故此处**不**像 weighted 门那样要求 no-grad 上下文。
+    if any(t.layout != torch.strided or t.is_nested or t.is_conj() or t.is_neg() for t in tensors):
+        return None
+    # 真实 dense 为 bf16（61 配置 59/61）；fp16/fp32 dense 未验证，保守回退。
+    if not y.is_cuda or y.dtype not in (torch.bfloat16,):
+        return None
+    if not y.ndim or y.shape[-1] == 0 or y.shape[-1] % 2:
+        return None
+    last = y.shape[-1]
+    rows = y.numel() // last
+    if not y.is_contiguous() or y.data_ptr() % 16:
+        return None
+    # h 须 128-bit pack 对齐（对齐豁免，非 exact-shape）；真实 dense h=last/2 均为 8 的倍数。
+    if (last // 2) % 8:
+        return None
+    # 单调阈值：rows >= 下限命中内核；真实 dense rows 恒 >=1024，下限取 256 留余量。
+    min_rows = _REAL_PATTERN_MIN_ROWS.get(y.dtype)
+    if min_rows is None or rows < min_rows:
+        return None
+    # bias 准入：只接管可零物化融合的 [2h] 广播 bias（内核 bias_stride=0、每行读同一 bias）；
+    # 逐行 [rows,2h] 需物化 expanded、标量/[rows,1] 特征维广播无法打包融合，一律回退原版。
+    # 判据为形态关系（bias 是长度==last 的 1D 广播向量 + dtype/连续/16B 对齐/同设备），非 exact-shape
+    # 特化（last 随 y 变化，不是硬编码常数）。bias 梯度由 autograd 对 [rows,2h] 自动 reduce 到 [2h]，
+    # 与原版 BiasSwiGLUFunction（backward return tmp,tmp）语义一致。
+    if bias is not None and (
+            bias.dtype != y.dtype or bias.shape != (last,)
+            or not bias.is_contiguous() or bias.data_ptr() % 16
+            or bias.device != y.device):
+        return None
+    if grad is not None and (not grad.is_contiguous() or grad.data_ptr() % 16
+            or grad.shape != (*y.shape[:-1], last // 2)
+            or grad.dtype != y.dtype or grad.device != y.device):
+        return None
+    if torch.is_autocast_enabled() or "890P" not in torch.cuda.get_device_name(y.device):
+        return None
+    if _extension is None and torch.cuda.is_current_stream_capturing():
+        return None
+    try:
+        return _get_extension()
+    except (ImportError, OSError, RuntimeError) as error:
+        _extension_error = error
+        warnings.warn(f"SwiGLU CUDA C 扩展不可用，使用原版兼容路径: {error}", RuntimeWarning)
+        return None
