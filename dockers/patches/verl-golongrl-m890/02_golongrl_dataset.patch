+"""GoLongRL rule-based reward dispatch.
+
+Ported from GoLongRL `Train/verl/verl/utils/reward_score/__init__.py`
+(https://github.com/xiaoxuanNLP/GoLongRL) and wired into verl v0.9.1's
+`default_compute_score` calling convention:
+
+    compute_score(data_source, solution_str, ground_truth, extra_info)
+
+Semantics:
+  1. A global think-tag gate: a missing `</think>` or duplicated think tags
+     scores 0 (checked before any metric).
+  2. Routing by data_source to four families:
+       longbench_pro            -> 25 sub-tasks / 6 metrics, continuous [0,1]
+       math_longcot_math_verify -> math_verify semantic equality, 1/0
+       selection                -> "The correct answer is (X)", 1/0
+       EM                       -> exact string match, 1/0
+  3. Pure 1/0 scoring (ScoringConfig): wrong and malformed answers score
+     the same, no negative penalty.
+"""
+
+import os
+
+THINK_OPEN = "<think>"
+THINK_CLOSE = "</think>"
+
+# Reward-mode constants: grouping keys for TMN-GRPO mode-scale normalization.
+MODE_LONGBENCH = "longbench_pro"
+MODE_MATH = "math_longcot_math_verify"
+MODE_SELECTION = "selection"
+MODE_EM = "EM"
+
+GOLONGRL_DATA_SOURCES = (MODE_LONGBENCH, MODE_MATH, MODE_SELECTION, MODE_EM)
+
+
+def _think_gate_enabled() -> bool:
+    return os.environ.get("GOLONGRL_STRICT_THINK_GATE", "1") != "0"
+
+
+def _fail_think_gate(solution_str: str) -> bool:
+    if THINK_CLOSE not in solution_str:
+        return True
+    if solution_str.count(THINK_OPEN) > 1 or solution_str.count(THINK_CLOSE) > 1:
+        return True
+    return False
+
+
+def _normalize_ground_truth(ground_truth):
+    """Take the last element of a list; pass a str through (GoLongRL semantics)."""
+    if isinstance(ground_truth, list):
+        return ground_truth[-1]
+    return ground_truth
+
+
+def _golden_label(ground_truth):
+    ground_truth = _normalize_ground_truth(ground_truth)
+    if isinstance(ground_truth, dict):
+        return ground_truth.get("golden_label")
+    return ground_truth
+
+
+def _after_think(solution_str: str) -> str:
+    return solution_str.split(THINK_CLOSE)[-1]
+
+
+def compute_score(data_source, solution_str, ground_truth, extra_info=None) -> float:
+    """GoLongRL rule-based scoring entry; signature matches verl's default_compute_score."""
+    extra_info = extra_info or {}
+
+    if _think_gate_enabled() and _fail_think_gate(solution_str):
+        return 0.0
+
+    mode = str(extra_info.get("reward_mode") or data_source)
+    data_source = str(data_source)
+
+    if data_source == MODE_LONGBENCH or mode in _longbench_task_table():
+        from . import long_bench_pro
+
+        gt = _normalize_ground_truth(ground_truth)
+        doc_ids = gt.get("doc_ids") if isinstance(gt, dict) else gt
+        language = gt.get("summary", "English") if isinstance(gt, dict) else "English"
+        return float(long_bench_pro.compute_score(solution_str, doc_ids, mode, language))
+
+    if "math_longcot_math_verify" in data_source or "math_verify" in mode:
+        from . import math_dapo
+
+        return float(math_dapo.compute_score(solution_str, _golden_label(ground_truth), is_use_math_verify=True))
+
+    if MODE_SELECTION in data_source:
+        from . import multi_choices
+
+        return float(multi_choices.compute_score(_after_think(solution_str), _golden_label(ground_truth)))
+
+    if data_source.upper() == MODE_EM:
+        from . import em_judge
+
+        return float(em_judge.compute_score(_after_think(solution_str), _golden_label(ground_truth)))
+
+    raise NotImplementedError(f"GoLongRL reward not implemented for data_source={data_source!r}, reward_mode={mode!r}")
+
+
+def _longbench_task_table():
+    from . import long_bench_pro
+
+    return long_bench_pro.TASK_METRIC_CONFIG
