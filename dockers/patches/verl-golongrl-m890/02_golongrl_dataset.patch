+
+def compute_score(solution_str: str, ground_truth) -> float:
+    """ground_truth is the golden_label string (dicts are unwrapped upstream)."""
+    if ground_truth is None:
+        return 0.0
+    return 1.0 if str(ground_truth).strip() == solution_str.strip() else 0.0
