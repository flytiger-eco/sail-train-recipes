+@triton.jit
+def _fused_vision_mrope_tiled_kernel(
+    T, FREQS, OUT,
+    t_s_seq, t_s_batch, t_s_head, t_s_dim,
+    f_s_axis, f_s_batch, f_s_seq, f_s_dim,
+    o_s_seq, o_s_batch, o_s_head, o_s_dim,
+    SEQ: tl.constexpr, BATCH: tl.constexpr, HEADS: tl.constexpr,
+    HALF: tl.constexpr, SEC_T: tl.constexpr, SEC_H: tl.constexpr, SEC_W: tl.constexpr,
+    INTERLEAVED_MROPE: tl.constexpr, INVERSE: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr, BLOCK_HALF: tl.constexpr,
+):
+    # The generic kernel launches one CTA for each token/head, even when a
+    # head has only 36 rotary pairs. Process several rows per CTA on PPU.
+    row = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    k = tl.arange(0, BLOCK_HALF)
+    head = row % HEADS
+    batch = (row // HEADS) % BATCH
+    seq = row // (HEADS * BATCH)
+    axis = _mrope_axis(k, SEC_T, SEC_H, SEC_W, INTERLEAVED_MROPE)
+    mask = (seq[:, None] < SEQ) & (k[None, :] < HALF)
+    freq_offset = (axis[None, :] * f_s_axis + batch[:, None] * f_s_batch
+                   + seq[:, None] * f_s_seq + k[None, :] * f_s_dim)
+    angle = tl.load(FREQS + freq_offset, mask=mask, other=0.0)
+    cosine = tl.cos(angle)
+    sine = tl.sin(angle)
+    if INVERSE:
+        sine = -sine
+    src = seq * t_s_seq + batch * t_s_batch + head * t_s_head
+    dst = seq * o_s_seq + batch * o_s_batch + head * o_s_head
+    lo = tl.load(T + src[:, None] + k[None, :] * t_s_dim, mask=mask, other=0.0).to(tl.float32)
+    hi = tl.load(T + src[:, None] + (k[None, :] + HALF) * t_s_dim, mask=mask, other=0.0).to(tl.float32)
+    lo_cos = (lo * cosine).to(tl.float32)
+    hi_sin = (hi * sine).to(tl.float32)
+    hi_cos = (hi * cosine).to(tl.float32)
+    lo_sin = (lo * sine).to(tl.float32)
+    tl.store(OUT + dst[:, None] + k[None, :] * o_s_dim,
+             (lo_cos - hi_sin).to(OUT.dtype.element_ty), mask=mask)
+    tl.store(OUT + dst[:, None] + (k[None, :] + HALF) * o_s_dim,
+             (hi_cos + lo_sin).to(OUT.dtype.element_ty), mask=mask)


