diff --git a/megatron/core/ops/loss/fla_cross_entropy.py b/megatron/core/ops/loss/fla_cross_entropy.py
new file mode 100644
--- /dev/null
+++ b/megatron/core/ops/loss/fla_cross_entropy.py
@@ -0,0 +1,22 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""Adapter for the optional FLA Triton cross entropy, including TP reduction.
+
+FLA keeps row log-sum-exp in FP32 and recomputes softmax in backward instead of
+materializing native CE's FP32 vocabulary-sized intermediate. As with the other
+Megatron CE backends, logits are consumed and may be overwritten in backward.
+"""
+
+from fla.modules.fused_cross_entropy import cross_entropy_loss
+
+
+def fla_vocab_parallel_cross_entropy(logits, target, tp_group):
+    if logits.shape[:-1] != target.shape:
+        raise ValueError("CE labels must match the logits' sequence and batch dimensions")
+    losses, _ = cross_entropy_loss(
+        logits.reshape(-1, logits.shape[-1]),
+        target.reshape(-1),
+        inplace_backward=True,
+        process_group=tp_group,
+    )
+    return losses.reshape(target.shape)
