+            return _orig_weighted_swiglu(y, weights)
+        extension = _swiglu_cudac.cuda_extension(y, weights)
+        if extension is None:
+            return _orig_weighted_swiglu(y, weights)
+        return extension.swiglu_cuda(y, None, None, weights)[0]
+
+    def weighted_swiglu_back(g, y, weights):
+        if torch.jit.is_scripting():
+            return _orig_weighted_swiglu_back(g, y, weights)
+        extension = _swiglu_cudac.cuda_extension(y, weights, grad=g)
+        if extension is None:
+            return _orig_weighted_swiglu_back(g, y, weights)
