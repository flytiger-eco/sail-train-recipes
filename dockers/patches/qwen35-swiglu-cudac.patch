+        "dtype": str(x.dtype),
+        "device": str(x.device),
+        "contiguous": bool(x.is_contiguous()),
+        "stride": tuple(x.stride()),
+        "ptr_mod16": int(x.data_ptr() % 16),
+        "requires_grad": bool(x.requires_grad),
+    }
+
+
+def _log_swiglu_inputs(fn, input, bias=None, weights=None, **flags):
+    """记录一次接口调用的输入形态：best-effort、按 rank 分文件、按签名去重。"""
+    if _INPUT_LOG_DIR is None:
+        return
+    try:
+        # 追踪/脚本化期跳过，避免 graph break（正常 Megatron 路径下 impl 为 eager）
+        _compiler = getattr(torch, "compiler", None)
+        if (_compiler is not None and _compiler.is_compiling()) or torch.jit.is_scripting():
+            return
