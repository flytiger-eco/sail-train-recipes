+    if grad is not None and (not grad.is_contiguous() or grad.data_ptr() % 16
+            or grad.shape != (*y.shape[:-1], last // 2)
+            or grad.dtype != y.dtype or grad.device != y.device):
+        return None
+    if torch.is_autocast_enabled() or "890P" not in torch.cuda.get_device_name(y.device):
+        return None
+    if _extension is None and torch.cuda.is_current_stream_capturing():
+        return None
+    try:
+        return _get_extension()
+    except (ImportError, OSError, RuntimeError) as error:
+        _extension_error = error
+        warnings.warn(f"SwiGLU CUDA C 扩展不可用，使用原版兼容路径: {error}", RuntimeWarning)
+        return None
