@@ -0,0 +1,225 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+
+"""SwiGLU CUDA C 加速的准入门与扩展加载器（仅 weighted_swiglu 家族）。
+
+本模块只做两件事：按真实 MoE weighted 训练形态判定能否走 CUDA C 内核（cuda_extension），
+以及首次命中时懒编译并缓存扩展（_get_extension）。它不含任何 SwiGLU 公式，也不持有原版
+实现的副本——公共 API 与“命中内核 / 否则回退原版”的分派都在入口 fused_bias_swiglu.py：
+开启 MEGATRON_SWIGLU_USE_CUDAC=1 时，入口把 weighted_swiglu / weighted_swiglu_back 重绑为
+薄包装，包装调用本模块的门；门命中则调内核，未命中则回退入口内 pristine 的原版公式
+（@jit_fuser，即 torch.compile），故“回退即原版”“不慢于 torch.compile”天然成立，且无需
+额外的原版副本文件。原版 WeightedSwiGLUFunction / weighted_bias_swiglu_impl 在调用时按
+模块全局名查找这两个函数，故无需改动即自动走包装；plain swiglu / bias_swiglu 不受影响。
+
+weighted 门只对真实 MoE 训练形态命中内核：bf16/fp16 激活 + token-wise [rows,1] 权重、
+连续且 16-byte 对齐、h 满足 128-bit pack、rows 达 dtype 下限；其余形态一律回退原版。
+
+首次加速调用通过 cpp_extension 编译，需要 CUDA/HGGC 工具链及 ninja；构建不可用时警告
+一次并由调用方回退原版，内核执行错误不被捕获或隐藏。CUDA Graph 的加速路径须先预热扩展。
+H=512 warp 路径的 FP32 dW 使用 FP64 组间/warp 归约，FP16/BF16 输入先做两项一组的
+FP32 累加。
+"""
+
+import hashlib
+import threading
+import warnings
+from pathlib import Path
+
+import torch
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+from megatron.core.jit import jit_fuser
+
+
+_CSRC_DIR = Path(__file__).resolve().parent / "csrc"
+_extension = None
+_extension_lock = threading.Lock()
+_extension_error = None
+
+# 真实 MoE weighted pattern 的 dtype -> 最小行数下限。真实 rows=seq*mbs(/tp 若 SP) 恒 >=1024，
+# 下限取其下保守值留足余量：bf16 targeted bench（dedicated-loop 同卡配对，rows∈[256,1024]×
+# h∈{64,1024,1408,2048}）实证 rows>=256 经真实 impl 路径 train 达 1.74~3.39×、direct fwd/bwd
+# 2.58~9.5× 于 torch.compile，60/60 gate-hit 项零回退，故 bf16 下限定 256（命中走内核；rows<256
+# 的非真实微型形态回退原版）。fp16 非这 61 配置的训练 dtype、rows>=512 区样本稀疏，阈值更高。
+# fp32 激活的加权 dW 走 FP64 归约、真实形状 [4096,8192] 实测回退 0.995×，故不纳入白名单。
+_REAL_PATTERN_MIN_ROWS = {
+    torch.bfloat16: 256,
+    torch.float16: 512,
+}
+
+
+def _get_extension():
+    """首次调用编译，之后直接返回已加载的扩展，不在导入时初始化设备。"""
+    global _extension
+    if _extension is not None:
+        return _extension
+    with _extension_lock:
+        if _extension is None:
+            if not torch.cuda.is_available():
+                raise RuntimeError("SwiGLU CUDA C 需要可用的 CUDA/HGGC 设备")
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("请在 CUDA Graph 捕获前以非空输入预热 SwiGLU CUDA C")
+            from torch.utils.cpp_extension import load
+
+            sources = [_CSRC_DIR / "swiglu.cpp", _CSRC_DIR / "swiglu.cu"]
+            cuda_flags = ["-O3", "-lineinfo", "-gencode=arch=compute_89,code=sm_89"]
+            source_hash = hashlib.sha256(
+                (torch.__version__ + repr(cuda_flags)).encode()
+            )
+            for source in sources:
+                source_hash.update(source.read_bytes())
+            digest = source_hash.hexdigest()[:12]
+            _extension = load(
+                name=f"megatron_swiglu_cudac_{digest}",
+                sources=[str(source) for source in sources],
+                extra_cflags=["-O3"],
+                extra_cuda_cflags=cuda_flags,
+                with_cuda=True,
+            )
+    return _extension
+
+
+def cuda_extension(y, weights, grad=None):
+    """weighted-only 准入门；仅按元数据与执行上下文判断，不捕获内核执行错误。
+
+    只对真实 MoE weighted 训练形态返回已加载的扩展，其余返回 None（调用方——入口的
+    weighted 薄包装——据此回退 pristine 原版公式）。判据全为廉价属性检查，置于
+    get_device_name 之前，非真实形态在此短路、回退开销最小；任一不满足即回退（保守），
+    且回退即原版故“不慢于 torch.compile”天然成立。
+    """
+    global _extension_error
+    if torch.compiler.is_compiling() or torch.jit.is_tracing():
+        return None
+    # 禁用 fuser 时保留原版 eager 的中间舍入，不能偷偷启用融合数值路径。
+    if jit_fuser is not torch.compile or _extension_error is not None:
+        return None
+    if _get_current_dispatch_mode() is not None or torch.overrides.has_torch_function_unary(y):
+        return None
+    tensors = (y, weights) if grad is None else (y, weights, grad)
+    if any(type(t) not in (torch.Tensor, torch.nn.Parameter) for t in tensors):
+        return None
+    if torch.autograd.forward_ad._current_level >= 0 or torch._C._are_functorch_transforms_active():
+        return None
+    if torch.is_grad_enabled() and any(t.requires_grad for t in tensors):
+        return None
+    if any(t.layout != torch.strided or t.is_nested or t.is_conj() or t.is_neg() for t in tensors):
+        return None
+    # 真实 MoE weighted pattern 白名单：experts.py:830 weighted_bias_swiglu_impl(permuted_probs)
+    # + line 770 permuted_probs.unsqueeze(-1)=[rows,1] token 权重；激活 bf16/fp16（59/61 配置
+    # bf16），权重可为 fp32。fp32 激活的加权 dW 走 FP64 归约、真实形状实测回退，故只准入
+    # fp16/bf16 激活。
+    if not y.is_cuda or y.dtype not in (torch.float16, torch.bfloat16):
+        return None
+    if not y.ndim or y.shape[-1] == 0 or y.shape[-1] % 2:
+        return None
+    last = y.shape[-1]
+    rows = y.numel() // last
+    # 主输入须连续且 16-byte 对齐：真实为 fc1 GEMM 输出（torch 分配器 512-byte 对齐）且训练
+    # 入口用 view(-1,last)（storage_offset=0）；排除 transpose/strided/expand（is_contiguous 为假）
+    # 与 offset 视图（is_contiguous 为真但 data_ptr 错位、使内核 128-bit 打包降级）。
+    if not y.is_contiguous() or y.data_ptr() % 16:
+        return None
+    # h 须 128-bit pack 对齐：排除奇数/非对齐 h（真实 h 均为 1024/256 整数倍）；未对齐时打包读
+    # 逐级退化、实测高回退。
+    if (last // 2) % 8:
+        return None
+    # dtype 分级 rows 下限：rows>=下限命中内核（bf16 targeted bench 实证 train 1.74~3.39×、零回退），
+    # rows<下限的非真实微型形态回退原版；真实 MoE rows 恒 >=1024，bf16 下限 256 留足余量。
+    min_rows = _REAL_PATTERN_MIN_ROWS.get(y.dtype)
