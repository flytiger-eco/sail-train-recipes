+    fh.write(json.dumps(header, ensure_ascii=False) + "\n")
+    fh.flush()
+    _input_log_state.update(
+        {"fh": fh, "seen": set(), "rank": int(rank), "world": world, "host": host, "calls": 0}
+    )
+
+
+def _tensor_desc(x):
+    """提取张量形态指纹；字段与运行期准入门判据对齐（对齐/连续/dtype/形状），便于离线判定可优化点。"""
+    if x is None:
