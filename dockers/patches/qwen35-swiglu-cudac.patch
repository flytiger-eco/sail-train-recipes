+        input2d = input.view(-1, ori_shape[-1])
+        extension = _swiglu_cudac.cuda_extension_plain(input2d, bias)
+        if extension is None:
+            return _orig_bias_swiglu_impl(input, bias, fp8_input_store, cpu_offload_input)
+        output = _DenseSwiGLUCudacFunction.apply(input2d, bias, extension)
+        return output if len(ori_shape) == 2 else output.view(ori_shape[0], ori_shape[1], -1)
