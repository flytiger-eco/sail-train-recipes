+++ b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope.py
@@ -0,0 +1,61 @@
+"""D72 adapter: calls the installed rotary_kernel only; no library edits or copies."""
+from collections import Counter
+
+import torch
+from flash_attn.ops.triton.rotary import rotary_kernel
+from torch.autograd.function import once_differentiable
+
+COUNTS = Counter()
+
+
+def make_cache(cos, sin):
+    """Keeps original values; builds one compact FP32 half-table per encoder forward."""
+    if not (cos.is_cuda and sin.device == cos.device and cos.ndim == 2
+            and cos.shape == sin.shape and cos.shape[1] == 72
+            and cos.dtype == sin.dtype and cos.dtype in (torch.float32, torch.bfloat16)
+            and not cos.requires_grad and not sin.requires_grad):
+        raise ValueError('cos/sin must be same-device grad-free FP32/BF16 [N,72]')
+    with torch.no_grad(), torch.profiler.record_function('vision_rope::prepare_cossin'):
+        cache = torch.empty((2, cos.shape[0], 36), device=cos.device, dtype=torch.float32)
+        cache[0].copy_(cos[:, :36])
+        cache[1].copy_(sin[:, :36])
+    COUNTS['cache_builds'] += 1
+    return cache
+
+
+def launch(x, cache, conjugate=False):
+    if not (x.is_cuda and x.ndim == 3 and x.shape[1:] == (16, 72)
+            and x.dtype in (torch.bfloat16, torch.float32)
+            and cache.shape == (2, x.shape[0], 36) and cache.dtype == torch.float32
+            and cache.device == x.device and cache.is_contiguous() and not cache.requires_grad):
+        raise ValueError('only [N,16,72] Q/K + same-device contiguous FP32 [2,N,36] cache supported')
+    if any(stride < 0 for stride in x.stride()):
+        raise ValueError('negative strides not supported')
+    # Contiguous output; never copy non-contiguous inputs or overwrite shared QKV storage.
+    out = torch.empty(x.shape, dtype=x.dtype, device=x.device)
+    n, heads, _ = x.shape
+    if n:
+        with torch.cuda.device(x.device):
+            rotary_kernel[((n + 7) // 8, 1, heads)](
+                out, x, cache[0], cache[1], None, 0, n, 72, n,
+                0, *out.stride(), 0, *x.stride(),
+                BLOCK_K=128, IS_SEQLEN_OFFSETS_TENSOR=False, IS_VARLEN=False,
+                INTERLEAVED=False, CONJUGATE=conjugate, BLOCK_M=8, num_warps=4,
+                # HF rounds mul and add separately; avoid FMA rounding drift.
+                enable_fp_fusion=False,
+            )
+        COUNTS['backward_launches' if conjugate else 'forward_launches'] += 1
+    return out
+
+
+class VisionRoPE(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, cache):
+        ctx.save_for_backward(cache)
+        return launch(x, cache)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, grad_output):
+        cache, = ctx.saved_tensors
+        return launch(grad_output, cache, conjugate=True), None
diff --git a/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope_adapter.py b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope_adapter.py
