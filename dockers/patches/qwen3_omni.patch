+++ b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope_adapter.py
@@ -0,0 +1,152 @@
+"""Monkey-patches HF vision only; no edits to transformers/Megatron/library files."""
+from collections import Counter
+from contextvars import ContextVar
+from dataclasses import dataclass
+import functools
+import inspect
+
+import torch
+from transformers.models.qwen3_omni_moe import modeling_qwen3_omni_moe as hf
+
+from . import vision_rope as vr
+
+_ORIGINAL_FORWARD = hf.Qwen3OmniMoeVisionEncoder.forward
+_ORIGINAL_ROPE = hf.apply_rotary_pos_emb_vision
+_SCOPE = ContextVar('vision_d72_rope_scope', default=None)
+_INSTALLED = False
+COUNTS = Counter()
+LAST = None
+AUDIT = None
+
+
+@dataclass
+class _ScopeState:
+    layers: int
+    sources: tuple | None = None
+    cache: torch.Tensor | None = None
+    calls: int = 0
+    observation: dict | None = None
+
+
+def reset_stats(audit=False):
+    global LAST, AUDIT
+    if _SCOPE.get() is not None:
+        raise RuntimeError('cannot reset stats inside encoder forward')
+    COUNTS.clear()
+    vr.COUNTS.clear()
+    LAST = None
+    AUDIT = [] if audit else None
+
+
+def snapshot():
+    return dict(installed=_INSTALLED, active_scope=_SCOPE.get() is not None,
+                counts=dict(COUNTS), kernel_counts=dict(vr.COUNTS), last=LAST,
+                audit=list(AUDIT) if AUDIT is not None else None)
+
+
+def _validate_encoder(model):
+    if torch.compiler.is_compiling():
+        raise ValueError('torch.compile/CUDA Graph not validated')
+    if model.config.hidden_size != 1152 or model.config.num_heads != 16:
+        raise ValueError('only vision hidden_size=1152, 16 heads, D72 supported')
+    if any(getattr(m, 'gradient_checkpointing', False) for m in model.modules()):
+        raise ValueError('vision checkpointing unsupported (recompute escapes the cache scope)')
+    if any(p.requires_grad for p in model.parameters()):
+        raise ValueError('vision must be frozen; unfrozen needs separate validation')
+
+
+@functools.wraps(_ORIGINAL_ROPE)
+def fused_vision_rope(q, k, cos, sin):
+    scope = _SCOPE.get()
+    if scope is None:
+        # Calls outside a full encoder scope (e.g. standalone attention) keep original behavior.
+        COUNTS['outside_scope_fallbacks'] += 1
+        return _ORIGINAL_ROPE(q, k, cos, sin)
+    if q.shape != k.shape or q.dtype != k.dtype or q.device != k.device:
+        raise ValueError('vision Q/K must match in shape, dtype and device')
+    if torch.cuda.is_current_stream_capturing():
+        raise ValueError('CUDA Graph capture not supported')
+    if scope.sources is None:
+        if AUDIT is not None:
+            # Audit mode only: check duplicated halves; no device sync in training.
+            if not torch.equal(cos[:, :36], cos[:, 36:]) or not torch.equal(sin[:, :36], sin[:, 36:]):
+                raise ValueError('cos/sin halves differ; refusing to change rotary semantics')
+        scope.cache = vr.make_cache(cos, sin)
+        scope.sources = (cos, sin)
+        scope.observation = dict(
+            q_shape=list(q.shape), q_stride=list(q.stride()), k_stride=list(k.stride()),
+            q_dtype=str(q.dtype), source_dtype=str(cos.dtype), source_shape=list(cos.shape),
+            cache_shape=list(scope.cache.shape), cache_dtype=str(scope.cache.dtype),
+            cache_bytes=scope.cache.numel() * scope.cache.element_size(),
+            cache_storage=scope.cache.untyped_storage().data_ptr(),
+        )
+    elif scope.sources[0] is not cos or scope.sources[1] is not sin:
+        raise ValueError('different position tables within one encoder forward; refusing reuse')
+    with torch.profiler.record_function('vision_rope::qk'):
+        q_out = vr.VisionRoPE.apply(q, scope.cache)
+        k_out = vr.VisionRoPE.apply(k, scope.cache)
+    scope.calls += 1
+    COUNTS['rope_calls'] += 1
+    if scope.calls > scope.layers:
+        raise ValueError('more rope calls than layers; execution path not validated')
+    return q_out, k_out
+
+
+@functools.wraps(_ORIGINAL_FORWARD)
+def scoped_forward(self, *args, **kwargs):
+    global LAST
+    _validate_encoder(self)
+    state = _ScopeState(layers=len(self.blocks))
+    token = _SCOPE.set(state)
+    COUNTS['encoder_attempts'] += 1
+    try:
+        result = _ORIGINAL_FORWARD(self, *args, **kwargs)
+        if state.calls != state.layers:
+            raise RuntimeError(f'incomplete rope hookup: {state.calls} calls, expected {state.layers}')
+        COUNTS['encoder_forwards'] += 1
+        LAST = dict(state.observation or {}, layers=state.layers, rope_calls=state.calls)
+        if AUDIT is not None:
+            AUDIT.append(LAST.copy())
+        return result
+    except BaseException:
+        COUNTS['encoder_errors'] += 1
+        raise
+    finally:
+        # Hold no tensors across forwards; autograd keeps the cache for backward.
+        state.sources = None
+        state.cache = None
+        _SCOPE.reset(token)
+        COUNTS['scope_cleanups'] += 1
+
+
+def install():
+    global _INSTALLED
+    if _INSTALLED:
+        if (hf.Qwen3OmniMoeVisionEncoder.forward is not scoped_forward
+                or hf.apply_rotary_pos_emb_vision is not fused_vision_rope):
+            raise RuntimeError('entrypoints overwritten by another patch after install')
+        return
+    if (hf.Qwen3OmniMoeVisionEncoder.forward is not _ORIGINAL_FORWARD
+            or hf.apply_rotary_pos_emb_vision is not _ORIGINAL_ROPE):
+        raise RuntimeError('HF vision entrypoints already patched; refusing silent override')
+    if tuple(inspect.signature(_ORIGINAL_ROPE).parameters) != ('q', 'k', 'cos', 'sin'):
+        raise RuntimeError('HF vision RoPE signature changed')
+    if getattr(_ORIGINAL_FORWARD, '__module__', None) != hf.__name__:
+        raise RuntimeError('unexpected source of HF vision forward')
+    hf.Qwen3OmniMoeVisionEncoder.forward = scoped_forward
+    hf.apply_rotary_pos_emb_vision = fused_vision_rope
+    _INSTALLED = True
+
+
+def uninstall():
+    global _INSTALLED
+    if _SCOPE.get() is not None:
+        raise RuntimeError('cannot uninstall inside encoder forward')
+    if not _INSTALLED:
+        return
+    if (hf.Qwen3OmniMoeVisionEncoder.forward is not scoped_forward
+            or hf.apply_rotary_pos_emb_vision is not fused_vision_rope):
+        raise RuntimeError('foreign patch present; refusing to uninstall its entrypoints')
+    hf.Qwen3OmniMoeVisionEncoder.forward = _ORIGINAL_FORWARD
+    hf.apply_rotary_pos_emb_vision = _ORIGINAL_ROPE
+    _INSTALLED = False
