+++ b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/rope_adapter.py
@@ -0,0 +1,94 @@
+"""Language-trunk entry: angles or explicit trig payload; never mix silently."""
+import functools
+import inspect
+import os
+
+import torch
+from megatron.core.models.common.embeddings.rope_utils import fused_apply_rotary_pos_emb
+from megatron.bridge.models.qwen_vl.modelling_qwen3_vl import rope
+from megatron.bridge.models.qwen_vl.modelling_qwen3_vl.text_model import Qwen3VLGPTModel
+from . import cached_rope
+
+MODES = ('te', 'triton_uncached', 'triton_cached')
+MODE = 'te'
+_original_apply = rope.apply_rotary_pos_emb_absolute
+_original_freqs = rope.Qwen3VLMultimodalRotaryEmbedding.forward
+_original_model = Qwen3VLGPTModel.forward
+_model_signature = inspect.signature(_original_model)
+_installed = False
+
+
+def set_mode(mode):
+    global MODE
+    if mode not in MODES:
+        raise ValueError(f'unknown mode: {mode}')
+    MODE = mode
+
+
+def validate_config(config):
+    for name in ('context_parallel_size', 'tensor_model_parallel_size', 'pipeline_model_parallel_size'):
+        if getattr(config, name, 1) != 1:
+            raise ValueError(f'{name}=1 required')
+    for name in ('rotary_interleaved', 'fp8', 'fp4', 'enable_cuda_graph', 'cpu_offloading',
+                 'fine_grained_activation_offloading', 'mtp_num_layers', 'flash_decode'):
+        if getattr(config, name, None):
+            raise ValueError(f'unvalidated config: {name}={getattr(config, name)}')
+    if getattr(config, 'cuda_graph_impl', 'none') not in (None, 'none'):
+        raise ValueError('CUDA Graph not supported')
+
+
+@functools.wraps(_original_model)
+def model_forward(self, *args, **kwargs):
+    bound = _model_signature.bind(self, *args, **kwargs)
+    validate_config(self.config)
+    if not self.training or any(bound.arguments.get(key) is not None for key in
+                               ('inference_context', 'inference_params', 'packed_seq_params')):
+        raise ValueError('only non-packed training forward is supported')
+    if MODE != 'te' and not self.config.apply_rope_fusion:
+        raise ValueError('Triton modes require apply_rope_fusion=True')
+    return _original_model(self, *args, **kwargs)
+
+
+@functools.wraps(_original_freqs)
+def frequency_forward(self, *args, **kwargs):
+    freqs = _original_freqs(self, *args, **kwargs)
+    if MODE == 'triton_cached':
+        return cached_rope.make_cache(freqs)
+    return freqs
+
+
+def apply_absolute(t, payload, config, cu_seqlens=None):
+    validate_config(config)
+    if cu_seqlens is not None or t.ndim != 4 or t.shape[1] != 1 or t.shape[-1] != 128:
+        raise ValueError('only non-packed, MBS1, head_dim128 supported')
+    if not config.apply_rope_fusion:
+        if MODE != 'te':
+            raise ValueError('cached payload passed to the unfused angle path')
+        return _original_apply(t, payload, config, cu_seqlens=None)
+    dtype = t.dtype
+    if config.apply_rotary_pos_emb_in_fp32:
+        t = t.float()
+    if MODE == 'triton_cached':
+        result = cached_rope.CachedRoPE.apply(t, payload)
+    else:
+        cached_rope.check_freqs(payload)
+        if MODE == 'te':
+            if fused_apply_rotary_pos_emb is None:
+                raise RuntimeError('TE fused API unavailable')
+            result = fused_apply_rotary_pos_emb(t, payload, interleaved=False)
+        else:
+            result = cached_rope.UncachedRoPE.apply(t, payload)
+    return result.to(dtype) if config.apply_rotary_pos_emb_in_fp32 else result
+
+
+def install(mode=None):
+    global _installed
+    set_mode(mode or os.environ.get('MROPE_BACKEND', 'te'))
+    if _installed:
+        return
+    from megatron.bridge.models.qwen_vl.modelling_qwen3_vl import attention
+    rope.apply_rotary_pos_emb_absolute = apply_absolute
+    attention.apply_rotary_pos_emb_absolute = apply_absolute
+    rope.Qwen3VLMultimodalRotaryEmbedding.forward = frequency_forward
+    Qwen3VLGPTModel.forward = model_forward
+    _installed = True
diff --git a/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope.py b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/vision_rope.py
