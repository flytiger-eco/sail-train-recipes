@@ -0,0 +1,88 @@
+"""FP32 trig payload path; reuses the installed Triton kernel, no library edits."""
+from collections import Counter
+
+import torch
+from torch.autograd.function import once_differentiable
+from flash_attn.ops.triton.rotary import rotary_kernel
+
+COUNTS = Counter()
+AUDIT = None
+
+
+def reset_stats(audit=False):
+    global AUDIT
+    COUNTS.clear()
+    AUDIT = [] if audit else None
+
+
+def record_tensor(kind, value):
+    if AUDIT is not None:
+        AUDIT.append(dict(kind=kind, storage=value.untyped_storage().data_ptr(),
+                          bytes=value.untyped_storage().nbytes(), shape=list(value.shape)))
+
+
+def check_freqs(freqs):
+    if not (freqs.is_cuda and freqs.dtype == torch.float32
+            and freqs.ndim == 4 and freqs.shape[1:] == (1, 1, 128)
+            and freqs.is_contiguous() and not freqs.requires_grad):
+        raise ValueError('freqs must be contiguous on-device FP32 [S,1,1,128], no grad')
+
+
+def make_cache(freqs):
+    """Angle halves are identical by construction; keep cos/sin of the first 64 dims."""
+    check_freqs(freqs)
+    with torch.no_grad(), torch.profiler.record_function('mrope::build_cossin'):
+        result = torch.empty((2, freqs.shape[0], 64), device=freqs.device, dtype=torch.float32)
+        angles = freqs[:, 0, 0, :64]
+        torch.cos(angles, out=result[0])
+        torch.sin(angles, out=result[1])
+    COUNTS['cache_builds'] += 1
+    record_tensor('build', result)
+    return result
+
+
+def launch(t, cache, conjugate=False):
+    if not (t.is_cuda and t.dtype in (torch.bfloat16, torch.float32)
+            and t.ndim == 4 and t.shape[1] == 1 and t.shape[-1] == 128
+            and cache.shape == (2, t.shape[0], 64) and cache.dtype == torch.float32
+            and cache.device == t.device and cache.is_contiguous() and not cache.requires_grad):
+        raise ValueError('rotary needs SBHD/MBS1/head_dim128 + same-device contiguous FP32 [2,S,64] cache')
+    output = torch.empty_like(t)
+    s, _, heads, _ = t.shape
+    # Pass SBHD strides directly; no copy of Q/K or upstream grads.
+    with torch.cuda.device(t.device):
+        rotary_kernel[((s + 7) // 8, 1, heads)](
+            output, t, cache[0], cache[1], None, 0, s, 128, s,
+            output.stride(1), output.stride(0), output.stride(2), output.stride(3),
+            t.stride(1), t.stride(0), t.stride(2), t.stride(3),
+            128, False, False, False, conjugate, 8, num_warps=4,
+        )
+    COUNTS['backward' if conjugate else 'forward'] += 1
+    record_tensor('backward' if conjugate else 'forward', cache)
+    return output
+
+
+class CachedRoPE(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, t, cache):
+        ctx.save_for_backward(cache)
+        return launch(t, cache)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, grad_output):
+        cache, = ctx.saved_tensors
+        return launch(grad_output, cache, conjugate=True), None
+
+
+class UncachedRoPE(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, t, freqs):
+        ctx.save_for_backward(freqs)
+        return launch(t, make_cache(freqs))
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, grad_output):
+        freqs, = ctx.saved_tensors
+        return launch(grad_output, make_cache(freqs), conjugate=True), None
