+"""Qwen3-Omni fused RoPE -- post-patch, enabled by default in the image.
+
+Packages two runtime adapters validated bit-exact against the originals:
+  * Language mRoPE: Triton rotary_kernel + shared FP32 cos/sin cache
+    (built once per step; reused by 148 fwd + 96 bwd + recompute calls).
+  * Vision D72 RoPE: Triton rotary_kernel + one [2,N,36] FP32 half-table
+    built per encoder forward and shared by all 27 layers.
+
+Both are monkey patches installed at model build time; no edits to installed
+Megatron-Bridge / Megatron-LM / transformers / flash-attn sources. This patch
+only adds this package plus one install trigger in thinker_model.py.
+"""
+import logging
+
+from . import rope_adapter as _language
+from . import vision_rope_adapter as _vision
+
+_LOGGER = logging.getLogger(__name__)
+_INSTALLED = False
+
+
+def install_default_rope_fusion(language_config=None):
+    """Enable fused RoPE as the image default.
+
+    Reproduces the validated harness config (APPLY_ROPE_FUSION=True + runtime
+    install). Idempotent across model builds and ranks.
+    """
+    global _INSTALLED
+    # triton_cached mode is gated on config.apply_rope_fusion; MB provide()
+    # forces it False, so re-enable it here (same as the validated recipe
+    # override APPLY_ROPE_FUSION=True). The original apply_rotary_pos_emb_absolute
+    # holding the not-fusion assert has been replaced by rope_adapter.install().
+    if language_config is not None:
+        language_config.apply_rope_fusion = True
+    if _INSTALLED:
+        return
+    _language.install("triton_cached")
+    _vision.install()
+    _INSTALLED = True
+    _LOGGER.info(
+        "Qwen3-Omni fused RoPE installed (language=triton_cached, vision=D72)."
+    )
diff --git a/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/cached_rope.py b/src/megatron/bridge/models/qwen_omni/modeling_qwen3_omni/rope_fusion/cached_rope.py
