+  task=robotwin_uncond_3cam_384_1e-4 data=robotwin num_workers=8)
+for default in save_every=0 log_every=1 +data.train.video_backend=torchcodec +data.val.video_backend=torchcodec; do
+  key="${default%%=*}"; key="${key#+}"
+  if [[ -z "${OVERRIDDEN[${key}]:-}" ]]; then COMMAND+=("${default}"); fi
+done
+COMMAND+=("${EXTRA_ARGS[@]}")
+printf '[RoboTwin] NUMA=CPU+MPOL_BIND OMP/MKL=8; optimization flags inherit the terminal environment; running workspace source\n'
