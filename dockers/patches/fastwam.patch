+#!/usr/bin/env bash
+# 单机八卡 RoboTwin：精细 CPU/worker 绑定和本地内存策略，仍委托原 ZeRO-1 入口。
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
+MODE=run
+EXTRA_ARGS=()
+declare -A OVERRIDDEN=()
+
+usage() {
+  cat <<'USAGE'
+用法：bash scripts/train_RoboTwin.sh [--check | --dry-run] [Hydra覆盖项...]
+  默认：单机8卡，RoboTwin任务，bs16/rank，8 worker/rank，OMP/MKL线程各8。
+  --check    仅检查八卡拓扑与CPU/MPOL_BIND权限，不启动训练。
+  --dry-run  同时显示实际启动命令，不启动训练。
+  数据、权重和文本缓存沿用原配置；可通过Hydra覆盖本地路径。
+  默认save_every=0、log_every=1，保留原五epoch、scheduler和eval_every=500。
+环境变量：
+  CUDA_VISIBLE_DEVICES      默认0,1,2,3,4,5,6,7；支持八卡编号重排。
+  FASTWAM_PYTHON            预检解释器，默认python；请先激活训练环境和SDK。
+示例：
+  bash scripts/train_RoboTwin.sh --check
+  bash scripts/train_RoboTwin.sh
+PPU优化开关由用户在终端自行设置，本脚本原样继承，不设置或清除。
+绑定不是CPU独占；稳定性仍依赖metadata修复、正确数据/缓存和无外部负载竞争。
+USAGE
+}
+
+fail() { printf '[RoboTwin 错误] %s\n' "$*" >&2; exit 1; }
+
+for arg in "$@"; do
+  case "${arg}" in
+    --help|-h) usage; exit 0 ;;
+    --check) [[ "${MODE}" == run ]] || fail "预检模式不能重复"; MODE=check ;;
+    --dry-run) [[ "${MODE}" == run ]] || fail "预检模式不能重复"; MODE=dry-run ;;
+    *)
+      [[ "${arg}" == *=* ]] || fail "只接受Hydra覆盖项或--check/--dry-run：${arg}"
+      key="${arg%%=*}"; key="${key#+}"; key="${key#+}"
+      value="${arg#*=}"
+      case "${key}" in
+        task) [[ "${value}" == robotwin_uncond_3cam_384_1e-4 ]] || fail "此入口只支持RoboTwin任务"; continue ;;
+        data) [[ "${value}" == robotwin ]] || fail "此入口只支持RoboTwin数据读取器"; continue ;;
+        num_workers) [[ "${value}" == 8 ]] || fail "精细绑定要求num_workers=8"; continue ;;
+      esac
+      OVERRIDDEN["${key}"]=1
+      EXTRA_ARGS+=("${arg}")
+      ;;
+  esac
+done
+
+[[ "${NNODES:-1}" == 1 && "${NODE_RANK:-0}" == 0 ]] || fail "此入口只支持单机8卡"
+[[ -z "${RANK:-}" && -z "${LOCAL_RANK:-}" ]] || fail "请勿从已有分布式rank进程嵌套启动"
+PYTHON="${FASTWAM_PYTHON:-python}"
+command -v "${PYTHON}" >/dev/null || fail "找不到${PYTHON}，请先激活训练环境"
+export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES-0,1,2,3,4,5,6,7}"
+export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
+export NNODES=1 NODE_RANK=0
+PREFLIGHT_ARGS=()
+if [[ "${MODE}" != run ]]; then PREFLIGHT_ARGS+=(--allow-busy); fi
+PLAN="$("${PYTHON}" "${SCRIPT_DIR}/robotwin_numa.py" "${PREFLIGHT_ARGS[@]}")"
+if [[ "${MODE}" == check ]]; then
+  printf '[RoboTwin] 单机8卡NUMA预检通过；未启动训练。\n'
+  exit 0
+fi
+
+# 仅影响本次启动；原入口、训练代码和用户工作区保持不变。
+export FASTWAM_NUMA_PLAN="${PLAN}"
+export PYTHONPATH="${SCRIPT_DIR}/numa_startup:${REPO_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
+COMMAND=(bash "${SCRIPT_DIR}/train_zero1.sh" 8
+  task=robotwin_uncond_3cam_384_1e-4 data=robotwin num_workers=8)
+for default in save_every=0 log_every=1 +data.train.video_backend=torchcodec +data.val.video_backend=torchcodec; do
+  key="${default%%=*}"; key="${key#+}"
+  if [[ -z "${OVERRIDDEN[${key}]:-}" ]]; then COMMAND+=("${default}"); fi
+done
+COMMAND+=("${EXTRA_ARGS[@]}")
+printf '[RoboTwin] NUMA=CPU+MPOL_BIND OMP/MKL=8，优化开关继承终端环境，运行工作区源码\n'
+printf '[RoboTwin] 工作目录：%s\n' "${REPO_DIR}"
+printf '[RoboTwin] 命令：'; printf ' %q' "${COMMAND[@]}"; printf '\n'
+if [[ "${MODE}" == dry-run ]]; then exit 0; fi
+command -v accelerate >/dev/null || fail "缺少accelerate，请在现有训练环境中运行"
+cd -- "${REPO_DIR}"
+exec "${COMMAND[@]}"
