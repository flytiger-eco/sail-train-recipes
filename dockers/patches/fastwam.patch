+printf '[RoboTwin] Command: '; printf ' %q' "${COMMAND[@]}"; printf '\n'
+if [[ "${MODE}" == dry-run ]]; then exit 0; fi
+command -v accelerate >/dev/null || fail "accelerate is missing; run inside the prepared training image"
+cd -- "${REPO_DIR}"
+exec "${COMMAND[@]}"
