diff --git a/recipes/alpamayo2_sft/stage1_full_monitor.py b/recipes/alpamayo2_sft/stage1_full_monitor.py
new file mode 100644
index 0000000..67fbbcd
--- /dev/null
+++ b/recipes/alpamayo2_sft/stage1_full_monitor.py
@@ -0,0 +1,85 @@
+"""Runtime metrics and short-run stop callback for seven-camera, four-frame Stage 1."""
+
+import json
+import math
+import time
+from pathlib import Path
+
+import torch
+from transformers import TrainerCallback
+
+
+class FullRunMonitor(TrainerCallback):
+    """Records per-rank memory at optimizer-step boundaries without changing model math."""
+
+    def __init__(self, stop_after=0, save_at_stop=True):
+        self.stop_after = int(stop_after)
+        # save_at_stop=False is for pure-profiling short runs: exit at the stop step without writing a multi-hundred-GB checkpoint.
+        self.save_at_stop = bool(save_at_stop)
+        self._step_started = None
+        self._last_step_end = None
+
+    def _record(self, args, event):
+        path = Path(args.output_dir) / f"metrics_rank{args.process_index}.jsonl"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(event, ensure_ascii=False, allow_nan=False) + "\n")
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        self._record(args, {
+            "event": "train_begin", "time": time.time(),
+            "global_step": state.global_step, "max_steps": state.max_steps,
+            "world_size": args.world_size, "stop_after": self.stop_after,
+        })
+        if self.stop_after and state.global_step >= self.stop_after:
+            raise ValueError("the resume position has already reached the short-run stop step; use resume mode")
+
+    def on_step_begin(self, args, state, control, **kwargs):
+        torch.cuda.synchronize()
+        torch.cuda.reset_peak_memory_stats()
+        self._step_started = time.perf_counter()
+
+    def on_step_end(self, args, state, control, **kwargs):
+        torch.cuda.synchronize()
+        now = time.perf_counter()
+        # The window time excludes prefetch before the step starts; the gap between adjacent step-ends also includes logging, saving, and data fetching.
+        self._record(args, {
+            "event": "step", "time": time.time(), "global_step": state.global_step,
+            "step_window_seconds": now - self._step_started,
+            "since_previous_step_end_seconds": (
+                None if self._last_step_end is None else now - self._last_step_end
+            ),
+            "allocated_gib": torch.cuda.memory_allocated() / 2**30,
+            "reserved_gib": torch.cuda.memory_reserved() / 2**30,
+            "peak_allocated_gib": torch.cuda.max_memory_allocated() / 2**30,
+            "peak_reserved_gib": torch.cuda.max_memory_reserved() / 2**30,
+        })
+        self._last_step_end = now
+        if self.stop_after and state.global_step >= self.stop_after:
+            control.should_log = True
+            if self.save_at_stop:
+                control.should_save = True
+            control.should_training_stop = True
+        return control
+
+    def on_log(self, args, state, control, logs=None, **kwargs):
+        if logs is None:
+            return
+        for key in ("loss", "grad_norm", "train_loss"):
+            if key in logs and not math.isfinite(float(logs[key])):
+                raise FloatingPointError(f"step {state.global_step} {key} is non-finite: {logs[key]}")
+        self._record(args, {
+            "event": "log", "time": time.time(), "global_step": state.global_step,
+            "metrics": logs,
+        })
+
+    def on_save(self, args, state, control, **kwargs):
+        self._record(args, {
+            "event": "checkpoint_saved", "time": time.time(),
+            "global_step": state.global_step,
+        })
+
+    def on_train_end(self, args, state, control, **kwargs):
+        self._record(args, {
+            "event": "train_end", "time": time.time(), "global_step": state.global_step,
+        })
diff --git a/recipes/alpamayo2_sft/stage1_profiler.py b/recipes/alpamayo2_sft/stage1_profiler.py
new file mode 100644
index 0000000..0409c67
--- /dev/null
+++ b/recipes/alpamayo2_sft/stage1_profiler.py
@@ -0,0 +1,88 @@
+"""Collect a torch.profiler Chrome trace (json.gz) over a given global-step window to locate throughput bottlenecks.
+
+Does not change model math; it only starts/stops the profiler at optimizer-step boundaries:
+  on_step_begin(global_step == start_step-1) -> prof.start()
+  on_step_end(global_step == end_step)       -> prof.stop() + export_chrome_trace
+Verified against the transformers 4.57.1 source: on_step_begin fires before global_step is
+incremented (value N-1) and on_step_end fires after it (value N), so this window covers exactly
+the forward/backward/optimizer compute of start_step..end_step. By default only rank0 is profiled
+(matching Megatron-Bridge's profile_ranks=[0]) to avoid the size and overhead of 8 stacked traces.
+"""
+
+from pathlib import Path
+
+import torch
+from torch.profiler import ProfilerActivity, profile
+from transformers import TrainerCallback
+
+
+class TorchProfilerCallback(TrainerCallback):
+    def __init__(
+        self,
+        start_step=20,
+        end_step=21,
+        ranks=(0,),
+        record_shapes=False,
+        with_stack=False,
+        profile_memory=False,
+        subdir="torch_profile",
+    ):
+        self.start_step = int(start_step)
+        self.end_step = int(end_step)
+        self.ranks = {int(r) for r in ranks}
+        self.record_shapes = bool(record_shapes)
+        self.with_stack = bool(with_stack)
+        self.profile_memory = bool(profile_memory)
+        self.subdir = subdir
+        self._prof = None
+        self._active = False
+
+    def _enabled(self, args):
+        return args.process_index in self.ranks
+
+    def _export(self, args, tag):
+        if self._prof is None:
+            return
+        torch.cuda.synchronize()
+        self._prof.stop()
+        self._active = False
+        out_dir = Path(args.output_dir) / self.subdir
+        out_dir.mkdir(parents=True, exist_ok=True)
+        path = out_dir / f"rank{args.process_index}-step{self.start_step}-{self.end_step}-{tag}.json.gz"
+        self._prof.export_chrome_trace(str(path))
+        size_mb = path.stat().st_size / 1e6
+        print(
+            f"[profiler] rank{args.process_index} exported {path} ({size_mb:.1f} MB)",
+            flush=True,
+        )
+        self._prof = None
+
+    def on_step_begin(self, args, state, control, **kwargs):
+        if not self._enabled(args) or self._active:
+            return
+        if state.global_step == self.start_step - 1:
+            torch.cuda.synchronize()
+            self._prof = profile(
+                activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
+                record_shapes=self.record_shapes,
+                with_stack=self.with_stack,
+                profile_memory=self.profile_memory,
+            )
+            self._prof.start()
+            self._active = True
+            print(
+                f"[profiler] rank{args.process_index} start capturing global_step {self.start_step}"
+                f" (current global_step={state.global_step})",
+                flush=True,
+            )
+
+    def on_step_end(self, args, state, control, **kwargs):
+        if not self._enabled(args) or not self._active:
+            return
+        if state.global_step == self.end_step:
+            self._export(args, tag="end")
+
+    def on_train_end(self, args, state, control, **kwargs):
+        # Safety net: if training ends before end_step is reached, still flush what was captured.
+        if self._enabled(args) and self._active:
+            self._export(args, tag="truncated")
diff --git a/recipes/alpamayo2_sft/stage1_selective_ckpt.py b/recipes/alpamayo2_sft/stage1_selective_ckpt.py
new file mode 100644
index 0000000..88c2a61
--- /dev/null
+++ b/recipes/alpamayo2_sft/stage1_selective_ckpt.py
@@ -0,0 +1,83 @@
+"""Selective gradient checkpointing: keep recompute only for the first K backbone layers, disable it for the rest.
+
+Background: Alpamayo2 Stage1 (seq6144, ZeRO-3, 144GiB per card) OOMs on the first step with recompute fully off
+(allocated 139.96GiB); with recompute fully on the
+peak is about 88GiB. This callback provides a middle setting: keep recompute for num_ckpt_layers of the 64 backbone layers,
+and disable it for the rest to save forward compute; the activation-memory increase is about (N-K)/N of the fully-off case.
+
+Mechanism (transformers 4.57.1): Qwen3VLTextDecoderLayer inherits GradientCheckpointingLayer,
+whose __call__ decides whether to route through
+_gradient_checkpointing_func based on the instance attributes self.gradient_checkpointing and self.training; so after Trainer init (gradient_checkpointing_enable)
+we only need to set the attribute back to False per layer; the layers are independent under autograd and do not affect each other.
+
+Hook timing: on_train_begin (later than gradient_checkpointing_enable in Trainer.__init__,
+earlier than the first forward; DeepSpeed engine wrapping does not change submodule objects or attributes).
+It only acts on the largest same-parent group of GradientCheckpointingLayer (the 64-layer language backbone);
+recompute for the vision tower (27 layers) and the expert stays as the recipe defines.
+"""
+
+import torch.nn as nn
+from transformers import TrainerCallback
+from transformers.modeling_layers import GradientCheckpointingLayer
+
+
+def largest_ckpt_layer_group(root: nn.Module):
+    """Return the largest same-parent GradientCheckpointingLayer group [(child_name, module), ...] and the parent path."""
+    groups = {}
+    for parent_name, parent in root.named_modules():
+        for child_name, child in parent.named_children():
+            if isinstance(child, GradientCheckpointingLayer):
+                groups.setdefault(parent_name, []).append((child_name, child))
+    if not groups:
+        return None, []
+    parent_name = max(groups, key=lambda k: len(groups[k]))
+    return parent_name, groups[parent_name]
+
+
+def apply_selective_checkpointing(root: nn.Module, num_ckpt_layers: int):
+    """Keep recompute for the first num_ckpt_layers of the largest group and disable it for the rest.
+
+    Requires the Trainer to have enabled gradient_checkpointing (all layers in the group have the attribute True),
+    otherwise it raises RuntimeError -- this callback does not enable it from scratch (missing _gradient_checkpointing_func).
+    Returns (parent_path, total_layers, layers_actually_disabled).
+    """
+    parent_name, layers = largest_ckpt_layer_group(root)
+    if not layers:
+        raise RuntimeError("no GradientCheckpointingLayer found; model structure differs from expected")
+    total = len(layers)
+    if not 0 <= int(num_ckpt_layers) <= total:
+        raise RuntimeError(f"num_ckpt_layers={num_ckpt_layers} out of range [0, {total}]")
+    not_enabled = [name for name, m in layers if not m.gradient_checkpointing]
+    if not_enabled:
+        raise RuntimeError(
+            "gradient recompute is not enabled at the trainer level (found "
+            f"{len(not_enabled)}/{total} layers with gradient_checkpointing=False, e.g. {not_enabled[0]}); "
+            "selective recompute requires trainer.gradient_checkpointing=true, then this callback disables some layers"
+        )
+    disabled = 0
+    for idx, (_, module) in enumerate(layers):
+        if idx >= int(num_ckpt_layers):
+            module.gradient_checkpointing = False
+            disabled += 1
+    return parent_name, total, disabled
+
+
+class SelectiveCheckpointCallback(TrainerCallback):
+    def __init__(self, num_ckpt_layers=32):
+        self.num_ckpt_layers = int(num_ckpt_layers)
+        self._applied = False
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        if self._applied:
+            return
+        model = kwargs.get("model")
+        if model is None:
+            raise RuntimeError("on_train_begin did not receive a model; cannot apply selective recompute")
+        root = model.module if hasattr(model, "module") else model
+        parent_name, total, disabled = apply_selective_checkpointing(root, self.num_ckpt_layers)
+        self._applied = True
+        print(
+            f"[selective_ckpt] rank{args.process_index} backbone {parent_name}: {total} layers total, "
+            f"keeping recompute for {self.num_ckpt_layers} layers, disabling recompute for {disabled} layers",
+            flush=True,
+        )
diff --git a/recipes/alpamayo2_sft/stage1_te_rmsnorm.py b/recipes/alpamayo2_sft/stage1_te_rmsnorm.py
new file mode 100644
index 0000000..3d95a91
--- /dev/null
+++ b/recipes/alpamayo2_sft/stage1_te_rmsnorm.py
@@ -0,0 +1,120 @@
+"""Replace the eager five-op Qwen3VLTextRMSNorm.forward with a TransformerEngine fused RMSNorm.
+
+Problem (verified 2026-10-19: with-stack trace + elementwise attribution + Zhenwu microbenchmark):
+Alpamayo2-Super's text-backbone Qwen3VLTextRMSNorm.forward is an eager implementation
+(to(fp32)->pow(2).mean->rsqrt->mul->cast(bf16)->weight*); the per-step elementwise device time of RMSNorm
+is about 562ms (roughly 6% of the whole step), plus q_norm/k_norm (Qwen3 QK-norm) hidden inside the attention bucket.
+Zhenwu M890 microbenchmark micro_te_fused.py: TE 2.8.0 fused rmsnorm is
+2.32x faster on layernorm[6144,5120] and 7.99x on qk-norm[393216,128] (fwd+bwd device time), max|diff| 6.25e-2 = 1 bf16 ULP.
+
+This module monkeypatches Qwen3VLTextRMSNorm.forward -> TE fused rmsnorm_fwd/bwd (the autograd.Function
+wiring is copied from op_forward/op_backward in TE ops/basic/rmsnorm.py); one patch covers
+input/post_attention layernorm + q_norm/k_norm + final norm. Keeping the module and weight parameter structure
+unchanged -> fully compatible with DeepSpeed ZeRO-3 sharding and checkpoints. Before patching it asserts the installed forward is still the eager
+RMSNorm structure; a transformers version drift fails loud, never silently mis-patching.
+
+SwiGLU does not use TE: microbenchmarks show that under HF's separate gate/up structure, TE swiglu must first cat([...,2*ffn]),
+2.4x slower (see analysis/micro_te_fused_result.txt); activation fusion should go through torch.compile, out of scope for this module.
+
+Usage (injected via a hydra callback when TE_RMSNORM=1 in train_alpamayo2_super_full.sh):
+  +callbacks.te_rmsnorm._target_=alpamayo2_sft.stage1_te_rmsnorm.TERMSNormCallback
+"""
+from __future__ import annotations
+
+import inspect
+
+import torch
+from transformers import TrainerCallback
+from transformers.models.qwen3_vl import modeling_qwen3_vl as M
+
+# TE's C extension is lazily loaded: you must first import transformer_engine.pytorch to trigger registration,
+# otherwise the fused functions in cpp_extensions / transformer_engine_torch are unavailable (see the first micro_te_fused failure).
+import transformer_engine.pytorch  # noqa: F401
+from transformer_engine.pytorch.cpp_extensions import rmsnorm_bwd, rmsnorm_fwd
+from transformer_engine.pytorch.constants import TE_DType
+
+# Before patching, confirm the installed forward is still the HF eager RMSNorm (fp32 variance -> cast -> multiply by weight) structure
+_EXPECTED_MARKERS = (
+    "hidden_states.to(torch.float32)",
+    "hidden_states.pow(2).mean(-1, keepdim=True)",
+    "torch.rsqrt(variance + self.variance_epsilon)",
+    "self.weight * hidden_states.to(input_dtype)",
+)
+
+
+class _TERMSNormFn(torch.autograd.Function):
+    """TE fused RMSNorm forward/backward; wiring copied from TE ops/basic/rmsnorm.py, plus weight-dtype safety handling.
+
+    rmsnorm_fwd(x, w, eps, ln_out=None, quantizer=None, otype, sm_margin=0, zero_centered_gamma=False)
+      -> (y, _, rstdevs); zero_centered_gamma=False matches HF's weight*normalized (not weight+1).
+    rmsnorm_bwd(dy, x, rstdevs, w, sm_margin=0, zero_centered_gamma=False) -> (dx, dw).
+    """
+
+    @staticmethod
+    def forward(ctx, x: torch.Tensor, weight: torch.Tensor, eps: float) -> torch.Tensor:
+        inner = weight.numel()
+        dtype = x.dtype
+        xv = x.contiguous().view(-1, inner)
+        wv = weight.contiguous().view(inner)
+        if wv.dtype != dtype:  # in training the weight and activations share a dtype, so this rarely triggers
+            wv = wv.to(dtype)
+        y, _, rstdevs = rmsnorm_fwd(xv, wv, eps, None, None, TE_DType[dtype], 0, False)
+        ctx.save_for_backward(xv, rstdevs, wv)
+        ctx.shape = x.shape
+        ctx.wshape = weight.shape
+        ctx.wdtype = weight.dtype
+        return y.view(x.shape)
+
+    @staticmethod
+    def backward(ctx, dy: torch.Tensor):
+        xv, rstdevs, wv = ctx.saved_tensors
+        dyv = dy.contiguous().view(xv.size())
+        dx, dw = rmsnorm_bwd(dyv, xv, rstdevs, wv, 0, False)
+        if dw.dtype != ctx.wdtype:
+            dw = dw.to(ctx.wdtype)
+        return dx.view(ctx.shape), dw.view(ctx.wshape), None
+
+
+def _patched_forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+    """Replace Qwen3VLTextRMSNorm.forward: eager five ops -> a single TE fused rmsnorm."""
+    return _TERMSNormFn.apply(hidden_states, self.weight, self.variance_epsilon)
+
+
+_PATCH_FLAG = "_alpamayo2_te_rmsnorm_patched"
+
+
+def apply_te_rmsnorm(verbose: bool = True) -> bool:
+    """Swap Qwen3VLTextRMSNorm.forward for the TE fused version. Idempotent; raises on structure drift."""
+    cls = M.Qwen3VLTextRMSNorm
+    if getattr(cls, _PATCH_FLAG, False):
+        return False  # already patched, idempotent return
+
+    src = inspect.getsource(cls.forward)
+    missing = [m for m in _EXPECTED_MARKERS if m not in src]
+    if missing:
+        raise RuntimeError(
+            "Qwen3VLTextRMSNorm.forward structure differs from expected; refusing to patch (the transformers version may have drifted,"
+            f"or @use_kernel_forward_from_hub has swapped in another implementation). Missing markers: {missing}"
+        )
+
+    cls.forward = _patched_forward
+    setattr(cls, _PATCH_FLAG, True)
+    if verbose:
+        print(
+            "[te_rmsnorm] swapped Qwen3VLTextRMSNorm.forward for TE fused rmsnorm_fwd/bwd"
+            "(covering input/post-attn layernorm + q_norm/k_norm + final norm).",
+            flush=True,
+        )
+    return True
+
+
+class TERMSNormCallback(TrainerCallback):
+    """Apply the patch at on_train_begin (earlier than the first forward, later than model construction)."""
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        applied = apply_te_rmsnorm(verbose=False)
+        print(
+            f"[te_rmsnorm] rank{args.process_index} "
+            f"{'applied the TE fused RMSNorm patch' if applied else 'patch already present (idempotent skip)'}",
+            flush=True,
+        )
