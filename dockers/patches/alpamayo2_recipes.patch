@@ -0,0 +1,402 @@
+"""Fallback-capable runtime patch for Qwen3VL text/vision RoPE, without modifying the Transformers install files.
+
+Only M.apply_rotary_pos_emb and M.apply_rotary_pos_emb_vision are replaced. The existing vision FA3 patch
+dynamically looks up the latter entry, so attention.forward does not need to be changed again. Position-table generation, three-axis mRoPE,
+Q/K RMSNorm, the parameter structure, and all recompute boundaries are fully preserved; the install files of Transformers, flash_attn,
+or liger_kernel are not modified.
+
+Three backends are supported, all selected via TRITON_ROPE_BACKEND or apply_triton_rope(backend=...):
+- triton: this module ships a full-table kernel that reads the original table directly by stride, needs no position-table copy, and preserves HF's
+  BF16 intermediate rounding;
+- flash: consistent with Omni, calls the installed flash_attn's rotary_kernel, builds a contiguous compact
+  half-table per call, and uses FP32 multiply-add for BF16 text;
+- liger: calls liger_kernel's Qwen3VL RoPE adapter, requires liger-kernel to be installed separately, and likewise uses FP32
+  multiply-add for BF16 text.
+
+All three backends support BF16/FP32 on CUDA/Zhenwu, text D128 (BHSD/BSHD), and vision D72 (NHD).
+Other inputs fall back to the original HF function, including CPU, trainable position tables, and other dtypes. Only first-order backward is supported.
+TRITON_ROPE=1/text/vision selects the entry; the default is the triton backend with the patch disabled.
+"""
+from __future__ import annotations
+
+from collections import Counter
+import inspect
+import os
+
+import torch
+from torch.autograd.function import once_differentiable
+from transformers import TrainerCallback
+from transformers.models.qwen3_vl import modeling_qwen3_vl as M
+import triton
+import triton.language as tl
+
+
+BACKENDS = ('triton', 'flash', 'liger')
+_DEFAULT_BACKEND = 'triton'
+_BACKEND = _DEFAULT_BACKEND
+_FLASH_KERNEL = None
+_LIGER_TEXT = None
+_LIGER_VISION = None
+
+
+_ORIGINAL_TEXT = M.apply_rotary_pos_emb
+_ORIGINAL_VISION = M.apply_rotary_pos_emb_vision
+_INSTALLED: set[str] = set()
+COUNTS = Counter()
+
+
+@triton.jit
+def _rotary_full_table_kernel(
+    OUT, X, COS, SIN,
+    S, H,
+    XB: tl.constexpr, XS: tl.constexpr, XH: tl.constexpr, XD: tl.constexpr,
+    CB: tl.constexpr, CS: tl.constexpr, CD: tl.constexpr,
+    SB: tl.constexpr, SS: tl.constexpr, SD: tl.constexpr,
+    D: tl.constexpr, BACKWARD: tl.constexpr, ROUND_PRODUCTS: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr,
+):
+    """Pairs the front/back half dimensions; backward uses the transposed mapping, without assuming the two halves of cos/sin are equal."""
+    b = tl.program_id(1)
+    h = tl.program_id(2)
+    s = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
+    d = tl.arange(0, BLOCK_D)
+    partner = (d + D // 2) % D
+    mask = (s[:, None] < S) & (d[None, :] < D)
+    base = b * XB + s[:, None] * XS + h * XH
+    x = tl.load(X + base + d[None, :] * XD, mask, other=0).to(tl.float32)
+    xp = tl.load(X + base + partner[None, :] * XD, mask, other=0).to(tl.float32)
+    c = tl.load(COS + b * CB + s[:, None] * CS + d[None, :] * CD,
+                mask, other=0).to(tl.float32)
+    if BACKWARD:
+        sn = tl.load(SIN + b * SB + s[:, None] * SS + partner[None, :] * SD,
+                     mask, other=0).to(tl.float32)
+        rotated = tl.where(d[None, :] < D // 2, xp, -xp)
+    else:
+        sn = tl.load(SIN + b * SB + s[:, None] * SS + d[None, :] * SD,
+                     mask, other=0).to(tl.float32)
+        rotated = tl.where(d[None, :] < D // 2, -xp, xp)
+    p0 = x * c
+    p1 = rotated * sn
+    if ROUND_PRODUCTS:
+        # Corresponds to HF's two separate BF16 muls; the intermediate result must not be silently kept as FP32.
+        p0 = p0.to(OUT.dtype.element_ty).to(tl.float32)
+        p1 = p1.to(OUT.dtype.element_ty).to(tl.float32)
+    out = p0 + p1
+    offset = ((b * S + s[:, None]) * H + h) * D + d[None, :]
+    tl.store(OUT + offset, out, mask)
+
+
+def _launch(x, cos, sin, fp32_math, backward=False):
+    """x is a BSHD view; output is an independent contiguous buffer, never modifying the shared QKV in place."""
+    b, s, h, d = x.shape
+    out = torch.empty(x.shape, device=x.device, dtype=x.dtype)
+    if out.numel():
+        with torch.cuda.device(x.device):
+            _rotary_full_table_kernel[(triton.cdiv(s, 8), b, h)](
+                out, x, cos, sin, s, h,
+                *x.stride(), *cos.stride(), *sin.stride(),
+                D=d, BACKWARD=backward,
+                ROUND_PRODUCTS=not fp32_math and x.dtype == torch.bfloat16,
+                BLOCK_M=8, BLOCK_D=triton.next_power_of_2(d),
+                num_warps=4, enable_fp_fusion=False,
+            )
+        COUNTS['backward_launches' if backward else 'forward_launches'] += 1
+    return out
+
+
+class _RoPE(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, cos, sin, fp32_math):
+        ctx.save_for_backward(cos, sin)
+        ctx.fp32_math = fp32_math
+        return _launch(x, cos, sin, fp32_math)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, grad_output):
+        cos, sin = ctx.saved_tensors
+        return _launch(grad_output, cos, sin, ctx.fp32_math, backward=True), None, None, None
+
+
+class _FlashRoPE(torch.autograd.Function):
+    """Reuses flash_attn's ready-made rotary_kernel; backward uses CONJUGATE, consistent with Omni."""
+
+    @staticmethod
+    def forward(ctx, x, tables):
+        # The tables are freshly built constants; still use save_for_backward to keep the version check.
+        ctx.save_for_backward(*tables)
+        return _flash_launch(x, *tables)
+
+    @staticmethod
+    @once_differentiable
+    def backward(ctx, grad_output):
+        return _flash_launch(grad_output, *ctx.saved_tensors, conjugate=True), None
+
+
+def _ensure_backend(backend=None):
+    """Selects and initializes the backend; repeated calls are idempotent, illegal values fail immediately."""
+    global _BACKEND, _FLASH_KERNEL, _LIGER_TEXT, _LIGER_VISION
+    if backend is None:
+        # When not explicitly given: the env var takes priority, otherwise fall back to the fixed default triton (independent of call history).
+        backend = os.environ.get('TRITON_ROPE_BACKEND', _DEFAULT_BACKEND)
+    if backend not in BACKENDS:
+        raise ValueError(f'TRITON_ROPE_BACKEND must be one of {BACKENDS}, got: {backend!r}')
+    if backend == 'flash' and _FLASH_KERNEL is None:
+        from flash_attn.ops.triton.rotary import rotary_kernel
+        _FLASH_KERNEL = rotary_kernel
+    if backend == 'liger' and _LIGER_TEXT is None:
+        from liger_kernel.transformers.rope import (
+            liger_rotary_pos_emb, liger_rotary_pos_emb_vision,
+        )
+        _LIGER_TEXT = liger_rotary_pos_emb
+        _LIGER_VISION = liger_rotary_pos_emb_vision
+    _BACKEND = backend
+    return backend
+
+
+def _flash_half_tables(cos, sin, half):
+    """Reshapes the HF position table into the contiguous compact half-table that flash_attn requires."""
+    rows = cos.shape[0] * cos.shape[1] if cos.dim() == 3 else cos.shape[0]
+    cos_flat = cos.reshape(rows, cos.shape[-1]) if cos.is_contiguous() else cos.contiguous().reshape(rows, -1)
+    sin_flat = sin.reshape(rows, sin.shape[-1]) if sin.is_contiguous() else sin.contiguous().reshape(rows, -1)
+    cos_half = cos_flat[:, :half].contiguous()
+    sin_half = sin_flat[:, :half].contiguous()
+    COUNTS['flash_table_builds'] += 1
+    return cos_half, sin_half
+
+
+def _flash_launch(x, cos_half, sin_half, conjugate=False):
+    """x is BSHD; fed into the ready-made kernel as [1,B*S,H,D], output is an independent contiguous buffer."""
+    b, s, h, d = x.shape
+    n = b * s
+    out = torch.empty(x.shape, device=x.device, dtype=x.dtype)
+    if n:
+        flat = x.reshape(1, n, h, d)
+        out_flat = out.reshape(1, n, h, d)
+        with torch.cuda.device(x.device):
+            # The first 17 args are passed positionally, the last 6 constexpr by keyword; this kernel does not accept
+            # extra positional args.
+            _FLASH_KERNEL[(triton.cdiv(n, 8), 1, h)](
+                out_flat, flat, cos_half, sin_half, None, 0, n, d, n,
+                *out_flat.stride(), *flat.stride(),
+                BLOCK_K=128, IS_SEQLEN_OFFSETS_TENSOR=False, IS_VARLEN=False,
+                INTERLEAVED=False, CONJUGATE=conjugate, BLOCK_M=8,
+                num_warps=4,
+                # Consistent with the first Omni version; do not let the compiler fuse the separate multiply-add into an FMA.
+                enable_fp_fusion=False,
+            )
+        COUNTS['backward_launches' if conjugate else 'forward_launches'] += 1
+    return out
+
+
+def _flash_supported(q, k, cos, sin, vision, unsqueeze_dim=1):
+    if not _triton_supported(q, k, cos, sin, vision, unsqueeze_dim):
+        return False
+    if vision:
+        # Sharing one half-table requires Q/K to have the same dtype; otherwise splitting into two table builds is not worth it.
+        if q.dtype != k.dtype:
+            return False
+    elif cos.dim() != 3:
+        return False
+    half = cos.shape[-1] // 2
+    # The ready-made kernel reads only the front half-table and assumes the back half repeats; this premise must be proven first.
+    return (torch.equal(cos[..., :half], cos[..., half:])
+            and torch.equal(sin[..., :half], sin[..., half:]))
+
+
+def _liger_supported(q, k, cos, sin, vision, unsqueeze_dim=1):
+    if not _triton_supported(q, k, cos, sin, vision, unsqueeze_dim):
+        return False
+    # liger's kernel ignores the head/last-dim stride; a non-contiguous last dim would be silently miscomputed.
+    if any(t.stride(-1) != 1 for t in (q, k)):
+        return False
+    # liger's vision wrapper casts to FP32 itself; the text path requires Q/K and the table to share a dtype.
+    if not vision and cos.dtype != q.dtype:
+        return False
+    half = cos.shape[-1] // 2
+    return (torch.equal(cos[..., :half], cos[..., half:])
+            and torch.equal(sin[..., :half], sin[..., half:]))
+
+
+def _apply_pair(q, k, cos, sin, vision, fp32_math, unsqueeze_dim=1):
+    """Rotates a Q/K pair under the current backend; q/k are already arranged into the layout that backend expects."""
+    if _BACKEND == 'flash':
+        # One call builds a single half-table shared by Q and K; ctx holds the reference until backward finishes.
+        tables = _flash_half_tables(cos, sin, cos.shape[-1] // 2)
+        return _FlashRoPE.apply(q, tables), _FlashRoPE.apply(k, tables)
+    if _BACKEND == 'liger':
+        if vision:
+            # liger's vision wrapper does q.to(float32) internally: BF16 copies so it is safe, but float32 is a
+            # no-op, which would let rope_forward write back into the caller's tensor in place; clone float32 first to break the alias.
+            if q.dtype == torch.float32:
+                q, k = q.clone(), k.clone()
+            return _LIGER_VISION(q, k, cos, sin)
+        return _LIGER_TEXT(q, k, cos, sin, None, unsqueeze_dim)
+    return _RoPE.apply(q, cos, sin, fp32_math), _RoPE.apply(k, cos, sin, fp32_math)
+
+
+def _triton_supported(q, k, cos, sin, vision, unsqueeze_dim=1):
+    """Only takes over inputs that are explicitly covered, leaving the original function to handle the remaining signature/broadcast/dtype semantics."""
+    if torch.compiler.is_compiling():
+        return False
+    values = (q, k, cos, sin)
+    if not all(isinstance(t, torch.Tensor) for t in values):
+        return False
+    if not all(t.is_cuda and t.device == q.device for t in values):
+        return False
+    if torch.cuda.is_current_stream_capturing():
+        return False
+    if cos.requires_grad or sin.requires_grad:
+        return False
+    if any(t.dtype not in (torch.bfloat16, torch.float32) for t in values):
+        return False
+    if any(any(st < 0 for st in t.stride()) for t in values):
+        return False
+    if cos.shape != sin.shape or cos.dtype != sin.dtype:
+        return False
+    if vision:
+        return (q.ndim == k.ndim == 3 and q.shape == k.shape and q.shape[-1] == 72
+                and cos.shape == (q.shape[0], 72))
+    if unsqueeze_dim not in (1, 2) or q.ndim != 4 or k.ndim != 4:
+        return False
+    seq_axis = 2 if unsqueeze_dim == 1 else 1
+    return (q.shape[-1] == k.shape[-1] == 128 and q.shape[0] == k.shape[0]
+            and q.shape[seq_axis] == k.shape[seq_axis]
+            and cos.shape == (q.shape[0], q.shape[seq_axis], 128)
+            and q.dtype == k.dtype == cos.dtype)
+
+
+def _supported(q, k, cos, sin, vision, unsqueeze_dim=1):
+    """Base check shared by all three backends, then extra constraints per their capabilities; falls back to the original HF when unmet."""
+    if not _triton_supported(q, k, cos, sin, vision, unsqueeze_dim):
+        return False
+    if _BACKEND == 'flash':
+        return _flash_supported(q, k, cos, sin, vision, unsqueeze_dim)
+    if _BACKEND == 'liger':
+        return _liger_supported(q, k, cos, sin, vision, unsqueeze_dim)
+    return True
+
+
+def fused_apply_rotary_pos_emb(q, k, cos, sin, position_ids=None, unsqueeze_dim=1):
+    """Text: preserves the original three-axis table and GQA differing head counts; rounding semantics vary by backend."""
+    if not _supported(q, k, cos, sin, vision=False, unsqueeze_dim=unsqueeze_dim):
+        COUNTS['text_fallbacks'] += 1
+        return _ORIGINAL_TEXT(q, k, cos, sin, position_ids, unsqueeze_dim)
+    COUNTS['text_calls'] += 1
+    COUNTS[f'{_BACKEND}_text_calls'] += 1
+    if _BACKEND == 'liger':
+        # liger does the BHSD<->BSHD transpose internally; transposing again would produce wrong results.
+        if unsqueeze_dim == 2:
+            q, k = q.transpose(1, 2), k.transpose(1, 2)
+        # liger's rope_forward writes back in place into q.transpose(1,2).contiguous(); if what is handed to it
+        # is an alias view (e.g. transposed from BSHD or a transpose view of the projection output), the write-back pollutes the caller's tensor.
+        # Ensuring BHSD contiguity first breaks the alias: contiguous() is a no-op when already contiguous, and only copies when not.
+        q, k = q.contiguous(), k.contiguous()
+        qo, ko = _apply_pair(q, k, cos, sin, vision=False, fp32_math=False,
+                             unsqueeze_dim=unsqueeze_dim)
+        if unsqueeze_dim == 2:
+            qo, ko = qo.transpose(1, 2), ko.transpose(1, 2)
+        return qo, ko
+    if unsqueeze_dim == 1:
+        q, k = q.transpose(1, 2), k.transpose(1, 2)
+    qo, ko = _apply_pair(q, k, cos, sin, vision=False, fp32_math=False,
+                         unsqueeze_dim=unsqueeze_dim)
+    if unsqueeze_dim == 1:
+        qo, ko = qo.transpose(1, 2), ko.transpose(1, 2)
+    return qo, ko
+
+
+def fused_apply_rotary_pos_emb_vision(q, k, cos, sin):
+    """Vision: usable for training and per-layer recompute; the liger backend handles FP32 and the dtype cast-back itself."""
+    if not _supported(q, k, cos, sin, vision=True):
+        COUNTS['vision_fallbacks'] += 1
+        return _ORIGINAL_VISION(q, k, cos, sin)
+    COUNTS['vision_calls'] += 1
+    COUNTS[f'{_BACKEND}_vision_calls'] += 1
+    if _BACKEND == 'liger':
+        return _apply_pair(q, k, cos, sin, vision=True, fp32_math=True)
+    cos, sin = cos.unsqueeze(0), sin.unsqueeze(0)
+    qo, ko = _apply_pair(q.unsqueeze(0), k.unsqueeze(0), cos, sin,
+                         vision=True, fp32_math=True)
+    return qo.squeeze(0), ko.squeeze(0)
+
+
+def _entries():
+    return {
+        'text': ('apply_rotary_pos_emb', _ORIGINAL_TEXT, fused_apply_rotary_pos_emb),
+        'vision': ('apply_rotary_pos_emb_vision', _ORIGINAL_VISION,
+                   fused_apply_rotary_pos_emb_vision),
+    }
+
+
+def apply_triton_rope(text=True, vision=True, backend=None, verbose=True):
+    """Installs after atomic validation; idempotent and refuses to overwrite other patches. Text or vision can be enabled alone."""
+    if not isinstance(text, bool) or not isinstance(vision, bool) or not (text or vision):
+        raise ValueError('text/vision must be booleans, and at least one entry must be enabled')
+    active = _ensure_backend(backend)
+    entries = _entries()
+    wanted = [name for name, enabled in (('text', text), ('vision', vision)) if enabled]
+    for name in wanted:
+        attr, original, replacement = entries[name]
+        expected = replacement if name in _INSTALLED else original
+        if getattr(M, attr) is not expected:
+            raise RuntimeError(f'{attr} has already been overwritten by another patch; refusing to continue')
+        if name not in _INSTALLED:
+            if original.__module__ != M.__name__:
+                raise RuntimeError(f'{attr} is not the original HF implementation; refusing to overwrite')
+            source = inspect.getsource(original)
+            markers = ['(q * cos) + (rotate_half(q) * sin)',
+                       '(k * cos) + (rotate_half(k) * sin)']
+            if name == 'vision':
+                markers += ['q.float(), k.float()', 'q_embed.to(orig_q_dtype)']
+            else:
+                markers += ['cos.unsqueeze(unsqueeze_dim)', 'sin.unsqueeze(unsqueeze_dim)']
+            if any(marker not in source for marker in markers):
+                raise RuntimeError(f'{attr} source structure changed; refusing to replace silently')
+            if inspect.signature(original) != inspect.signature(replacement):
+                # The original vision function has type annotations; compare parameter names/defaults, not annotations.
+                old = [(p.name, p.kind, p.default) for p in inspect.signature(original).parameters.values()]
+                new = [(p.name, p.kind, p.default) for p in inspect.signature(replacement).parameters.values()]
+                if old != new:
+                    raise RuntimeError(f'{attr} parameter signature changed; refusing to replace')
+    half_source = inspect.getsource(M.rotate_half)
+    if any(part not in half_source for part in ('x.shape[-1] // 2', 'torch.cat((-x2, x1), dim=-1)')):
+        raise RuntimeError('rotate_half pairing semantics changed; refusing to replace')
+    changed = False
+    for name in wanted:
+        if name not in _INSTALLED:
+            attr, _, replacement = entries[name]
+            setattr(M, attr, replacement)
+            _INSTALLED.add(name)
+            changed = True
+    if verbose:
+        print(f'[triton_rope] backend {active}, enabled {sorted(_INSTALLED)}; '
+              f'position-table generation untouched', flush=True)
+    return changed
+
+
+def remove_triton_rope():
+    """Restores the entries owned by this module; unfinished autograd graphs still hold their own position tables."""
+    entries = _entries()
+    for name in _INSTALLED:
+        attr, _, replacement = entries[name]
+        if getattr(M, attr) is not replacement:
+            raise RuntimeError(f'{attr} was overwritten by another patch; refusing to unload the other entry')
+    for name in _INSTALLED:
+        attr, original, _ = entries[name]
+        setattr(M, attr, original)
+    changed = bool(_INSTALLED)
+    _INSTALLED.clear()
+    return changed
+
+
+class TritonRoPECallback(TrainerCallback):
+    def __init__(self, text=True, vision=True, backend=None):
+        self.text = text
+        self.vision = vision
+        self.backend = backend
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        apply_triton_rope(self.text, self.vision, self.backend, verbose=False)
+        print(f'[triton_rope] rank{args.process_index} backend {_BACKEND} '
+              f'enabled {sorted(_INSTALLED)}', flush=True)
