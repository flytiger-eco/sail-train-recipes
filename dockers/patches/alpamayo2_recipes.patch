@@ -0,0 +1,93 @@
+"""Replace Qwen3VLTextMLP.forward's act_fn(gate)*up with a liger fused SwiGLU (text backbone only).
+
+Background: the Qwen3VLTextMLP.forward of Alpamayo2-Super's 64-layer text backbone is an eager implementation
+`down_proj(act_fn(gate_proj(x)) * up_proj(x))` (transformers 4.57.x, hidden_act=silu).
+The intermediate step `silu(gate) * up` materializes an extra [S, intermediate=25600] silu(gate) tensor and
+saves it into the backward graph; under CKPT_LAYERS=48 (the last 16 layers are not recomputed and store full activations), such activations are one of the
+big memory consumers. liger_kernel 0.8.4's LigerSiLUMulFunction is a "no-cat, two-input" fused kernel:
+`.apply(gate, up)` computes silu(gate)*up directly, and the backward only needs to save the gate/up inputs (silu(gate) is
+recomputed from gate in the backward), eliminating that intermediate tensor. This is exactly the one SwiGLU wiring that had never been validated
+(previously only "cat first, then TE swiglu" was tested, rejected for being 2.4x slower).
+
+Design (aligned with the surgical monkeypatch style of stage1_te_rmsnorm.py / stage1_triton_rope.py):
+- Only Qwen3VLTextMLP.forward is replaced; the three nn.Linear gate_proj/up_proj/down_proj are kept
+  -> parameter names, DeepSpeed ZeRO-3 sharding hooks, and checkpoint format all stay unchanged.
+- Qwen3VLVisionMLP is never touched (two layers linear_fc1/linear_fc2 + gelu_pytorch_tanh, a different structure;
+  applying silu fusion would compute wrong results); the two classes have different names, so a class-level patch is naturally isolated.
+- rope / rms_norm / CE are not touched -- those keep using the validated-optimal TRITON_ROPE + TE_RMSNORM callbacks.
+  The symbol this module patches (Qwen3VLTextMLP.forward) is disjoint from those two (apply_rotary_pos_emb,
+  Qwen3VLTextRMSNorm.forward), so they can coexist with no ordering dependency.
+- The swiglu parameter of the official apply_liger_kernel_to_qwen3_vl is a no-op in liger 0.8.4 (the function body never
+  references it), so it must be wired by hand; this module is that hand-wired implementation and does not call the official function (which would also rebind rope/rms_norm
+  to liger versions, colliding with the TE/triton callbacks).
+- Before patching, inspect.getsource asserts the installed forward is still the eager SwiGLU structure; a transformers
+  version drift fails loud, never silently mis-patching; an idempotency flag prevents double patching.
+
+Usage (injected via a hydra callback when ALPAMAYO2_LIGER_SWIGLU=1 in train_alpamayo2_super_full.sh):
+  +callbacks.liger_swiglu._target_=alpamayo2_sft.liger_patch.LigerSwiGLUCallback
+"""
+from __future__ import annotations
+
+import inspect
+
+from transformers import TrainerCallback
+from transformers.models.qwen3_vl import modeling_qwen3_vl as M
+
+# Before patching, confirm the installed forward is still the HF eager SwiGLU (down(act(gate)*up)) structure
+_EXPECTED_MARKER = "self.act_fn(self.gate_proj(x)) * self.up_proj(x)"
+_PATCH_FLAG = "_alpamayo2_liger_swiglu_patched"
+
+
+def apply_liger_swiglu(verbose: bool = True) -> bool:
+    """Swap Qwen3VLTextMLP.forward for the liger fused SwiGLU. Idempotent; raises on structure drift.
+
+    Returns True if this call performed the patch, False if it was already patched (idempotent skip).
+    """
+    cls = M.Qwen3VLTextMLP
+    if getattr(cls, _PATCH_FLAG, False):
+        return False  # already patched, idempotent return
+
+    src = inspect.getsource(cls.forward)
+    if _EXPECTED_MARKER not in src:
+        raise RuntimeError(
+            "Qwen3VLTextMLP.forward structure differs from expected; refusing to patch (the transformers version may have drifted,"
+            "or forward has been replaced by another implementation). Missing marker: "
+            f"{_EXPECTED_MARKER!r}; actual source: {src!r}"
+        )
+
+    # Lazily import liger so there is no dependency when the switch is off (consistent with the liger backend in stage1_triton_rope.py)
+    from liger_kernel.ops import LigerSiLUMulFunction
+
+    def _patched_forward(self, x):
+        # Only the text class is patched; still guard with an act assertion so a future transformers change to the text act cannot silently mis-compute.
+        if self.config.hidden_act not in ("silu", "swish"):
+            raise ValueError(
+                f"Qwen3VLTextMLP.hidden_act={self.config.hidden_act!r} is not silu/swish; "
+                "the liger fused SwiGLU does not apply"
+            )
+        return self.down_proj(
+            LigerSiLUMulFunction.apply(self.gate_proj(x), self.up_proj(x))
+        )
+
+    cls.forward = _patched_forward
+    setattr(cls, _PATCH_FLAG, True)
+    if verbose:
+        print(
+            "[liger_swiglu] swapped Qwen3VLTextMLP.forward for the liger fused SwiGLU"
+            "(LigerSiLUMulFunction, keeping the three gate/up/down Linear layers, text 64 layers only; "
+            "vision MLP / rope / rmsnorm / CE all untouched).",
+            flush=True,
+        )
+    return True
+
+
+class LigerSwiGLUCallback(TrainerCallback):
+    """Apply the patch at on_train_begin (earlier than the first forward, later than model construction)."""
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        applied = apply_liger_swiglu(verbose=False)
+        print(
+            f"[liger_swiglu] rank{args.process_index} "
+            f"{'applied the liger fused SwiGLU patch' if applied else 'patch already present (idempotent skip)'}",
+            flush=True,
+        )
