+++ b/recipes/alpamayo2_sft/stage1_vision_fa3_varlen.py
@@ -0,0 +1,144 @@
+"""Make the Qwen3VL vision tower take the cu_seqlens concurrent-varlen path under the FA3 backend too.
+
+Problem (verified 2026-10-19, with-stack trace step10-11):
+in transformers' Qwen3VLVisionAttention.forward, only `_attn_implementation == "flash_attention_2"`
+passes cu_seqlens into a single attention call (varlen concurrency, 28 windows in one kernel); other backends (including our
+currently active flash_attention_3) all fall into the else branch: torch.split into chunks -> a list comprehension calls them
+serially chunk by chunk -> torch.cat. Measured: the vision tower therefore launches 2268 small attention kernels per step (fwd 1512 avg43us occupancy only
+13% + bwd 756 avg108us), about 158.8ms/step of device time. FA3 itself supports varlen (the text backbone goes through
+flash_attn_varlen_func); it is only HF's vision-tower branch check that hard-codes flash_attention_2.
+
+This module monkeypatches that check to relax it to ("flash_attention_2", "flash_attention_3"), copying the rest of the
+installed forward line by line, guaranteeing no semantic change beyond "concurrent vs serial". Before patching it asserts the installed source is still the FA2-only
+check; if a transformers version drift changes the structure it fails loud, never silently mis-patching.
+
+Usage (injected via a hydra callback when VISION_FA3_VARLEN=1 in train_alpamayo2_super_full.sh):
+  +callbacks.vision_fa3_varlen._target_=alpamayo2_sft.stage1_vision_fa3_varlen.VisionFA3VarlenCallback
+"""
+from __future__ import annotations
+
+import inspect
+from typing import Optional
+
+import torch
+from transformers import TrainerCallback
+from transformers.models.qwen3_vl import modeling_qwen3_vl as M
+
+# Used before patching to confirm the installed forward is still the "FA2-only goes concurrent, the rest serial per chunk" structure
+_EXPECTED_MARKERS = (
+    'self.config._attn_implementation == "flash_attention_2"',
+    "Process each chunk separately",
+    "torch.cat(attn_outputs",
+)
+
+
+def _patched_forward(
+    self,
+    hidden_states: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    rotary_pos_emb: Optional[torch.Tensor] = None,
+    position_embeddings: Optional[tuple[torch.Tensor, torch.Tensor]] = None,
+    **kwargs,
+) -> torch.Tensor:
+    """A line-by-line copy of Qwen3VLVisionAttention.forward; the only change is the line marked below."""
+    seq_length = hidden_states.shape[0]
+    query_states, key_states, value_states = (
+        self.qkv(hidden_states).reshape(seq_length, 3, self.num_heads, -1).permute(1, 0, 2, 3).unbind(0)
+    )
+    cos, sin = position_embeddings
+    query_states, key_states = M.apply_rotary_pos_emb_vision(query_states, key_states, cos, sin)
+
+    query_states = query_states.transpose(0, 1).unsqueeze(0)
+    key_states = key_states.transpose(0, 1).unsqueeze(0)
+    value_states = value_states.transpose(0, 1).unsqueeze(0)
+
+    attention_interface = M.eager_attention_forward
+    if self.config._attn_implementation != "eager":
+        attention_interface = M.ALL_ATTENTION_FUNCTIONS[self.config._attn_implementation]
+
+    # vvv The only change: originally == "flash_attention_2", relaxed to also include flash_attention_3 vvv
+    if self.config._attn_implementation in ("flash_attention_2", "flash_attention_3"):
+        # The FA3 varlen C++ binding passes max_seqlen straight through; a 0-dim tensor is unstable, so taking an int is safest
+        max_seqlen = int((cu_seqlens[1:] - cu_seqlens[:-1]).max())
+        attn_output, _ = attention_interface(
+            self,
+            query_states,
+            key_states,
+            value_states,
+            attention_mask=None,
+            scaling=self.scaling,
+            dropout=0.0 if not self.training else self.attention_dropout,
+            cu_seq_lens_q=cu_seqlens,
+            cu_seq_lens_k=cu_seqlens,
+            max_length_q=max_seqlen,
+            max_length_k=max_seqlen,
+            is_causal=False,
+            **kwargs,
+        )
+    else:
+        # Other implementations: process chunk by chunk (kept identical to the installed version)
+        lengths = cu_seqlens[1:] - cu_seqlens[:-1]
+        splits = [
+            torch.split(tensor, lengths.tolist(), dim=2) for tensor in (query_states, key_states, value_states)
+        ]
+        attn_outputs = [
+            attention_interface(
+                self,
+                q,
+                k,
+                v,
+                attention_mask=None,
+                scaling=self.scaling,
+                dropout=0.0 if not self.training else self.attention_dropout,
+                is_causal=False,
+                **kwargs,
+            )[0]
+            for q, k, v in zip(*splits)
+        ]
+        attn_output = torch.cat(attn_outputs, dim=1)
+    # ^^^ End of the only change ^^^
+
+    attn_output = attn_output.reshape(seq_length, -1).contiguous()
+    attn_output = self.proj(attn_output)
+    return attn_output
+
+
+_PATCH_FLAG = "_alpamayo2_fa3_varlen_patched"
+
+
+def apply_vision_fa3_varlen(verbose: bool = True) -> bool:
+    """Replace Qwen3VLVisionAttention.forward with the relaxed version. Idempotent; raises on structure drift."""
+    cls = M.Qwen3VLVisionAttention
+    if getattr(cls, _PATCH_FLAG, False):
+        return False  # already patched, idempotent return
+
+    src = inspect.getsource(cls.forward)
+    missing = [m for m in _EXPECTED_MARKERS if m not in src]
+    if missing:
+        raise RuntimeError(
+            "Qwen3VLVisionAttention.forward structure differs from expected; refusing to patch (the transformers version may have drifted)."
+            f" Missing markers: {missing}"
+        )
+
+    cls.forward = _patched_forward
+    setattr(cls, _PATCH_FLAG, True)
+    if verbose:
+        print(
+            "[vision_fa3_varlen] relaxed the Qwen3VLVisionAttention concurrency check:"
+            'flash_attention_2 -> ("flash_attention_2","flash_attention_3");'
+            "the vision tower now takes cu_seqlens concurrent varlen under FA3.",
+            flush=True,
+        )
+    return True
+
+
+class VisionFA3VarlenCallback(TrainerCallback):
+    """Apply the patch at on_train_begin (earlier than the first forward, later than model construction)."""
+
+    def on_train_begin(self, args, state, control, **kwargs):
+        applied = apply_vision_fa3_varlen(verbose=False)
+        print(
+            f"[vision_fa3_varlen] rank{args.process_index} "
+            f"{'applied the vision-tower FA3 concurrent-varlen patch' if applied else 'patch already present (idempotent skip)'}",
+            flush=True,
+        )
