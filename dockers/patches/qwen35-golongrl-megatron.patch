+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+"""Leaf type definitions for context-parallel layout helpers."""
+
+from dataclasses import dataclass
+from typing import List, Literal, Optional
+
+import torch
+
+CpPartitionMode = Literal["zigzag", "contiguous"]
+
+
+@dataclass
+class ThdCpRoute:
+    """Rank-local route plan for THD zigzag/contiguous CP layout conversion.
+
+    The route stores each layout's local communication view exactly once. A
+    directional conversion interprets the source layout fields as send metadata
+    and the target layout fields as receive metadata.
+    """
+
+    zigzag_index: Optional[torch.Tensor]
+    zigzag_split_sizes: List[int]
+    contiguous_index: Optional[torch.Tensor]
+    contiguous_split_sizes: List[int]
diff --git a/megatron/core/context_parallel_layout/utils.py b/megatron/core/context_parallel_layout/utils.py
new file mode 100644
index 0000000..722b714
--- /dev/null
+++ b/megatron/core/context_parallel_layout/utils.py
@@ -0,0 +1,58 @@
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+
+"""Packed-sequence metadata helpers for CP partition-mode tracking."""
+
+from contextlib import contextmanager
+from typing import TYPE_CHECKING, Optional
+
+from megatron.core.utils import nvtx_range_pop, nvtx_range_push
+
+
+@contextmanager
+def nvtx_range(name):
+    """Compatibility shim for MCore builds without context-manager NVTX ranges."""
+    nvtx_range_push(suffix=name)
+    try:
+        yield
+    finally:
+        nvtx_range_pop(suffix=name)
+
+import torch
+
+if TYPE_CHECKING:
+    from megatron.core.packed_seq_params import PackedSeqParams
+
+
