+@pytest.mark.parametrize("fails", [False, True])
+def test_fsdp_torch_dist_prewrap_load_is_transactional(monkeypatch, fails):
+    import megatron.bridge.training.checkpointing as checkpointing
+
+    hooks = []
+    cfg = SimpleNamespace(
+        ddp=SimpleNamespace(use_megatron_fsdp=True),
+        peft=None,
+        model=SimpleNamespace(init_model_with_meta_device=False),
+        checkpoint=SimpleNamespace(
+            load=None, pretrained_checkpoint="initial-weights", ckpt_format="fsdp_dtensor", finetune=True
+        ),
+        _checkpoint_load_required=True,
+    )
+    state = SimpleNamespace(cfg=cfg)
+    monkeypatch.setattr(checkpointing, "_resolve_checkpoint_iteration", lambda *args: (0, False))
+    monkeypatch.setattr(checkpointing, "get_checkpoint_name", lambda *args: "initial-weights/iter_0000000")
+    monkeypatch.setattr(checkpointing, "_get_checkpoint_format", lambda *args: "torch_dist")
+    monkeypatch.setattr(
+        training_setup, "_register_setup_pre_wrap_hook", lambda model, hook, **kwargs: hooks.append(hook)
+    )
+
+    def load(source, load_state, models, optimizer, scheduler, **kwargs):
+        assert source == "initial-weights"
+        assert load_state.cfg.checkpoint.ckpt_format == "torch_dist"
+        assert optimizer is scheduler is None
+        if fails:
+            raise RuntimeError("checkpoint读取失败")
+
+    monkeypatch.setattr(training_setup, "_load_checkpoint_from_path", load)
+    status = training_setup._register_fsdp_pretrained_load_hook(state)
+    assert status == {"loaded": False}
+    assert len(hooks) == 1
+    if fails:
+        with pytest.raises(RuntimeError, match="读取失败"):
+            hooks[0](["model"])
+        assert status["loaded"] is False
+    else:
+        assert hooks[0](["model"]) == ["model"]
+        assert status["loaded"] is True
+    assert cfg.checkpoint.ckpt_format == "fsdp_dtensor"
+    assert cfg.checkpoint.pretrained_checkpoint == "initial-weights"
+    assert cfg._checkpoint_load_required is True
+
+
+def test_fsdp_explicit_missing_resume_does_not_fall_back_to_pretrained(monkeypatch):
+    cfg = SimpleNamespace(
+        ddp=SimpleNamespace(use_megatron_fsdp=True),
+        peft=None,
+        checkpoint=SimpleNamespace(load="missing-resume", pretrained_checkpoint="available-pretrained"),
+    )
+    monkeypatch.setattr(training_setup, "checkpoint_exists", lambda *args: False)
+    monkeypatch.setattr(training_setup, "is_hf_checkpoint_dir", lambda *args: False)
+    monkeypatch.setattr(training_setup, "_has_global_non_persistent_checkpoint", lambda *args: False)
+    with pytest.raises(FileNotFoundError, match="resume checkpoint"):
+        training_setup._register_fsdp_pretrained_load_hook(SimpleNamespace(cfg=cfg))
