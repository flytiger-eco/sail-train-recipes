+class QwenVLGlobalPackingAdapter:
+    """Qwen-VL的模型自有packing语义；调度与路由可供其它模型共用。"""
+
+    key = "qwen_vl"
+    batch_format = "vlm"
+
+    def prepare(self, example: Mapping[str, Any], processor: Any) -> PreparedPackingSample:
+        """保留完整图片、视频、MRoPE字段及assistant监督mask。"""
+        prepared = prepare_qwen_vl_sequence(dict(example), processor)
+        tensors = {**prepared.row, **prepared.visual_values}
+        return PreparedPackingSample(
+            {key: value.contiguous() for key, value in tensors.items()},
+            prepared.sequence_length,
+            self.key,
+        )
+
+    def pack(
+        self,
+        samples: Sequence[PreparedPackingSample],
+        *,
+        pad_to_multiple_of: int,
+        device: torch.device,
+    ) -> dict[str, Any]:
+        """组合完整样本，视觉融合之前不切分token；空pack不伪造图片。"""
+        sequences = []
+        for sample in samples:
+            if sample.adapter_key != self.key:
+                raise ValueError("同一个pack不能混用不同模型adapter。")
+            row = {key: value for key, value in sample.tensors.items() if key not in QWEN_VISUAL_KEYS}
+            visual = {key: value for key, value in sample.tensors.items() if key in QWEN_VISUAL_KEYS}
+            sequences.append(QwenVLPreparedSequence(row=row, visual_values=visual))
+        if not sequences:
+            ids = torch.zeros(pad_to_multiple_of, dtype=torch.int64, device=device)
+            sequences.append(
+                QwenVLPreparedSequence(
+                    row={
+                        "input_ids": ids,
+                        "position_ids": ids.clone(),
+                        "attention_mask": torch.ones_like(ids),
+                        "labels": torch.full_like(ids, IGNORE_INDEX),
+                        "loss_mask": torch.zeros_like(ids, dtype=torch.float32),
+                    },
+                    visual_values={},
+                )
+            )
+        return build_qwen_vl_packed_batch(
+            sequences,
+            sequence_length=None,
+            pad_to_multiple_of=pad_to_multiple_of,
+            pad_to_max_length=False,
+        )
