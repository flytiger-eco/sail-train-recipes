+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""任意tensor payload的全局装箱接入，模型语义由注册的adapter负责。"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+from bisect import bisect_right
+from collections.abc import Sequence
+from typing import Any
+
+import torch
+import torch.distributed as dist
+from megatron.core.datasets.data_schedule import build_sequence_packing_plan
+from megatron.core.packed_seq_params import PackedSeqParams
+from megatron.core.process_groups_config import ProcessGroupCollection
+from megatron.core.rerun_state_machine import RerunDataIterator
+
+from megatron.bridge.data.collators.registry import resolve_model_packing_adapter
+from megatron.bridge.data.packing.global_batch import PreparedPackingSample
+from megatron.bridge.training.global_batch_packing import finalize_packed_seq_params
+
+
+logger = logging.getLogger(__name__)
+
+
+def describe_sample(sample: PreparedPackingSample) -> dict[str, Any]:
+    """只把shape/dtype/摘要放入对象collective，绝不放入文本或视觉tensor。"""
+    fields = {}
+    digest = hashlib.sha256()
+    for key, value in sorted(sample.tensors.items()):
+        if value.layout != torch.strided:
+            raise ValueError("payload路由要求稠密tensor。")
+        fields[key] = (tuple(value.shape), str(value.dtype))
+        digest.update(key.encode())
+        digest.update(value.detach().cpu().contiguous().reshape(-1).view(torch.uint8).numpy().tobytes())
+    return {
+        "fields": fields,
+        "length": sample.sequence_length,
+        "adapter": sample.adapter_key,
+        "sha256": digest.hexdigest(),
+    }
+
+
+def route_samples(
+    samples: Sequence[PreparedPackingSample],
+    descriptors: Sequence[dict[str, Any]],
+    offsets: Sequence[int],
+    assignments: Sequence[Sequence[Sequence[int]]],
+    *,
+    pg_collection: ProcessGroupCollection,
+    device: torch.device,
+) -> dict[int, PreparedPackingSample]:
+    """按唯一样本ID路由任意字段；复用原静态CP副本，避免跨lane重复发送。"""
+    pg = pg_collection
+    pool_ranks = dist.get_process_group_ranks(pg.dp_cp)
+    dp_ranks = dist.get_process_group_ranks(pg.dp)
+    me = pg.dp_cp.rank()
+    local = {offsets[pg.dp.rank()] + index: sample for index, sample in enumerate(samples)}
+    needed = [sorted({gid for stage in assignments for gid in stage[rank]}) for rank in range(len(pool_ranks))]
+    send_ids = [
+        ([gid for gid in needed[rank] if gid in local] if pool_ranks[rank] in dp_ranks else [])
+        for rank in range(len(pool_ranks))
+    ]
+    recv_ids: list[list[int]] = [[] for _ in pool_ranks]
+    for gid in needed[me]:
+        owner = bisect_right(offsets, gid) - 1
+        recv_ids[pool_ranks.index(dp_ranks[owner])].append(gid)
+    received: dict[int, dict[str, torch.Tensor]] = {gid: {} for gid in needed[me]}
+    keys = sorted({key for descriptor in descriptors for key in descriptor["fields"]})
+    for key in keys:
+        fields = [descriptor["fields"][key] for descriptor in descriptors if key in descriptor["fields"]]
+        dtype_name = fields[0][1]
+        if any(field[1] != dtype_name for field in fields):
+            raise ValueError(f"字段{key!r}的dtype不一致，不能执行tensor路由。")
+        dtype = getattr(torch, dtype_name.removeprefix("torch."))
+
+        def numel(gid: int) -> int:
+            field = descriptors[gid]["fields"].get(key)
+            return math.prod(field[0]) if field is not None else 0
+
+        send_splits = [sum(numel(gid) for gid in ids) for ids in send_ids]
+        recv_splits = [sum(numel(gid) for gid in ids) for ids in recv_ids]
+        pieces = [local[gid].tensors[key].reshape(-1) for ids in send_ids for gid in ids if key in local[gid].tensors]
+        send = (
+            torch.cat(pieces).to(device, non_blocking=True) if pieces else torch.empty(0, dtype=dtype, device=device)
+        )
+        recv = torch.empty(sum(recv_splits), dtype=dtype, device=device)
+        dist.all_to_all_single(
+            recv, send, output_split_sizes=recv_splits, input_split_sizes=send_splits, group=pg.dp_cp
+        )
+        cursor = 0
+        for ids in recv_ids:
+            for gid in ids:
+                field = descriptors[gid]["fields"].get(key)
+                count = numel(gid)
+                if field is not None:
+                    received[gid][key] = recv[cursor : cursor + count].reshape(field[0])
+                cursor += count
+        if cursor != recv.numel():
+            raise RuntimeError("payload拆包长度与通信计划不一致。")
+    return {
+        gid: PreparedPackingSample(tensors, descriptors[gid]["length"], descriptors[gid]["adapter"])
+        for gid, tensors in received.items()
+    }
+
+
+def wrap_prepared_data_iterator(
+    data_iterator: Any,
+    model_config: Any,
+    num_microbatches: int,
+    pg_collection: ProcessGroupCollection,
+    *,
+    fold_alignment_padding: bool = False,
+) -> tuple[RerunDataIterator, int, float, float]:
+    """按Core装箱计划处理模型自有payload，保持全局逻辑样本数不变。"""
+    pg = pg_collection
+    if pg.tp.size() != 1 or pg.pp.size() != 1:
+        raise ValueError("prepared payload的global packing当前要求TP1/PP1。")
+    if pg.gtp_remat is not None and pg.gtp_remat.size() > 1:
+        raise ValueError("prepared payload尚不支持GTP rematerialization。")
+    samples = []
+    local = []
+    error = None
+    try:
+        for _ in range(num_microbatches):
+            rows = next(data_iterator)
+            if not isinstance(rows, list) or any(not isinstance(row, PreparedPackingSample) for row in rows):
+                raise TypeError("global packing要求DataLoader返回PreparedPackingSample列表。")
+            samples.extend(rows)
+        local = [describe_sample(sample) for sample in samples]
+    except Exception as exc:
+        error = f"{type(exc).__name__}: {exc}"
+    errors = [None] * pg.dp_cp.size()
+    dist.all_gather_object(errors, error, group=pg.dp_cp)
+    if any(item is not None for item in errors):
+        raise RuntimeError(f"global packing的数据准备失败：{errors}")
+    gathered = [None] * pg.dp.size()
+    dist.all_gather_object(gathered, local, group=pg.dp)
+    digest = hashlib.sha256(json.dumps(gathered, sort_keys=True).encode()).hexdigest()
+    digests = [None] * pg.dp_cp.size()
+    dist.all_gather_object(digests, digest, group=pg.dp_cp)
+    if len(set(digests)) != 1:
+        raise ValueError("原静态CP副本的数据内容或payload形状不一致，拒绝路由。")
+    offsets = [0]
+    for items in gathered:
+        offsets.append(offsets[-1] + len(items))
+    descriptors = [descriptor for items in gathered for descriptor in items]
+    keys = {descriptor["adapter"] for descriptor in descriptors}
+    if len(keys) != 1:
+        raise ValueError("同一全局batch不能混用多个模型packing adapter。")
+    adapter = resolve_model_packing_adapter(next(iter(keys)))
+    dynamic = bool(getattr(model_config, "dynamic_context_parallel", False))
+    max_cp = max(pg.dynamic_cp) if dynamic else pg.cp.size()
+    alignment = 2 * max_cp if max_cp > 1 else 1
+    lengths = [
+        (gid, math.ceil(descriptor["length"] / alignment) * alignment) for gid, descriptor in enumerate(descriptors)
+    ]
+    plan = build_sequence_packing_plan(lengths, model_config, pg_collection=pg)
+    device = torch.device("cuda", torch.cuda.current_device())
+    received = route_samples(samples, descriptors, offsets, plan.assignments, pg_collection=pg, device=device)
+    batches = []
+    cp_sizes = []
+    for round_index, stage in enumerate(plan.assignments):
+        cp_group = plan.cp_group(round_index, pg)
+        cp_sizes.append(cp_group.size())
+        sample_ids = stage[pg.dp_cp.rank()]
+        batch = adapter.pack([received[gid] for gid in sample_ids], pad_to_multiple_of=alignment, device=device)
+        physical_cu = batch.get("cu_seqlens_q_padded", batch["cu_seqlens_q"])
+        logical_cu = physical_cu if fold_alignment_padding else batch["cu_seqlens_q"]
+        maximum = int((logical_cu[1:] - logical_cu[:-1]).max())
+        params = PackedSeqParams(
+            qkv_format="thd",
+            cu_seqlens_q=logical_cu,
+            cu_seqlens_kv=logical_cu,
+            cu_seqlens_q_padded=physical_cu,
+            cu_seqlens_kv_padded=physical_cu,
+            max_seqlen_q=maximum,
+            max_seqlen_kv=maximum,
+            local_cp_size=cp_group.size() if dynamic else None,
+            cp_group=cp_group,
+        )
+        if int(physical_cu[-1]) > model_config.max_seqlen_per_dp_cp_rank * cp_group.size():
+            raise ValueError("pack长度超过运行时CP组容量。")
+        batch["packed_seq_params"] = finalize_packed_seq_params(params, pg)
+        if getattr(adapter, "batch_format", None) == "gpt":
+            batch["cu_seqlens"] = logical_cu
+            batch["cu_seqlens_padded"] = physical_cu
+            batch["max_seqlen"] = torch.tensor(maximum, dtype=torch.int32, device=device)
+            if dynamic:
+                batch["local_cp_size"] = cp_group.size()
+        batch["_global_sample_ids"] = sample_ids
+        batches.append(batch)
+    if dist.get_rank() == 0:
+        histogram: dict[int, int] = {}
+        for stage in plan.assignments:
+            for ids in set(stage) - {()}:
+                size = sum(other == ids for other in stage)
+                histogram[size] = histogram.get(size, 0) + 1
+        logger.info(
+            "GLOBAL_PACKING_SCHEDULE samples=%s rounds=%s rank0_cp_sizes=%s cp_bin_hist=%s",
+            len(descriptors),
+            len(batches),
+            cp_sizes,
+            histogram,
+        )
+    return (
+        RerunDataIterator(iter(batches)),
+        len(batches),
+        float(sum(descriptor["length"] for descriptor in descriptors)),
+        float(sum(descriptor["length"] ** 2 for descriptor in descriptors)),
+    )
