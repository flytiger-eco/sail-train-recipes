+def make_precision_validator(output_dir, samples_per_parameter=64):
+    """同一份实际backward的梯度/Adam参考验收；只在显式审计中使用。"""
+    import hashlib
+    import logging
+    import time
+    from pathlib import Path
+
+    import torch.distributed as dist
+
+    from megatron.bridge.training.callbacks import Callback
+    from megatron.bridge.training.utils.pg_utils import get_pg_collection
+    from megatron.bridge.training.vlm_step import forward_step as vlm_step
+
+    logger = logging.getLogger(__name__)
+    atol, rtol = 1e-6, 1e-5
+
+    def local(value):
+        return value.to_local() if hasattr(value, "to_local") else value
+
+    class ReferenceCallback(Callback):
+        def __init__(self):
+            self.output_dir = Path(output_dir)
+            self.parameters, self.bindings, self.records, self.snapshots, self.handles = [], [], [], [], []
+
+        def pre_wrap(self, models):
+            cursor = 0
+            for chunk, model in enumerate(models):
+                for name, parameter in model.named_parameters():
+                    if not parameter.requires_grad:
+                        continue
+                    count = min(samples_per_parameter, parameter.numel())
+                    indices = (
+                        torch.arange(count, device=parameter.device, dtype=torch.int64)
+                        * (parameter.numel() - 1)
+                        // max(count - 1, 1)
+                    )
+                    self.parameters.append((f"{chunk}:{name}", parameter, indices, cursor, cursor + count))
+                    cursor += count
+            self.raw_grads = torch.zeros(cursor, device="cuda", dtype=torch.float32)
+            self.raw_used = torch.zeros(cursor, device="cuda", dtype=torch.int32)
+            self.previous_fused = torch.zeros_like(self.raw_grads)
+            self.fused_sharded = set()
+            for _, parameter, indices, start, stop in self.parameters:
+
+                def record(gradient, parameter=parameter, indices=indices, start=start, stop=stop):
+                    if getattr(parameter, "grad_added_to_main_grad", False):
+                        getter = getattr(parameter, "get_main_grad", None)
+                        main = getter() if getter is not None else parameter.main_grad
+                        current = main.detach().reshape(-1)[indices].float()
+                        # 同stage共享embedding/output还通过param.grad带回未融合的贡献。
+                        extra = (
+                            local(gradient).detach().reshape(-1)[indices].float()
+                            if getattr(parameter, "zero_out_wgrad", False)
+                            else torch.zeros_like(current)
+                        )
+                        if parameter in self.fused_sharded:
+                            self.raw_grads[start:stop].add_(current + extra)
+                        else:
+                            self.raw_grads[start:stop].add_(current - self.previous_fused[start:stop] + extra)
+                            self.previous_fused[start:stop].copy_(current + extra)
+                    else:
+                        self.raw_grads[start:stop].add_(local(gradient).detach().reshape(-1)[indices].float())
+                    self.raw_used[start:stop].fill_(1)
+                    return gradient
+
+                self.handles.append(parameter.register_hook(record))
+            return models
+
+        def snapshot(self, gradients=False):
+            keys = ["master", "exp_avg", "exp_avg_sq", "lr", "beta1", "beta2", "eps", "weight_decay", "step"]
+            if gradients:
+                keys.extend(["gradient", "gradient_present"])
+            values = torch.zeros((len(keys), self.raw_grads.numel()), device="cuda", dtype=torch.float32)
+            owners = torch.zeros(self.raw_grads.numel(), device="cuda", dtype=torch.int32)
+            for master, inner, group, target, indices in self.bindings:
+                if not target.numel():
+                    continue
+                state = inner.state.get(master, {})
+                tensors = {"master": master, "exp_avg": state.get("exp_avg"), "exp_avg_sq": state.get("exp_avg_sq")}
+                if gradients:
+                    tensors["gradient"] = master.grad
+                    values[keys.index("gradient_present"), target] = float(master.grad is not None)
+                owners[target] += 1
+                for key, tensor in tensors.items():
+                    if tensor is not None:
+                        tensor = local(tensor).detach()
+                        if tensor.dtype != torch.float32:
+                            raise ValueError(f"数值验收要求FP32 {key}，实际为{tensor.dtype}")
+                        values[keys.index(key), target] = tensor.reshape(-1)[indices]
+                beta1, beta2 = group["betas"]
+                for key, value in {
+                    "lr": group["lr"],
+                    "beta1": beta1,
+                    "beta2": beta2,
+                    "eps": group["eps"],
+                    "weight_decay": group["weight_decay"],
+                    "step": group.get("step", 0),
+                }.items():
+                    values[keys.index(key), target] = float(value)
+            dist.all_reduce(owners, group=self.pg.dp_cp)
+            if not torch.all(owners == 1).item():
+                raise RuntimeError("数值验收的每个全局采样坐标必须恰好有一个owner。")
+            # owner坐标互斥，只拼接采样值，不对已归约梯度再次做梯度归约。
+            dist.all_reduce(values, group=self.pg.dp_cp)
+            return {key: values[index].cpu() for index, key in enumerate(keys)}
+
+        def on_train_start(self, context):
+            self.output_dir.mkdir(parents=True, exist_ok=True)
+            self.pg = get_pg_collection(context.model[0])
+            self.track_grad_usage = getattr(context.model[0].ddp_config, "megatron_fsdp_track_grad_usage", False)
+            self.leaves = getattr(context.optimizer, "chained_optimizers", [context.optimizer])
+            mapping = {}
+            self.sharded = False
+            for leaf in self.leaves:
+                inner = leaf.optimizer
+                groups = {master: group for group in inner.param_groups for master in group["params"]}
+                if getattr(leaf.ddp_config, "use_megatron_fsdp", False):
+                    self.sharded = True
+                    for master in leaf.get_parameters():
+                        original = master.orig_param
+                        for chunk in context.model:
+                            buffer = chunk.param_and_grad_buffer
+                            if original in buffer.param_to_param_group:
+                                group = buffer.parameter_groups[buffer.param_to_param_group[original]]
+                                gbuf = group.hfsdp_helper_gbuf or group.main_grad_buffer
+                                if gbuf.is_data_distributed:
+                                    self.fused_sharded.add(original)
+                                wbuf = group.main_weight_buffer
+                                lo, hi = wbuf.locate_item_shard_in_global_item(wbuf.param_idx[original])
+                                mapping[original] = master, inner, groups[master], lo, hi
+                                break
+                elif hasattr(leaf, "model_param_group_index_map"):
+                    self.sharded = True
+                    for original, (group_id, order) in leaf.model_param_group_index_map.items():
+                        master = inner.param_groups[group_id]["params"][order]
+                        span = leaf._get_model_param_range_map(original)["param"]
+                        mapping[original] = master, inner, groups[master], span.start, span.end
+                elif self.pg.dp_cp.rank() == 0:
+                    for originals, masters in zip(leaf.float16_groups, leaf.fp32_from_float16_groups, strict=True):
+                        for original, master in zip(originals, masters, strict=True):
+                            mapping[original] = master, inner, groups[master], 0, original.numel()
+                self.handles.append(inner.register_step_pre_hook(self.capture_consumed_gradients))
+            for _, original, indices, start, stop in self.parameters:
+                if original in mapping:
+                    master, inner, group, lo, hi = mapping[original]
+                    owned = (indices >= lo) & (indices < hi)
+                    target = torch.arange(start, stop, device=indices.device)[owned]
+                    self.bindings.append((master, inner, group, target, indices[owned] - lo))
+            for chunk in context.model:
+                chunk.start_param_sync(force_sync=True)
+            self.initial = self.snapshot()
+            self.initial_model_weights = torch.cat(
+                [
+                    parameter.detach().reshape(-1)[indices].float().cpu()
+                    for _, parameter, indices, _, _ in self.parameters
+                ]
+            )
+            expected_model_weights = torch.cat(
+                [
+                    self.initial["master"][start:stop].to(parameter.dtype).float()
+                    for _, parameter, _, start, stop in self.parameters
+                ]
+            )
+            torch.testing.assert_close(self.initial_model_weights, expected_model_weights, atol=0, rtol=0)
+            logger.info(
+                "PRECISION_VALIDATION_READY rank=%s parameters=%s samples=%s sharded=%s",
+                dist.get_rank(),
+                len(self.parameters),
+                self.raw_grads.numel(),
+                self.sharded,
+            )
+
+        def on_train_step_start(self, context):
+            self.raw_grads.zero_()
+            self.raw_used.zero_()
+            self.previous_fused.zero_()
+            self.token_count = torch.zeros((), device="cuda", dtype=torch.int64)
+            self.batches = []
+            self.consumed = None
+            self.started = time.perf_counter()
+            torch.cuda.reset_peak_memory_stats()
+
+        def forward_step(self, state, data_iterator, model, return_schedule_plan=False):
+            batch = next(data_iterator)
+            digest = hashlib.sha256()
+            for key in ("input_ids", "position_ids", "labels", "loss_mask"):
+                value = batch.get(key)
+                if value is not None:
+                    digest.update(value.detach().contiguous().reshape(-1).view(torch.uint8).cpu().numpy().tobytes())
+            vision_digest = hashlib.sha256()
+            visual = batch.get("visual_inputs")
+            if visual is not None:
+                for key, value in sorted(visual.as_model_kwargs().items()):
+                    vision_digest.update(key.encode())
+                    vision_digest.update(
+                        value.detach().contiguous().reshape(-1).view(torch.uint8).cpu().numpy().tobytes()
+                    )
+            params = batch.get("packed_seq_params")
+            self.batches.append(
+                {
+                    "sample_ids": batch.get("_global_sample_ids"),
+                    "cp": params.cp_group.size() if params else self.pg.cp.size(),
+                    "text_sha256": digest.hexdigest(),
+                    "vision_sha256": vision_digest.hexdigest(),
+                }
+            )
+            output, loss_function = vlm_step(state, iter([batch]), model, return_schedule_plan)
+            self.token_count.add_(loss_function.args[0].sum().to(torch.int64))
+            return output, loss_function
+
+        def on_before_optimizer_step(self, context):
+            self.expected_gradient = self.raw_grads.clone()
+            dist.all_reduce(self.expected_gradient, group=self.pg.dp_cp)
+            used = self.raw_used.clone()
+            dist.all_reduce(used, group=self.pg.dp_cp)
+            self.expected_present = (
+                used.cpu().bool() if self.track_grad_usage else torch.ones_like(used.cpu(), dtype=torch.bool)
+            )
+            dist.all_reduce(self.token_count, group=self.pg.dp_cp)
+            if self.token_count.item() <= 0:
+                raise RuntimeError("全局有效监督token数必须为正。")
+            self.expected_gradient.div_(self.token_count)
+            self.before = self.snapshot()
+
+        def capture_consumed_gradients(self, inner, args, kwargs):
+            if self.consumed is not None:
+                return
+            self.consumed = self.snapshot(gradients=True)
+            squared = torch.zeros((), device="cuda", dtype=torch.float64)
+            if self.sharded or self.pg.dp_cp.rank() == 0:
+                for leaf in self.leaves:
+                    for master in leaf.get_parameters():
+                        if master.grad is not None:
+                            flat = local(master.grad).detach().reshape(-1)
+                            for part in flat.split(1048576):
+                                squared.add_(part.double().square().sum())
+            dist.all_reduce(squared, group=self.pg.dp_cp)
+            self.consumed_norm = squared.sqrt().item()
+
+        def on_train_step_end(self, context):
+            if context.skipped_iter or self.consumed is None:
+                raise RuntimeError("训练跳步或未观察到真实Adam更新，不能通过验收。")
+            updated = self.snapshot()
+            norm = float(context.grad_norm)
+            clip = min(1.0, context.state.cfg.optimizer.clip_grad / (norm + 1e-6))
+            expected_grad = self.expected_gradient.cpu() * clip
+            error = (self.consumed["gradient"] - expected_grad).abs()
+            bad = error > atol + rtol * expected_grad.abs()
+            if bad.any():
+                details = []
+                for name, parameter, _, start, stop in self.parameters:
+                    local_bad = bad[start:stop]
+                    if local_bad.any():
+                        details.append(
+                            {
+                                "name": name,
+                                "max_abs_error": float(error[start:stop].max()),
+                                "zero_out_wgrad": getattr(parameter, "zero_out_wgrad", False),
+                                "fused_flag": getattr(parameter, "grad_added_to_main_grad", False),
+                                "expected": expected_grad[start:stop][local_bad].tolist()[:8],
+                                "consumed": self.consumed["gradient"][start:stop][local_bad].tolist()[:8],
+                            }
+                        )
+                path = self.output_dir / f"gradient_failure_rank{dist.get_rank()}.json"
+                path.write_text(
+                    json.dumps(
+                        {"step": context.state.train_state.step + 1, "details": details}, ensure_ascii=False, indent=2
+                    )
+                )
+                logger.error("PRECISION_GRADIENT_DIAGNOSTIC %s", details)
+            torch.testing.assert_close(self.consumed["gradient"], expected_grad, atol=atol, rtol=rtol)
+            torch.testing.assert_close(self.consumed["gradient_present"].bool(), self.expected_present, atol=0, rtol=0)
+            torch.testing.assert_close(
+                torch.tensor(self.consumed_norm), torch.tensor(norm * clip), atol=atol, rtol=rtol
+            )
+            before = self.before
+            beta1, beta2 = before["beta1"], before["beta2"]
+            m = before["exp_avg"] * beta1 + expected_grad * (1 - beta1)
+            v = before["exp_avg_sq"] * beta2 + expected_grad.square() * (1 - beta2)
+            step = before["step"] + 1
+            master = before["master"] * (1 - before["lr"] * before["weight_decay"])
+            master -= before["lr"] * (m / (1 - beta1.pow(step))) / ((v / (1 - beta2.pow(step))).sqrt() + before["eps"])
+            master = torch.where(self.expected_present, master, before["master"])
+            m = torch.where(self.expected_present, m, before["exp_avg"])
+            v = torch.where(self.expected_present, v, before["exp_avg_sq"])
+            for key, expected in {"master": master, "exp_avg": m, "exp_avg_sq": v}.items():
+                torch.testing.assert_close(updated[key], expected, atol=atol, rtol=rtol)
+            record = {
+                "step": context.state.train_state.step + 1,
+                "rank": dist.get_rank(),
+                "tokens": int(self.token_count.item()),
+                "grad_norm": norm,
+                "consumed_gradient_norm": self.consumed_norm,
+                "gradient_max_abs_error": float((self.consumed["gradient"] - expected_grad).abs().max()),
+                "host_step_seconds": time.perf_counter() - self.started,
+                "peak_allocated_bytes": torch.cuda.max_memory_allocated(),
+                "peak_reserved_bytes": torch.cuda.max_memory_reserved(),
+                "reference_passed": True,
+                "batches": self.batches,
+            }
+            self.records.append(record)
+            self.snapshots.append(
+                {"before": before, "consumed": self.consumed, "updated": updated, "expected_gradient": expected_grad}
+            )
+            logger.info(
+                "PRECISION_REFERENCE_OK rank=%s step=%s max_gradient_error=%.3e",
+                record["rank"],
+                record["step"],
+                record["gradient_max_abs_error"],
+            )
+
+        def on_train_end(self, context):
+            rank = dist.get_rank()
+            with (self.output_dir / f"reference_rank{rank}.jsonl").open("w") as stream:
+                for record in self.records:
+                    stream.write(json.dumps(record, ensure_ascii=False) + "\n")
+            torch.save(
+                {
+                    "names": [item[0] for item in self.parameters],
+                    "initial": self.initial,
+                    "initial_model_weights": self.initial_model_weights,
+                    "dtypes": [str(item[1].dtype) for item in self.parameters],
+                    "sample_counts": [item[4] - item[3] for item in self.parameters],
+                    "steps": self.snapshots,
+                },
+                self.output_dir / f"reference_rank{rank}.pt",
+            )
+            for handle in self.handles:
+                handle.remove()
+
+    return ReferenceCallback()
