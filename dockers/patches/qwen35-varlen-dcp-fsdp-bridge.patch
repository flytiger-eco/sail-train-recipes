+        validator.on_train_start(context)
+        raw_samples = []
+        for index, length in enumerate([96, 16, 32, 8]):
+            marker = pg.dp.rank() * 4 + index
+            ids = (torch.arange(length) + marker * 7) % 256
+            fields = {
+                "input_ids": ids,
+                "position_ids": torch.arange(length),
+                "labels": (ids + 1) % 256,
+                "loss_mask": torch.ones(length),
+                "attention_mask": torch.ones(length, dtype=torch.int64),
+                "marker": torch.tensor(marker),
+                "sensor_values": torch.arange(6, dtype=torch.float32).reshape(2, 3) + marker,
+            }
+            raw_samples.append(PreparedPackingSample(fields, length, SensorTextPackingAdapter.key))
+        observed_cp = set()
+        for step in range(3):
+            state.train_state.step = step
+            optimizer.zero_grad()
+            wrapped.zero_grad_buffer()
+            validator.on_train_step_start(context)
+            iterator, count, _, _ = wrap_prepared_data_iterator(
+                iter([raw_samples]),
+                config,
+                1,
+                pg,
+                fold_alignment_padding=True,
+            )
+            wrapped.module.set_model_auto_sync(False)
+            for micro in range(count):
+                if micro == count - 1:
+                    wrapped.module.set_model_auto_sync(True)
+                tokens, labels, mask, attention, positions, params, padding = get_batch_for_global_batch_packing(
+                    iterator,
+                    config,
+                    pg_collection=pg,
+                    vp_stage=None,
+                )
+                observed_cp.add(params.cp_group.size())
+                use_sensor = (step == 0 and pg.dp_cp.rank() == 0) or (step == 2 and pg.dp_cp.rank() == 1)
+                output = wrapped(
+                    tokens,
+                    positions,
+                    attention,
+                    labels=labels,
+                    packed_seq_params=params,
+                    padding_mask=padding,
+                    use_sensor=use_sensor,
+                )
+                validator.token_count.add_(mask.sum().to(torch.int64))
+                (output.float() * mask).sum().backward()
+            finalize_model_grads([wrapped], validator.token_count.clone(), pg_collection=pg)
+            validator.on_before_optimizer_step(context)
+            success, norm, _ = optimizer.step()
+            assert success
+            context.grad_norm = norm
+            validator.on_train_step_end(context)
+            for name, _, _, start, stop in validator.parameters:
+                if "never_used_bias" in name or ("sensor_bias" in name and step == 1):
+                    snapshot = validator.snapshots[-1]
+                    for key in ("master", "exp_avg", "exp_avg_sq"):
+                        torch.testing.assert_close(
+                            snapshot["updated"][key][start:stop], snapshot["before"][key][start:stop], atol=0, rtol=0
+                        )
+        assert observed_cp == {1, 2}
+        assert len(validator.parameters) > 0
+        assert all(record["reference_passed"] for record in validator.records)
+        import torch.distributed.checkpoint as distributed_checkpoint
+
+        # 真实DTensor checkpoint round-trip，包含FP32 master和完整Adam状态。
+        checkpoint = os.path.join(broadcast_path(tmp_path), "dtensor_checkpoint")
+
+        def master_name(master):
+            return wrapped.param_and_grad_buffer.param_to_name[master.orig_param]
+
+        def checkpoint_clone(master):
+            clone = master.detach().clone()
+            if hasattr(clone, "_local_tensor"):
+                from megatron.core.distributed.fsdp.src.megatron_fsdp.uneven_dtensor import (
+                    update_uneven_dtensor_chunk_metadata,
+                )
+
+                # 与原生FSDP checkpoint一致，按实际不均匀分片重新生成写入/读取元数据。
+                update_uneven_dtensor_chunk_metadata(clone)
+            return clone
+
+        def optimizer_checkpoint_state(leaf):
+            return {
+                master_name(master): {
+                    name: checkpoint_clone(value) if torch.is_tensor(value) else value
+                    for name, value in leaf.optimizer.state.get(master, {}).items()
+                }
+                for master in sorted(leaf.get_parameters(), key=master_name)
+            }
+
+        checkpoint_state = {
+            "model": wrapped.module.state_dict(),
+            "masters": [
+                {
+                    master_name(master): checkpoint_clone(master)
+                    for master in sorted(leaf.get_parameters(), key=master_name)
+                }
+                for leaf in validator.leaves
+            ],
+            "optimizers": [optimizer_checkpoint_state(leaf) for leaf in validator.leaves],
+        }
+        distributed_checkpoint.save(checkpoint_state, checkpoint_id=checkpoint)
+        saved = validator.snapshot()
+        with torch.no_grad():
+            for leaf in validator.leaves:
+                for master in leaf.get_parameters():
+                    local = master.to_local() if hasattr(master, "to_local") else master
+                    local.add_(1)
+                    for value in leaf.optimizer.state.get(master, {}).values():
+                        if torch.is_tensor(value):
+                            local_state = value.to_local() if hasattr(value, "to_local") else value
+                            local_state.add_(1)
+        restored = {
+            "model": wrapped.module.state_dict(),
+            "masters": [
+                {
+                    master_name(master): checkpoint_clone(master)
+                    for master in sorted(leaf.get_parameters(), key=master_name)
+                }
+                for leaf in validator.leaves
+            ],
+            "optimizers": [optimizer_checkpoint_state(leaf) for leaf in validator.leaves],
+        }
+        distributed_checkpoint.load(restored, checkpoint_id=checkpoint)
+        # 检查独立checkpoint的master内容，避免模型权重复制覆盖FP32工作副本。
+        loaded_master_values = {}
+        for leaf, masters in zip(validator.leaves, restored["masters"], strict=True):
+            for master in leaf.get_parameters():
+                loaded = masters[master_name(master)]
+                loaded_master_values[id(master)] = loaded.to_local() if hasattr(loaded, "to_local") else loaded
+        loaded_samples = torch.zeros_like(validator.raw_grads)
+        for master, _, _, target, indices in validator.bindings:
+            loaded_samples[target] = loaded_master_values[id(master)].reshape(-1)[indices]
+        torch.distributed.all_reduce(loaded_samples, group=pg.dp_cp)
+        torch.testing.assert_close(
+            loaded_samples.cpu(), saved["master"], atol=0, rtol=0, msg="DCP独立master数据未正确保存/加载"
+        )
+        wrapped.module.load_state_dict(restored["model"])
+        for leaf, state_dict, masters in zip(
+            validator.leaves, restored["optimizers"], restored["masters"], strict=True
+        ):
+            with torch.no_grad():
+                for master in leaf.get_parameters():
+                    loaded_state = state_dict[master_name(master)]
+                    for name, value in loaded_state.items():
+                        current = leaf.optimizer.state[master][name]
+                        if torch.is_tensor(value):
+                            current_local = current.to_local() if hasattr(current, "to_local") else current
+                            value_local = value.to_local() if hasattr(value, "to_local") else value
+                            current_local.copy_(value_local)
+                        else:
+                            leaf.optimizer.state[master][name] = value
+                    loaded = masters[master_name(master)]
+                    local_master = master.to_local() if hasattr(master, "to_local") else master
+                    local_loaded = loaded.to_local() if hasattr(loaded, "to_local") else loaded
+                    local_master.copy_(local_loaded)
+        reloaded = validator.snapshot()
+        for key in ("master", "exp_avg", "exp_avg_sq", "step"):
+            torch.testing.assert_close(
+                reloaded[key], saved[key], atol=0, rtol=0, msg=f"DTensor checkpoint {key}未精确恢复"
+            )
+        validator.on_train_end(context)
+    finally:
+        parallel_state.destroy_model_parallel()
