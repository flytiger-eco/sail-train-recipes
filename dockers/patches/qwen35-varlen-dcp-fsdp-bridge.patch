+class TextChatGlobalPackingAdapter:
+    """文本SFT的prepared sample合同，不依赖任何语言模型家族。"""
+
+    key = "text_chat"
+    batch_format = "gpt"
+    collate = staticmethod(text_chat_collate_fn)
+
+    def prepare(
+        self, example: Mapping[str, Any], processor: Any, *, collate_impl: Callable | None = None
+    ) -> PreparedPackingSample:
+        """复用现有文本预处理和监督mask，保留配置的loss/分隔符语义。"""
+        batch = (collate_impl or self.collate)([example], processor, pad_to_multiple_of=1)
+        fields = {
+            key: batch[key].reshape(-1).contiguous()
+            for key in ("input_ids", "position_ids", "labels", "loss_mask", "attention_mask")
+        }
+        return PreparedPackingSample(fields, fields["input_ids"].numel(), self.key)
+
+    def pack(
+        self, samples: Sequence[PreparedPackingSample], *, pad_to_multiple_of: int, device: torch.device
+    ) -> dict[str, Any]:
+        """输出完整THD文本，由原生gpt_step在融合后/计算前执行CP切分。"""
+        rows = [dict(sample.tensors) for sample in samples]
+        if not rows:
+            ids = torch.zeros(pad_to_multiple_of, dtype=torch.int64, device=device)
+            rows = [
+                {
+                    "input_ids": ids,
+                    "position_ids": ids.clone(),
+                    "attention_mask": torch.ones_like(ids),
+                    "labels": torch.full_like(ids, IGNORE_INDEX),
+                    "loss_mask": torch.zeros_like(ids, dtype=torch.float32),
+                }
+            ]
+        batch = build_mcore_thd_sequence_batch_from_rows(
+            rows,
+            sequence_length=None,
+            pad_token_id=0,
+            ignore_index=IGNORE_INDEX,
+            pad_to_multiple_of=pad_to_multiple_of,
+        )
+        batch["tokens"] = batch["input_ids"].reshape(-1)
+        for key in ("labels", "loss_mask", "position_ids"):
+            batch[key] = batch[key].reshape(-1)
+        return batch
