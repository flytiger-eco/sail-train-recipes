diff --git a/tests/unit_tests/training/test_payload_packing.py b/tests/unit_tests/training/test_payload_packing.py
new file mode 100644
index 000000000..1e1250ecc
--- /dev/null
+++ b/tests/unit_tests/training/test_payload_packing.py
@@ -0,0 +1,159 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from megatron.bridge.data.packing.global_batch import PreparedPackingSample
+from megatron.bridge.models.qwen_vl.data.collate_fn import QwenVLGlobalPackingAdapter
+from megatron.bridge.training.payload_packing import describe_sample, route_samples
+
+
+pytestmark = pytest.mark.unit
+
+
+def sample(index):
+    return PreparedPackingSample(
+        {
+            "custom_tokens": torch.arange(index + 2),
+            "custom_sensor": torch.arange((index + 1) * 6, dtype=torch.float32).reshape(index + 1, 2, 3),
+            "scalar_metadata": torch.tensor(index, dtype=torch.int32),
+            "empty_payload": torch.zeros(0, 3, dtype=torch.bfloat16),
+        },
+        index + 2,
+        "non_qwen_sensor",
+    )
+
+
+def test_descriptor_has_no_tensor_and_preserves_arbitrary_shapes():
+    original = sample(2)
+    descriptor = describe_sample(original)
+    assert descriptor["length"] == 4
+    assert descriptor["adapter"] == "non_qwen_sensor"
+    assert descriptor["fields"]["custom_sensor"] == ((3, 2, 3), "torch.float32")
+    assert all(not isinstance(value, torch.Tensor) for value in descriptor.values())
+    changed = sample(2)
+    changed.tensors["custom_sensor"][0, 0, 0] += 1
+    assert describe_sample(changed)["sha256"] != descriptor["sha256"]
+
+
+def test_cpu_tensor_route_preserves_missing_fields_and_shapes(monkeypatch):
+    samples = [sample(index) for index in range(3)]
+    samples[1].tensors.pop("custom_sensor")
+    descriptors = [describe_sample(item) for item in samples]
+    pg = SimpleNamespace(dp_cp=SimpleNamespace(rank=lambda: 0), dp=SimpleNamespace(rank=lambda: 0))
+    monkeypatch.setattr(torch.distributed, "get_process_group_ranks", lambda group: [0])
+    calls = []
+
+    def exchange(output, input, *, output_split_sizes, input_split_sizes, group):
+        assert output_split_sizes == input_split_sizes
+        output.copy_(input)
+        calls.append(input.dtype)
+
+    monkeypatch.setattr(torch.distributed, "all_to_all_single", exchange)
+    result = route_samples(samples, descriptors, [0, 3], [[[2, 0, 1]]], pg_collection=pg, device=torch.device("cpu"))
+    assert set(result) == {0, 1, 2}
+    for index, original in enumerate(samples):
+        assert set(result[index].tensors) == set(original.tensors)
+        for key, value in original.tensors.items():
+            torch.testing.assert_close(result[index].tensors[key], value, rtol=0, atol=0)
+    assert torch.bfloat16 in calls
+
+
+def test_route_rejects_mixed_field_dtypes_before_collective(monkeypatch):
+    samples = [sample(0), sample(1)]
+    samples[1].tensors["custom_sensor"] = samples[1].tensors["custom_sensor"].to(torch.float64)
+    descriptors = [describe_sample(item) for item in samples]
+    pg = SimpleNamespace(dp_cp=SimpleNamespace(rank=lambda: 0), dp=SimpleNamespace(rank=lambda: 0))
+    monkeypatch.setattr(torch.distributed, "get_process_group_ranks", lambda group: [0])
+    with pytest.raises(ValueError, match="dtype"):
+        route_samples(samples, descriptors, [0, 2], [[[0, 1]]], pg_collection=pg, device=torch.device("cpu"))
+
+
+@pytest.mark.parametrize("length", [0, -1])
+def test_sample_rejects_nonpositive_length(length):
+    with pytest.raises(ValueError):
+        PreparedPackingSample({"x": torch.ones(1)}, length, "model")
+
+
+def test_sample_rejects_nontensor_payload():
+    with pytest.raises(TypeError):
+        PreparedPackingSample({"x": "not a tensor"}, 1, "model")
+
+
+def test_qwen_adapter_empty_pack_has_no_fake_image():
+    batch = QwenVLGlobalPackingAdapter().pack([], pad_to_multiple_of=8, device=torch.device("cpu"))
+    assert batch["input_ids"].shape == (1, 8)
+    assert batch["loss_mask"].sum() == 0
+    assert batch["visual_inputs"].as_model_kwargs() == {}
+
+
+def test_qwen_adapter_preserves_sample_and_media_order():
+    samples = []
+    for index, length in enumerate([3, 5]):
+        ids = torch.arange(length) + index * 100
+        samples.append(
+            PreparedPackingSample(
+                {
+                    "input_ids": ids,
+                    "position_ids": torch.arange(length),
+                    "attention_mask": torch.ones(length, dtype=torch.int64),
+                    "labels": ids + 1,
+                    "loss_mask": torch.ones(length),
+                    "pixel_values": torch.full((index + 1, 4), float(index)),
+                    "image_grid_thw": torch.tensor([[1, 2, 2]] * (index + 1)),
+                },
+                length,
+                "qwen_vl",
+            )
+        )
+    batch = QwenVLGlobalPackingAdapter().pack(samples, pad_to_multiple_of=4, device=torch.device("cpu"))
+    torch.testing.assert_close(batch["input_ids"][0, :3], samples[0].tensors["input_ids"])
+    torch.testing.assert_close(batch["input_ids"][0, 4:9], samples[1].tensors["input_ids"])
+    assert batch["loss_mask"].sum() == 8
+    assert batch["visual_inputs"].pixel_values[:, 0].tolist() == [0, 1, 1]
+    assert batch["cu_seqlens_q_padded"].tolist() == [0, 4, 12]
+
+
+def test_prepared_payload_cannot_capture_a_training_graph():
+    with pytest.raises(ValueError, match="训练图"):
+        PreparedPackingSample({"features": torch.ones(4, requires_grad=True)}, 4, "encoder")
+
+
+def test_model_forward_capabilities_are_explicit():
+    from megatron.bridge.models.gpt_provider import GPTModelProvider
+    from megatron.bridge.models.qwen_vl.qwen3_vl_provider import Qwen3VLModelProvider
+    from megatron.bridge.models.qwen_vl.qwen25_vl_provider import Qwen25VLModelProvider
+    from megatron.bridge.models.qwen_vl.qwen35_vl_provider import Qwen35VLModelProvider
+
+    assert GPTModelProvider.global_batch_packing_forward_kind == "gpt"
+    assert Qwen3VLModelProvider.global_batch_packing_forward_kind == "vlm"
+    assert Qwen35VLModelProvider.global_batch_packing_forward_kind == "vlm"
+    assert Qwen25VLModelProvider.global_batch_packing_forward_kind != "vlm"
+
+
+def test_builder_rejects_model_adapter_contract_mismatch():
+    from megatron.bridge.data.builders.direct_hf_sft import DirectHFSFTDatasetConfig, build_direct_hf_sft_split
+    from megatron.bridge.data.sources.hf import HFDatasetSourceConfig
+
+    config = DirectHFSFTDatasetConfig(
+        seq_length=512,
+        source=HFDatasetSourceConfig(path_or_dataset="json"),
+        enable_global_batch_packing=True,
+        global_batch_packing_forward_kind="gpt",
+    )
+    processor = type("Qwen3VLProcessor", (), {})()
+    examples = [
+        {
+            "conversation": [
+                {
+                    "role": "user",
+                    "content": [
+                        {"type": "image", "path": "not-read-by-this-test.png"},
+                        {"type": "text", "text": "x"},
+                    ],
+                }
+            ]
+        }
+    ]
+    with pytest.raises(ValueError, match="forward合同不匹配"):
+        build_direct_hf_sft_split(config, config.source, 1, processor, examples=examples)
