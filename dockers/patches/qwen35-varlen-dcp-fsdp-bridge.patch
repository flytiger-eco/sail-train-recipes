+def register_model_packing_adapter(
+    key: str, *, module_name: str, symbol_name: str, processor_types: tuple[str, ...] = ()
+) -> None:
+    """注册模型自有的packing能力，不修改已有collator或全局训练函数。"""
+    if key in _MODEL_PACKING_SPECS or any(name in _PROCESSOR_PACKING_KEYS for name in processor_types):
+        raise ValueError(f"packing adapter或processor已经注册：{key}")
+    _MODEL_PACKING_SPECS[key] = _ModelCollateSpec(module_name, symbol_name)
+    for name in processor_types:
+        _PROCESSOR_PACKING_KEYS[name] = key
+
+
+@lru_cache(maxsize=None)
+def resolve_model_packing_adapter(key: str) -> GlobalPackingAdapter:
+    """按processor类型或adapter key延迟加载原生global packing能力。"""
+    resolved = _PROCESSOR_PACKING_KEYS.get(key, key)
+    spec = _MODEL_PACKING_SPECS.get(resolved)
+    if spec is None:
+        raise ValueError(f"模型/processor {key!r}尚未注册global-batch packing能力。")
+    adapter = getattr(import_module(spec.module_name), spec.symbol_name)()
+    if adapter.key != resolved:
+        raise ValueError("packing adapter声明的key与注册key不一致。")
+    return adapter
