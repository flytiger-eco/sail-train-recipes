# 构建上下文：ppu-train-recipes。保留已验收Core基线，dev PR独立移植。
# docker build -f dockers/Dockerfile.Qwen35_varlen_dcp_fsdp -t qwen35-varlen-dcp-fsdp .
ARG GIT_PROXY=""
ARG GIT_SSL_VERIFY="true"

FROM pkg.flytiger-eco.com/docker_release/llm:sdk2.2.0-pytorch2.10.0-ubuntu24.04-cuda13.0-py312-20261008

ARG GIT_PROXY
ARG GIT_SSL_VERIFY
ARG MEGATRON_BRIDGE_COMMIT=7bd66ba0001d39f04523c7317d61d342ff9dddd0
ARG MEGATRON_LM_COMMIT=8817e0fd0a818b657bc80e8499caff408c3495ec

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple \
    PIP_EXTRA_INDEX_URL=https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple

WORKDIR /workspace

# 仅忽略基础镜像的Git重定向配置，不修改全局Git配置。
RUN GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    git -c http.proxy="$GIT_PROXY" -c http.sslVerify="$GIT_SSL_VERIFY" \
        clone https://github.com/NVIDIA-NeMo/Megatron-Bridge.git /workspace/Megatron-Bridge

WORKDIR /workspace/Megatron-Bridge

COPY dockers/patches/qwen35_varlen.patch /tmp/qwen35_varlen.patch
COPY dockers/patches/qwen35-varlen-dcp-fsdp-bridge.patch /tmp/qwen35-dcp-bridge.patch
COPY dockers/patches/qwen35-varlen-dcp-fsdp-core.patch /tmp/qwen35-dcp-core.patch

RUN git checkout "$MEGATRON_BRIDGE_COMMIT" \
    && git apply --check /tmp/qwen35_varlen.patch \
    && git apply /tmp/qwen35_varlen.patch \
    && git apply --check /tmp/qwen35-dcp-bridge.patch \
    && git apply /tmp/qwen35-dcp-bridge.patch \
    && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        git -c http.proxy="$GIT_PROXY" -c http.sslVerify="$GIT_SSL_VERIFY" \
        submodule update --init --depth 1 --progress \
    && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        git -C 3rdparty/Megatron-LM -c http.proxy="$GIT_PROXY" -c http.sslVerify="$GIT_SSL_VERIFY" \
        fetch --depth 1 origin "$MEGATRON_LM_COMMIT" \
    && git -C 3rdparty/Megatron-LM checkout "$MEGATRON_LM_COMMIT" \
    && git -C 3rdparty/Megatron-LM apply --check /tmp/qwen35-dcp-core.patch \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-dcp-core.patch \
    && test -f 3rdparty/Megatron-LM/megatron/core/__init__.py

# Keep the PPU torch and compiled extension stack from the base image.
# Megatron-LM and Megatron-Bridge are installed with --no-deps so pip cannot
# replace the PPU torch/TransformerEngine/flash-attn wheels. Python-level
# dependencies are installed explicitly below, pinned to the versions in the
# Megatron-Bridge uv.lock where they matter.
RUN python -c "import torch; print('base torch', torch.__version__)" \
    && python -c "import torch; v=torch.__version__.split('+')[0]; open('/tmp/ppu-constraints.txt','w').write(f'torch=={v}\nnumpy<2\n')"

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -c /tmp/ppu-constraints.txt \
        "transformers==5.20.1" \
        "datasets==5.1.0" \
        "pyarrow==25.0.1" \
        "megatron-energon==7.4.1" \
        "peft==0.21.0" \
        "diffusers==0.38.0" \
        "huggingface_hub>=1.0" \
        "qwen-vl-utils==0.0.14" \
        modelscope \
        nvidia-modelopt==0.42.0 \
        nvidia-resiliency-ext \
        einops accelerate omegaconf "hydra-core>=1.3.4,<1.4" \
        "tensorboard>=2.19.0" rich \
        six "regex>=2024.11.6" pyyaml "tqdm>=4.67.1" \
        typing-extensions fsspec pybind11

RUN python -m pip install --no-deps --no-build-isolation \
        flash_attn_3==3.0.0 \
        -i https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple

RUN python -m pip install --no-deps --no-build-isolation -c /tmp/ppu-constraints.txt \
        flash_linear_attention==0.4.1+v0.1.0.ppu2.2.0 \
        fla-core==0.4.1+v0.1.0.ppu2.2.0 \
        -i https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple

RUN python -m pip install -e ./3rdparty/Megatron-LM --no-deps \
    && python -m pip install -e . --no-deps --no-build-isolation

ARG CAUSAL_CONV1D_COMMIT=cd81f0413cad2fc1e6f17e785ac39f59aae690cd

# Force the PPU toolchain build instead of downloading NVIDIA prebuilt wheels.
RUN GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    git -c http.proxy="$GIT_PROXY" -c http.sslVerify="$GIT_SSL_VERIFY" \
        clone https://github.com/Dao-AILab/causal-conv1d.git /workspace/causal-conv1d \
    && git -C /workspace/causal-conv1d checkout "$CAUSAL_CONV1D_COMMIT" \
    && CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS=4 \
        python -m pip install --no-build-isolation --no-deps /workspace/causal-conv1d \
    && python -c "import causal_conv1d; from causal_conv1d import causal_conv1d_fn; from causal_conv1d.cpp_functions import causal_conv1d_bwd_function; print('causal-conv1d', causal_conv1d.__version__, 'imports ok')"

# Import check: avoid importing megatron.bridge.recipes here because the
# diffusion recipes pull diffusers/xformers and require a visible accelerator
# at import time. The full import is verified after the container starts.
RUN python -c "import megatron.core, megatron.bridge, modelopt, transformers, datasets, peft; import megatron.bridge.training.checkpointing; print('imports ok')"

# 容器内原生源码路径，无需挂载宿主机探索源码。
ENV MEGATRON_CORE_ROOT=/workspace/Megatron-Bridge/3rdparty/Megatron-LM \
    MEGATRON_BRIDGE_ROOT=/workspace/Megatron-Bridge \
    PYTHONPATH=/workspace/Megatron-Bridge:/workspace/Megatron-Bridge/src:/workspace/Megatron-Bridge/3rdparty/Megatron-LM
# 审计需要pytest；不解析或替换基础镜像中的torch/TE/FA3。
RUN python -m pip install --no-deps pytest==7.2.0 \
    && python -c "from megatron.core.datasets.data_schedule import build_sequence_packing_plan; from megatron.core.distributed import DistributedDataParallelConfig; from megatron.bridge.data.packing.global_batch import PreparedPackingSample; assert hasattr(DistributedDataParallelConfig, 'megatron_fsdp_track_grad_usage'); print('DCP/FSDP接口检查通过')"

CMD ["/bin/bash"]
