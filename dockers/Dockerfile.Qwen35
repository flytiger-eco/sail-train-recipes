# PPU M890 image for the Qwen3.5-VL recipes in best_practice/qwen3.5. No
# Megatron-Bridge: training runs examples/multimodal_dev/pretrain_multimodal.py
# from the Megatron-LM-for-sail checkout below.
#
# Build (add --build-arg GIT_PROXY=... if GitHub is not directly reachable):
#   docker build -f dockers/Dockerfile.Qwen35 -t ppu-qwen35:M890 .
ARG GIT_PROXY=""
ARG GIT_SSL_VERIFY="true"

FROM pkg.flytiger-eco.com/docker_release/llm:sdk2.2.0-pytorch2.10.0-ubuntu24.04-cuda13.0-py312-20261008

# Re-declare build args so they are available in this stage.
ARG GIT_PROXY
ARG GIT_SSL_VERIFY

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

WORKDIR /workspace

# Drop the base image's github.com rewrite and apply the caller's proxy settings.
RUN rm -f /root/.gitconfig && \
    if [ -n "$GIT_PROXY" ]; then \
        git config --global http.proxy "$GIT_PROXY" && \
        git config --global https.proxy "$GIT_PROXY"; \
    fi && \
    git config --global http.sslVerify "$GIT_SSL_VERIFY" && \
    git config --global http.version HTTP/1.1 && \
    git config --global http.postBuffer 524288000 && \
    git config --global core.compression 0 && \
    git clone https://github.com/flytiger-eco/Megatron-LM-for-sail.git /workspace/Megatron-LM-for-sail

WORKDIR /workspace/Megatron-LM-for-sail

# Recipes are validated against this dev commit; override MEGATRON_REF to move.
ARG MEGATRON_REF=6ee761e1fe2be1f6058f0612ce7e22c19d9839ff

# Adds the mock-image geometry, text-only, vision-CP and FSDP-exit flags the
# recipes pass; the greps fail the build if the patch stops landing them.
COPY dockers/patches/qwen35-multimodal.patch /tmp/qwen35-multimodal.patch
COPY dockers/patches/qwen35-dense-swiglu.patch /tmp/qwen35-dense-swiglu.patch
COPY dockers/patches/qwen35-fla-ce.patch /tmp/qwen35-fla-ce.patch
COPY dockers/patches/qwen35-dense-vision.patch /tmp/qwen35-dense-vision.patch
COPY dockers/patches/qwen35-ppu-tp-policy.patch /tmp/qwen35-ppu-tp-policy.patch
RUN git checkout "$MEGATRON_REF" \
    && git apply /tmp/qwen35-multimodal.patch \
    && git apply /tmp/qwen35-dense-swiglu.patch \
    && git apply /tmp/qwen35-fla-ce.patch \
    && git apply /tmp/qwen35-dense-vision.patch \
    && git apply /tmp/qwen35-ppu-tp-policy.patch \
    && rm /tmp/qwen35-multimodal.patch /tmp/qwen35-dense-swiglu.patch /tmp/qwen35-fla-ce.patch /tmp/qwen35-dense-vision.patch /tmp/qwen35-ppu-tp-policy.patch \
    && grep -q -- '--image-size-w' examples/multimodal_dev/arguments.py \
    && grep -q -- '--enable-vision-cp' examples/multimodal_dev/arguments.py

# torch comes from the base image, so install the runtime deps explicitly and
# the checkout with --no-deps. pyarrow is pinned for numpy 1.26.
RUN python -m pip install --upgrade pip \
    && python -m pip install \
        transformers==5.3.0 \
        huggingface_hub==1.13.0 \
        datasets==4.8.5 \
        pyarrow==21.0.0 \
        nvidia-resiliency-ext \
        omegaconf \
        "fsspec>=2024.3.0" \
        pybind11 \
        setuptools \
        wheel \
    && python -m pip install -e ./ --no-deps --no-build-isolation

# Replace the base image's flash-linear-attention with the for-sail v0.5.2 fork
# (GDN context-parallel kernels). FLA_REF tracks the branch head; pin it to get a
# reproducible build.
ARG FLA_REF="v0.5.2"
RUN python -m pip uninstall -y flash-linear-attention \
    && SITE=$(python -c 'import site; print(site.getsitepackages()[0])') \
    && rm -rf "$SITE"/fla \
    && git init -q /tmp/fla-src \
    && git -C /tmp/fla-src remote add origin https://github.com/t-head/flash-linear-attention-for-sail.git \
    && git -C /tmp/fla-src fetch -q --depth 1 origin "$FLA_REF" \
    && git -C /tmp/fla-src checkout -q FETCH_HEAD \
    && python -m pip install --no-build-isolation /tmp/fla-src \
    && rm -rf /tmp/fla-src \
    && python -c "import fla, os; p = os.path.dirname(fla.__file__); import fla.ops.gated_delta_rule; print('fla', fla.__version__, 'ok at', p)"

# Build causal-conv1d from source: the patch keeps only sm_89 (the stock
# multi-arch gencode is rejected by the PPU nvcc), and FORCE_BUILD skips the
# un-timed GitHub release lookup that can hang the build.
COPY dockers/patches/causal-conv1d-sm89.patch /tmp/causal-conv1d-sm89.patch
RUN export CAUSAL_CONV1D_FORCE_BUILD=TRUE \
    && git clone https://github.com/Dao-AILab/causal-conv1d.git /tmp/causal-conv1d \
    && git -C /tmp/causal-conv1d checkout cd81f0413cad2fc1e6f17e785ac39f59aae690cd \
    && git -C /tmp/causal-conv1d apply /tmp/causal-conv1d-sm89.patch \
    && python -m pip install --no-build-isolation /tmp/causal-conv1d \
    && rm -rf /tmp/causal-conv1d /tmp/causal-conv1d-sm89.patch \
    && python -c "import causal_conv1d, causal_conv1d_cuda; print('causal_conv1d ok')"

# TransformerEngine 2.18 from the for-sail fork, built against the image's torch
# (the index has no torch 2.10 wheel). numpy is pinned to 1.26 because TE's deps
# otherwise resolve numpy 2.
# Pin the revision used by the dense parity measurements. A moving branch can
# silently change dependencies between a baseline and a candidate image.
ARG TE_REF="a11ff3cd314b793e4c527dbc27c567ae7f7ac46f"
RUN python -m pip uninstall -y transformer_engine \
    && python -m pip install \
        "numpy==1.26.4" \
        packaging==24.2 \
        pybind11==3.1.0 \
        pydantic \
        einops \
        onnx \
        onnxscript \
        nvdlfw-inspect \
        "nvidia-cudnn-frontend>=1.25.0" \
    && git init /tmp/TransformerEngine \
    && git -C /tmp/TransformerEngine remote add origin https://github.com/flytiger-eco/TransformerEngine-for-sail.git \
    && git -C /tmp/TransformerEngine fetch --depth 1 origin "$TE_REF" \
    && git -C /tmp/TransformerEngine checkout --detach FETCH_HEAD \
    && git -C /tmp/TransformerEngine submodule update --init --recursive --depth 1 \
    && bash -c 'set -eo pipefail; source /usr/local/pccl/envsetup.sh; export CPATH="${NCCL_HOME}/include${CPATH:+:$CPATH}"; cd /tmp/TransformerEngine; export NVTE_FRAMEWORK=pytorch NVTE_WITH_NCCL_EP=0 NVTE_CUDA_ARCHS=89 MAX_JOBS=32; python -m pip install -v --no-build-isolation --no-deps .' \
    && rm -rf /tmp/TransformerEngine \
    && python -c "import numpy; assert numpy.__version__.startswith('1.26.'), numpy.__version__; import torch, transformer_engine, transformer_engine.pytorch, importlib.metadata as m; print('te', m.version('transformer-engine'), transformer_engine.__version__, 'numpy', numpy.__version__)"

# flash_attn_3 3.0.0 so TE routes to FA3; remove the 2.8.2 leftovers that would
# otherwise shadow the new package.
ARG FA3_REF="3.0.0+v0.2.0.ppu2.2.0"
RUN SITE=$(python -c 'import site; print(site.getsitepackages()[0])') \
    && python -m pip uninstall -y flash_attn_3 \
    && rm -rf "$SITE/flash_attn_3" "$SITE/flash_attn_interface.py" \
    && python -m pip install --no-deps --no-build-isolation \
        -i https://pkg.flytiger-eco.com/artifactory/api/pypi/pypi_index/simple \
        "flash_attn_3==${FA3_REF}" \
    && python -c "import importlib.metadata as m, flash_attn_interface as f; from packaging.version import Version; v = m.version('flash_attn_3'); assert Version(v).major == 3, v; assert hasattr(f, 'flash_attn_varlen_func'); print('flash_attn_3', v, 'ok')" \
    && python -c "from transformer_engine.pytorch.attention.dot_product_attention.utils import FlashAttentionUtils as F; assert F.v3_is_installed and F.fa3_version.major == 3, (F.v3_is_installed, F.fa3_version); print('te selects flash-attn', F.fa3_version)"

# The patched checkout and its full stack must import, without Megatron-Bridge.
RUN python -c "import megatron, megatron.core, transformer_engine, fla, causal_conv1d, flash_attn_interface; print('megatron stack import ok')" \
    && python -c "import importlib.util as u; assert u.find_spec('megatron.bridge') is None, 'Megatron-Bridge must not be installed in this image'; print('megatron-bridge absent')"

CMD ["/bin/bash"]
