# Build arguments (optional): pass these if your host needs a proxy to reach GitHub.
# Example:
#   docker build --network host \
#     --build-arg GIT_PROXY=http://127.0.0.1:18888 \
#     -f dockers/Dockerfile.Qwen35 -t ppu-qwen35:M890 .
ARG GIT_PROXY=""
ARG GIT_SSL_VERIFY="true"

FROM pkg.flytiger-eco.com/docker_release/llm:sdk2.2.0-pytorch2.10.0-ubuntu24.04-cuda13.0-py312-20261008

# M890 variant: upstream Megatron-Bridge at c9ab9cc plus changes
# (applied as a patch below).

# Re-declare build args so they are available in this stage.
ARG GIT_PROXY
ARG GIT_SSL_VERIFY

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

WORKDIR /workspace

# The base image rewrites github.com to an unreachable mirror that is not
# reachable here. Remove its gitconfig and apply the caller's proxy settings.
RUN rm -f /root/.gitconfig && \
    if [ -n "$GIT_PROXY" ]; then \
        git config --global http.proxy "$GIT_PROXY" && \
        git config --global https.proxy "$GIT_PROXY"; \
    fi && \
    git config --global http.sslVerify "$GIT_SSL_VERIFY" && \
    git config --global http.version HTTP/1.1 && \
    git config --global http.postBuffer 524288000 && \
    git config --global core.compression 0 && \
    git clone https://github.com/NVIDIA-NeMo/Megatron-Bridge.git /workspace/Megatron-Bridge

WORKDIR /workspace/Megatron-Bridge

COPY dockers/patches/qwen35.patch /tmp/qwen35.patch
COPY dockers/patches/qwen35-gdn-chunkwise-cp.patch /tmp/qwen35-gdn-chunkwise-cp.patch
COPY dockers/patches/qwen35-gdn-fused-pre-gdr.patch /tmp/qwen35-gdn-fused-pre-gdr.patch
COPY dockers/patches/qwen35-moe-topk-reconstruct.patch /tmp/qwen35-moe-topk-reconstruct.patch
COPY dockers/patches/qwen35-swiglu-cudac.patch /tmp/qwen35-swiglu-cudac.patch
COPY dockers/patches/qwen35-mimo-ep-overlap.patch /tmp/qwen35-mimo-ep-overlap.patch
COPY dockers/patches/qwen35-mimo-ep-overlap-megatron.patch /tmp/qwen35-mimo-ep-overlap-megatron.patch

# qwen35.patch updates the Megatron-LM submodule pointer (930bb6f6 -> de6305c0).
# qwen35-gdn-chunkwise-cp.patch is the single combined Megatron-LM backport: it ports
# upstream dev's GDN chunkwise context-parallel path verbatim (ssm/gated_delta_net package,
# context_parallel_layout/, ssm/utils.py, packed_seq_params + TransformerConfig fields and the
# matching TE kept_packed_seq_params discards) AND folds in the head-pack all-to-all
# optimization on the headwise path.
# qwen35-gdn-fused-pre-gdr.patch adds the single file the combined patch's gdn.py dispatch
# expects but does not carry: megatron/core/fusions/fused_pre_gated_delta_rule.py (verbatim from
# dev commit b001daca9, the same commit the backported gdn.py came from). It is a pure new-file
# addition, so it applies on the de6305c0+combined tree without extra objects. This enables the
# gdn_pre_gated_delta_rule_fusion path (off by default), which additionally requires the
# causal-conv1d C++ backend (causal_conv1d.cpp_functions.causal_conv1d_bwd_function). That
# backend is built from source below at Dao-AILab/causal-conv1d main (1.7.0, commit cd81f04)
# with a single-arch sm_89 gencode: the stock multi-arch gencode list is rejected by the PPU
# nvcc. GDN itself does not need it -- GDN uses the Triton causal_conv1d from
# flash-linear-attention -- and gdn.py asserts the backend is importable when the fusion is on.
# qwen35-moe-topk-reconstruct.patch and qwen35-swiglu-cudac.patch are the two MoE
# optimizations that live inside Megatron-LM. Both are off by default and switched on
# at runtime:
#   MEGATRON_MOE_TOPK_RECONSTRUCT=chain|triton  (topk patch: rebuild the topk indices
#       from the routing map in fusions/fused_routing_map_to_indices.py instead of
#       re-running torch.topk over all expert probabilities)
#   MEGATRON_SWIGLU_USE_CUDAC=1  (swiglu patch: fused_bias_swiglu.py rebinds
#       weighted_swiglu/weighted_swiglu_back to the CUDA C extension in
#       fusions/csrc/swiglu.{cu,cpp}; fused_bias_swiglu_cudac.py JIT-builds it with
#       nvcc on first use, pinned to -gencode arch=compute_89,code=sm_89)
# qwen35-mimo-ep-overlap.patch (+ its Megatron-LM half) adds the MIMO schedule-plan
# path that lets DeepEP dispatch/combine overlap MoE compute: MimoModel gains
# build_schedule_plan(), the MIMO forward step can return a schedule plan, and
# combined_1f1b accepts a COLOCATED MimoModel with language CP=PP=TP=1. It is
# enabled per run by --enable-ep-overlap (pure-text rows only).
# Use a shallow submodule clone plus retries to avoid long/incomplete downloads.
RUN git checkout c9ab9cc124a055392927eee3b2220bc0049caa18 \
    && git apply /tmp/qwen35.patch \
    && rm /tmp/qwen35.patch \
    && git apply /tmp/qwen35-mimo-ep-overlap.patch \
    && rm /tmp/qwen35-mimo-ep-overlap.patch \
    && (for i in 1 2 3; do \
          git submodule update --init --depth 1 --progress && break; \
          echo "[retry $i/3] submodule update failed, retrying..."; \
          rm -rf 3rdparty/Megatron-LM; \
          sleep 15; \
        done) \
    && git -C 3rdparty/Megatron-LM fetch origin de6305c0ae1e78e04929b7b6d55910ae71046ae8 \
    && git -C 3rdparty/Megatron-LM checkout de6305c0ae1e78e04929b7b6d55910ae71046ae8 \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-gdn-chunkwise-cp.patch \
    && rm /tmp/qwen35-gdn-chunkwise-cp.patch \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-gdn-fused-pre-gdr.patch \
    && rm /tmp/qwen35-gdn-fused-pre-gdr.patch \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-moe-topk-reconstruct.patch \
    && rm /tmp/qwen35-moe-topk-reconstruct.patch \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-swiglu-cudac.patch \
    && rm /tmp/qwen35-swiglu-cudac.patch \
    && git -C 3rdparty/Megatron-LM apply /tmp/qwen35-mimo-ep-overlap-megatron.patch \
    && rm /tmp/qwen35-mimo-ep-overlap-megatron.patch

# Pin pyarrow: newer pyarrow hard-requires numpy>=2 at import, but the base
# image ships numpy 1.26 (local empirical check: pyarrow 21 imports fine on 1.26).
#
# --no-build-isolation on the Megatron-Bridge editable install: its
# pyproject build-system.requires contains "torch", so with isolation pip
# silently downloads torch + the full nvidia-* closure (several GB) into a
# throwaway env. The base image already ships torch (the PPU build) and the
# build deps are installed explicitly below instead.
#
RUN python -m pip install --upgrade pip \
    && python -m pip install \
        nvidia-modelopt==0.42.0 \
        transformers==5.3.0 \
        peft==0.19.1 \
        diffusers==0.38.0 \
        huggingface_hub==1.13.0 \
        datasets==4.8.5 \
        pyarrow==21.0.0 \
        megatron-energon==6.0.1 \
        nvidia-resiliency-ext \
        qwen-vl-utils==0.0.14 \
        omegaconf \
        hydra-core \
        "fsspec>=2024.3.0" \
        pybind11 \
        setuptools \
        wheel \
    && python -m pip install -e ./3rdparty/Megatron-LM \
    && python -m pip install -e . --no-deps --no-build-isolation \
    && python -c "import megatron.bridge, megatron.energon, transformers, peft, diffusers, huggingface_hub, datasets, omegaconf, hydra, fsspec; print('megatron-bridge + core deps import ok')"

# flash-linear-attention is replaced in place: uninstall the base image's 0.4.1 (and any
# leftover fla/ tree, so nothing shadows the new package), then install the for-sail fork
# at a fixed commit with the GDN performance patch set applied. The patch carries
# t-head/flash-linear-attention-for-sail PR #19 (nilpotent-doubling kkt_solve inversion,
# in-kernel A zero blocks, fused fwd_h+chunk_o, pinned ZW_M890P autotune configs) and
# PR #18 (context-parallel pre-process kernels, merged BLOCK_SIZE autotune, bwd dot dtype
# pin). Both are unmerged upstream, so the commit is pinned to 0.5.2 (ca3e0f63) plus the
# patch; drop the patch and re-pin once they land.
#
# setup.py only declares find_packages(), so fla/configs/*.json is not part of the wheel;
# copy it in explicitly, otherwise FLA_CACHE_MODE=default cannot load the pinned autotune
# configs and every run re-tunes.
COPY dockers/patches/qwen35-fla-gdn-pr18-19.patch /tmp/qwen35-fla-gdn-pr18-19.patch
RUN python -m pip uninstall -y flash-linear-attention \
    && SITE=$(python -c 'import site; print(site.getsitepackages()[0])') \
    && rm -rf "$SITE"/fla \
    && git clone https://github.com/t-head/flash-linear-attention-for-sail.git /tmp/fla-src \
    && git -C /tmp/fla-src checkout ca3e0f633acb33303556eb48c9b88598e67bdeea \
    && git -C /tmp/fla-src apply /tmp/qwen35-fla-gdn-pr18-19.patch \
    && python -m pip install --no-build-isolation /tmp/fla-src \
    && cp -a /tmp/fla-src/fla/configs "$SITE"/fla/ \
    && rm -rf /tmp/fla-src /tmp/qwen35-fla-gdn-pr18-19.patch \
    && python -c "import fla, os; p = os.path.dirname(fla.__file__); assert os.path.isdir(os.path.join(p, 'configs', 'ZW_M890P')), 'fla autotune configs missing'; print('fla', fla.__version__, 'ok at', p)"

# causal-conv1d C++ backend, built from source. The stock setup.py emits a multi-arch
# -gencode list that the PPU nvcc rejects; the patch keeps only sm_89 (ZW-M890P).
# --no-build-isolation is required because setup.py imports torch at build time and the
# base image already ships the PPU torch build.
# CAUSAL_CONV1D_FORCE_BUILD skips setup.py's prebuilt-wheel lookup: it urlretrieves a
# GitHub Releases asset for the local torch/cu tag without a timeout, and a missing (or
# slow) asset hangs the build. Forcing the source build also guarantees our sm_89 patch
# is compiled rather than a downloaded upstream binary being installed instead.
COPY dockers/patches/causal-conv1d-sm89.patch /tmp/causal-conv1d-sm89.patch
RUN export CAUSAL_CONV1D_FORCE_BUILD=TRUE \
    && git clone https://github.com/Dao-AILab/causal-conv1d.git /tmp/causal-conv1d \
    && git -C /tmp/causal-conv1d checkout cd81f0413cad2fc1e6f17e785ac39f59aae690cd \
    && git -C /tmp/causal-conv1d apply /tmp/causal-conv1d-sm89.patch \
    && python -m pip install --no-build-isolation /tmp/causal-conv1d \
    && rm -rf /tmp/causal-conv1d /tmp/causal-conv1d-sm89.patch \
    && python -c "import causal_conv1d, causal_conv1d_cuda; print('causal_conv1d ok')"

# TransformerEngine 2.18 from the for-sail fork, built from source. Replaces the base
# image's 2.16+v0.1.0.ppu2.2.0 build and the published 2.18.0+efa9bf4 wheel: that wheel
# is linked against a torch that exports c10::cuda::CUDAStream::query(), which the PPU
# torch 2.10 in this image does not, so `import transformer_engine.pytorch` fails with
# an undefined symbol. Building here links against the image's own torch instead.
# NVTE_WITH_NCCL_EP=0 follows the for-sail build note (PCCL wrapper, not NCCL EP);
# NVTE_CUDA_ARCHS=89 matches the M890P and keeps the build single-arch. MAX_JOBS is
# capped so the PPU-adapted nvcc does not oversubscribe a shared node.
#
# The build's runtime deps are installed explicitly and the final install uses
# --no-deps: TE's own requirements include "onnx", whose resolver happily drags in
# numpy 2, and this image is pinned to numpy 1.26 (numpy 2 breaks scipy here).
ARG TE_REF="2.18+v0.1.0"
RUN python -m pip uninstall -y transformer_engine \
    && python -m pip install \
        "numpy==1.26.4" \
        packaging==24.2 \
        pybind11==3.1.0 \
        pydantic \
        einops \
        onnx \
        onnxscript \
        nvdlfw-inspect \
        "nvidia-cudnn-frontend>=1.25.0" \
    && git clone --depth 1 --branch "$TE_REF" \
        https://github.com/flytiger-eco/TransformerEngine-for-sail.git /tmp/TransformerEngine \
    && git -C /tmp/TransformerEngine submodule update --init --recursive --depth 1 \
    && bash -c 'set -eo pipefail; source /usr/local/pccl/envsetup.sh; export CPATH="${NCCL_HOME}/include${CPATH:+:$CPATH}"; cd /tmp/TransformerEngine; export NVTE_FRAMEWORK=pytorch NVTE_WITH_NCCL_EP=0 NVTE_CUDA_ARCHS=89 MAX_JOBS=32; python -m pip install -v --no-build-isolation --no-deps .' \
    && rm -rf /tmp/TransformerEngine \
    && python -c "import numpy; assert numpy.__version__.startswith('1.26.'), numpy.__version__; import torch, transformer_engine, transformer_engine.pytorch, importlib.metadata as m; print('te', m.version('transformer-engine'), transformer_engine.__version__, 'numpy', numpy.__version__)"

# Temporary FA3 routing fix (TransformerEngine-for-sail PR #12): the PPU flash-attn-3
# distribution reports version 2.8.2 (upstream is 3.0.0b1), so TE's `major == 3` test
# sends it down the FA2 API path. The patch also treats flash-attn >= 2.8.2 as FA3.
# Applied with git apply outside a repo (site-packages is not one); drop it once the
# for-sail fork carries the fix.
COPY dockers/patches/qwen35-te-fa3-select-282.patch /tmp/qwen35-te-fa3-select-282.patch
RUN SITE=$(python -c 'import site; print(site.getsitepackages()[0])') \
    && git -C "$SITE" apply /tmp/qwen35-te-fa3-select-282.patch \
    && rm /tmp/qwen35-te-fa3-select-282.patch \
    && python -c "import inspect, transformer_engine.pytorch.attention.dot_product_attention.backends as b; src = inspect.getsource(b); assert 'PkgVersion(\"2.8.2\")' in src; print('te fa3-select (2.8.2) patch ok')"

CMD ["/bin/bash"]
